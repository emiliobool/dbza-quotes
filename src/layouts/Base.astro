---
const {
  title = "DBZA Quotes",
  description = "Search Dragon Ball Z Abridged dialog, link any moment, share clips.",
  ogImage = null,
  ogType = "website",
  wide = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname;
const isOn = (p) => (p === "/" ? path === "/" : path.startsWith(p));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0d12" />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="DBZA Quotes" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta name="twitter:card" content="summary_large_image" />}
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🐉</text></svg>" />
  </head>
  <body>
    <header class="site-header">
      <nav class:list={{ wide }}>
        <a href="/" class="brand" aria-label="DBZA Quotes — home">
          <span class="brand-mark">DBZA</span><span class="brand-word">Quotes</span>
        </a>
        <button class="nav-search" id="cmdk-open" title="Search every line (⌘K or /)" aria-label="Search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.8-3.8"/></svg>
          <span class="nav-search-hint">Search…</span>
          <kbd>⌘K</kbd>
        </button>
        <span class="nav-spacer"></span>
        <a href="/quotes/" class:list={{ on: isOn("/quotes") }}>Quotes</a>
        <a href="/dbza/" class:list={{ on: isOn("/dbza") }}>Episodes</a>
        <a href="/saved/" class:list={{ on: isOn("/saved") }}>Saved</a>
        <a href="/about/" class:list={{ on: isOn("/about") }}>About</a>
      </nav>
    </header>
    <main class:list={{ wide }}><slot /></main>
    <footer class:list={["site-footer", { wide }]}>
      <div class="footer-top">
        <span class="footer-mark">DBZA<span>Quotes</span></span>
        <span class="footer-tag">Every line. Every dumb joke. One link away.</span>
      </div>
      <p>
        Unofficial fan reference for <a href="https://teamfourstar.com">TeamFourStar</a>'s Dragon
        Ball Z Abridged. All video plays on YouTube. <a href="/about/">About / takedown</a>
      </p>
      <p class="footer-kicker">No Dragon Balls were gathered in the making of this website.</p>
    </footer>

    <div class="cmdk" id="cmdk" hidden>
      <div class="cmdk-panel">
        <div class="cmdk-inputwrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.8-3.8"/></svg>
          <input id="cmdk-input" type="search" placeholder="Search every line of DBZA…" autocomplete="off" spellcheck="false" />
          <kbd>esc</kbd>
        </div>
        <div class="cmdk-results" id="cmdk-results"></div>
      </div>
    </div>
    <script>
      import { initCmdk } from "../lib/cmdk.js";
      initCmdk();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0b0d12;
    --bg2: #141821;
    --bg3: #1d2331;
    --fg: #edeff4;
    --fg-dim: #949dae;
    --accent: #ffa722;
    --accent-hot: #ff7a18;
    --accent-soft: rgba(255, 167, 34, 0.14);
    --accent2: #4da3ff;
    --accent2-soft: rgba(77, 163, 255, 0.14);
    --border: #262d3b;
    --border-lit: #3a465c;
    --ink: #12141a;
    --radius: 14px;
    --radius-sm: 10px;
    --font-display: -apple-system, BlinkMacSystemFont, "Segoe UI Black", "Arial Black",
      "Helvetica Neue", system-ui, sans-serif;
    --font-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
    --shadow: 0 18px 40px -22px rgba(0, 0, 0, 0.95);
    color-scheme: dark;
  }
  * { box-sizing: border-box; }

  body {
    margin: 0;
    min-height: 100vh;
    background:
      radial-gradient(1100px 620px at 12% -12%, rgba(255, 122, 24, 0.16), transparent 62%),
      radial-gradient(950px 520px at 90% -8%, rgba(77, 163, 255, 0.13), transparent 62%),
      var(--bg);
    background-attachment: fixed;
    color: var(--fg);
    font: 16px/1.6 system-ui, -apple-system, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  /* halftone dot texture */
  body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 4px 4px;
  }
  .site-header, main, .site-footer { position: relative; z-index: 1; }

  a { color: var(--accent2); text-decoration: none; }
  a:hover { color: #85c1ff; text-decoration: underline; text-underline-offset: 3px; }
  :focus-visible { outline: 2px solid var(--accent2); outline-offset: 2px; border-radius: 4px; }
  [hidden] { display: none !important; }

  main { max-width: 880px; margin: 0 auto; padding: 2rem 1rem 5rem; }
  main.wide { max-width: 1180px; }

  h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.75rem, 1.1rem + 2.4vw, 2.6rem);
    line-height: 1.04;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    margin: 0.2rem 0 1rem;
    text-wrap: balance;
  }
  h1 .hl {
    background: linear-gradient(180deg, #ffcf5c, var(--accent-hot));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 0.95rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg);
    margin: 2.2rem 0 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  h2::before {
    content: "";
    width: 0.55rem;
    height: 1.05rem;
    flex: none;
    border-radius: 2px;
    transform: skewX(-12deg);
    background: linear-gradient(180deg, var(--accent), var(--accent-hot));
    box-shadow: 0 0 14px -2px var(--accent-hot);
  }
  h2::after {
    content: "";
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--border), transparent);
  }
  p { text-wrap: pretty; }

  /* ---------- header ---------- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(11, 13, 18, 0.82);
    backdrop-filter: blur(14px) saturate(1.3);
    border-bottom: 1px solid var(--border);
  }
  .site-header::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: linear-gradient(90deg, var(--accent-hot), var(--accent) 28%, transparent 55%, var(--accent2));
    opacity: 0.75;
  }
  .site-header nav {
    max-width: 880px;
    margin: 0 auto;
    padding: 0.65rem 1rem;
    display: flex;
    gap: 0.15rem;
    align-items: center;
  }
  .nav-spacer { flex: 1; }
  .site-header nav > a:not(.brand) {
    color: var(--fg-dim);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.74rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    padding: 0.5rem 0.7rem;
    border-radius: 8px;
    position: relative;
  }
  .site-header nav > a:not(.brand):hover {
    color: var(--fg);
    background: rgba(255, 255, 255, 0.05);
    text-decoration: none;
  }
  .site-header nav > a.on { color: var(--accent); }
  .site-header nav > a.on::after {
    content: "";
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 0.18rem;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--accent), var(--accent-hot));
  }
  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.42rem;
    font-family: var(--font-display);
    margin-right: 0.6rem;
  }
  .brand:hover { text-decoration: none; }
  .brand-mark {
    background: linear-gradient(135deg, #ffd166, var(--accent-hot));
    color: var(--ink);
    font-weight: 900;
    font-size: 1.02rem;
    letter-spacing: 0.01em;
    padding: 0.16em 0.42em 0.2em;
    border-radius: 7px;
    transform: skewX(-9deg);
    box-shadow: 0 6px 20px -8px rgba(255, 122, 24, 0.95);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .brand:hover .brand-mark {
    transform: skewX(-9deg) translateY(-1px);
    box-shadow: 0 9px 24px -8px rgba(255, 122, 24, 1);
  }
  .brand-word {
    color: var(--fg);
    font-weight: 800;
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  /* ---------- footer ---------- */
  .site-header nav.wide, .site-footer.wide { max-width: 1180px; }
  .site-footer {
    max-width: 880px;
    margin: 0 auto;
    padding: 1.6rem 1rem 3rem;
    color: var(--fg-dim);
    font-size: 0.85rem;
    border-top: 1px solid var(--border);
    position: relative;
  }
  .site-footer::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 1rem;
    width: 90px;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), transparent);
  }
  .site-footer p { margin: 0.4rem 0; max-width: 62ch; }
  .footer-top {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }
  .footer-mark {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    color: var(--accent);
    text-transform: uppercase;
  }
  .footer-mark span { color: var(--fg); letter-spacing: 0.2em; font-size: 0.78rem; margin-left: 0.35rem; }
  .footer-tag { font-style: italic; color: var(--fg-dim); }
  .footer-kicker { color: #5f6779; font-size: 0.78rem; font-style: italic; }

  /* ---------- surfaces ---------- */
  .card {
    background: linear-gradient(180deg, var(--bg2), #11151d);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.85rem 1.05rem;
    margin: 0.6rem 0;
  }
  .quote-line { margin: 0.15rem 0; }
  .speaker {
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .dim { color: var(--fg-dim); }
  .meta { color: var(--fg-dim); font-size: 0.84rem; }
  .tstamp {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: #6f7a8d;
    font-size: 0.78rem;
    text-decoration: none;
  }
  a.tstamp:hover { color: var(--accent); text-decoration: none; }
  mark {
    background: linear-gradient(180deg, #ffd166, var(--accent));
    color: var(--ink);
    border-radius: 3px;
    padding: 0 0.16em;
    font-weight: 600;
  }

  /* ---------- buttons ---------- */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--bg3);
    color: var(--fg);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.9rem;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 0.14s ease, border-color 0.14s ease, box-shadow 0.14s ease,
      background 0.14s ease;
  }
  .btn:hover {
    border-color: var(--border-lit);
    background: #232a3a;
    color: var(--fg);
    transform: translateY(-1px);
    text-decoration: none;
  }
  .btn:active { transform: translateY(0); }
  .btn.primary {
    background: linear-gradient(135deg, #ffc247, var(--accent-hot));
    color: var(--ink);
    border-color: transparent;
    box-shadow: 0 8px 22px -12px rgba(255, 122, 24, 1);
  }
  .btn.primary:hover {
    background: linear-gradient(135deg, #ffcf68, #ff8b30);
    color: var(--ink);
    box-shadow: 0 12px 26px -12px rgba(255, 122, 24, 1);
  }
  .btn-row { display: flex; gap: 0.5rem; flex-wrap: wrap; margin: 0.9rem 0; }

  /* ---------- inputs ---------- */
  input[type="search"],
  input[type="text"],
  textarea {
    width: 100%;
    background: var(--bg2);
    color: var(--fg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.65rem 0.95rem;
    font-size: 1rem;
    font-family: inherit;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  input::placeholder, textarea::placeholder { color: #5f6879; }
  input:focus, textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  input[type="search"]::-webkit-search-cancel-button { filter: grayscale(1) opacity(0.5); }

  .search-wrap { position: relative; }
  .search-wrap::before {
    content: "";
    position: absolute;
    left: 1.15rem;
    top: 50%;
    width: 15px;
    height: 15px;
    margin-top: -9px;
    border: 2.5px solid #6f7a8d;
    border-radius: 50%;
    pointer-events: none;
    transition: border-color 0.15s ease;
  }
  .search-wrap::after {
    content: "";
    position: absolute;
    left: 2.05rem;
    top: 50%;
    margin-top: 3px;
    width: 8px;
    height: 2.5px;
    border-radius: 2px;
    background: #6f7a8d;
    transform: rotate(45deg);
    pointer-events: none;
    transition: background 0.15s ease;
  }
  .search-wrap:focus-within::before { border-color: var(--accent); }
  .search-wrap:focus-within::after { background: var(--accent); }
  .search-wrap input { padding-left: 3rem; }

  /* hero search on the home page */
  .hero { position: relative; padding: 1.2rem 0 0.4rem; }
  .hero::before {
    content: "";
    position: absolute;
    inset: -2rem -4rem auto;
    height: 220px;
    pointer-events: none;
    opacity: 0.5;
    background: repeating-linear-gradient(
      -22deg,
      transparent 0 22px,
      rgba(255, 167, 34, 0.055) 22px 24px,
      transparent 24px 46px
    );
    -webkit-mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.9), transparent 78%);
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.9), transparent 78%);
  }
  .hero > * { position: relative; }
  .hero h1 { font-size: clamp(2rem, 1.1rem + 3.4vw, 3.15rem); margin-bottom: 1.1rem; }
  .hero .search-wrap input {
    height: 3.55rem;
    font-size: 1.12rem;
    border-width: 2px;
    border-radius: 999px;
    padding-left: 3.35rem;
    background: linear-gradient(180deg, #171c26, #10141c);
    box-shadow: var(--shadow);
  }
  .hero .search-wrap::before { left: 1.4rem; }
  .hero .search-wrap::after { left: 2.3rem; }
  .hero .search-wrap:focus-within input { box-shadow: 0 0 0 4px var(--accent-soft), var(--shadow); }
  .hero .meta { margin: 0.7rem 0 0; font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.02em; }

  /* ---------- search results ---------- */
  .hit {
    display: block;
    color: inherit;
    position: relative;
    padding-left: 1.05rem;
    transition: transform 0.14s ease, border-color 0.14s ease, background 0.14s ease;
  }
  .hit::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.65rem;
    bottom: 0.65rem;
    width: 3px;
    border-radius: 0 3px 3px 0;
    background: var(--border);
    transition: background 0.14s ease;
  }
  a.hit:hover {
    color: inherit;
    text-decoration: none;
    border-color: var(--border-lit);
    transform: translateX(3px);
  }
  a.hit:hover .hit-title { color: var(--accent); }
  .hit-quote::before { background: linear-gradient(180deg, var(--accent), var(--accent-hot)); }
  a.hit-quote:hover { border-color: rgba(255, 167, 34, 0.5); }
  .hit:hover::before { background: var(--accent2); }
  .hit-quote:hover::before { background: linear-gradient(180deg, #ffd166, var(--accent-hot)); }
  .hit-head { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.15rem; }
  .hit-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 0.98rem;
    letter-spacing: 0.005em;
  }
  .hit .quote-line { font-size: 1.03rem; }
  .hit-meta {
    display: flex;
    gap: 0.55rem;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 0.3rem;
    font-size: 0.8rem;
    color: var(--fg-dim);
  }
  .hit-meta .sep { color: #3d4658; }
  .hit-src { font-weight: 600; color: #aab3c3; }

  .backlink {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--fg-dim);
  }
  .backlink:hover { color: var(--accent); text-decoration: none; }

  .empty {
    text-align: center;
    padding: 3rem 1rem;
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    background: rgba(20, 24, 33, 0.5);
  }
  .empty strong {
    display: block;
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: 1.15rem;
    margin-bottom: 0.35rem;
  }
  .empty span { color: var(--fg-dim); font-size: 0.9rem; }

  /* ---------- player ---------- */
  .player-wrap {
    position: relative;
    aspect-ratio: 16/9;
    background: #000;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--shadow), 0 0 0 1px rgba(255, 167, 34, 0.08);
  }
  .player-wrap iframe { width: 100%; height: 100%; border: 0; display: block; }
  .caption-bar {
    min-height: 3.4rem;
    /* block (not flex) so inline whitespace between speaker and text survives */
    display: block;
    align-content: center;
    margin-top: 0.55rem;
    padding: 0.75rem 1.1rem;
    background: linear-gradient(180deg, #171c26, #0f131a);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 1.06rem;
    line-height: 1.45;
    text-align: center;
    text-wrap: balance;
  }
  .caption-bar .speaker { text-transform: uppercase; font-size: 0.9em; letter-spacing: 0.05em; }

  /* custom player controls (range-scoped) */
  .clip-controls {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    background: linear-gradient(180deg, #171c26, #0f131a);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.55rem 0.85rem;
    margin-top: 0.55rem;
  }
  .clip-controls .play-btn {
    background: linear-gradient(135deg, #ffc247, var(--accent-hot));
    color: var(--ink);
    border: 0;
    border-radius: 50%;
    width: 2.5rem;
    height: 2.5rem;
    font-size: 0.9rem;
    line-height: 1;
    cursor: pointer;
    flex: none;
    display: grid;
    place-items: center;
    box-shadow: 0 6px 18px -8px rgba(255, 122, 24, 1);
    transition: transform 0.14s ease, box-shadow 0.14s ease;
  }
  .clip-controls .play-btn:hover { transform: scale(1.06); box-shadow: 0 8px 22px -8px rgba(255, 122, 24, 1); }
  .clip-controls .play-btn:active { transform: scale(0.97); }
  .clip-controls .scrub {
    -webkit-appearance: none;
    appearance: none;
    flex: 1;
    min-width: 0;
    height: 20px;
    margin: 0;
    background: transparent;
    cursor: pointer;
  }
  .clip-controls .scrub::-webkit-slider-runnable-track {
    height: 8px;
    border-radius: 99px;
    background:
      linear-gradient(90deg, var(--accent-hot), var(--accent)) 0 0 / var(--pct, 0%) 100% no-repeat,
      #272f40;
    border: 1px solid var(--border);
  }
  .clip-controls .scrub::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 16px;
    height: 16px;
    margin-top: -5px;
    border-radius: 50%;
    background: #fff;
    border: 2px solid var(--accent);
    box-shadow: 0 0 0 4px rgba(255, 167, 34, 0.16);
    transition: box-shadow 0.14s ease;
  }
  .clip-controls .scrub:hover::-webkit-slider-thumb { box-shadow: 0 0 0 6px rgba(255, 167, 34, 0.22); }
  .clip-controls .scrub::-moz-range-track {
    height: 8px;
    border-radius: 99px;
    background: #272f40;
    border: 1px solid var(--border);
  }
  .clip-controls .scrub::-moz-range-progress {
    height: 8px;
    border-radius: 99px;
    background: linear-gradient(90deg, var(--accent-hot), var(--accent));
  }
  .clip-controls .scrub::-moz-range-thumb {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #fff;
    border: 2px solid var(--accent);
  }
  .clip-controls .time-label {
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    flex: none;
    letter-spacing: -0.01em;
  }

  /* ---------- transcript ---------- */
  .transcript .line {
    padding: 0.28rem 0.55rem;
    border-radius: 7px;
    display: flex;
    gap: 0.65rem;
    position: relative;
    scroll-margin: 6rem;
  }
  .transcript .line:hover { background: rgba(255, 255, 255, 0.045); }
  .transcript .line .tstamp { padding-top: 0.16rem; flex: none; }
  /* playhead (time-based, cool tint) vs selection (orange) — kept visually
     distinct so simultaneous captions never read as a selected range */
  .transcript .line.active {
    background: rgba(140, 180, 220, 0.1);
    box-shadow: inset 3px 0 0 #86b3d9;
  }
  .transcript .line.in-quote {
    background: rgba(255, 167, 34, 0.13);
    box-shadow: inset 3px 0 0 var(--accent);
  }
  .transcript .line .text {
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .transcript .line.direction .text,
  .transcript .line.sfx .text { color: #7d8698; font-style: italic; }

  /* ---------- clip cards ---------- */
  .clip-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(232px, 1fr));
    gap: 0.9rem;
  }
  .clip-card {
    display: block;
    position: relative;
    color: inherit;
    background: linear-gradient(180deg, var(--bg2), #10141c);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .clip-card:hover {
    border-color: rgba(255, 167, 34, 0.55);
    text-decoration: none;
    transform: translateY(-3px);
    box-shadow: 0 16px 34px -20px rgba(0, 0, 0, 1), 0 0 0 1px rgba(255, 167, 34, 0.16),
      0 0 26px -14px rgba(255, 122, 24, 0.9);
  }
  .clip-card img {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    /* 4:3-era frames get cropped to 16:9 — keep the bottom so the burned-in
       caption survives the crop */
    object-position: center bottom;
    display: block;
    /* shows through until the thumbnail paints (and if it never does) */
    background:
      repeating-linear-gradient(
        -45deg,
        rgba(255, 255, 255, 0.028) 0 8px,
        transparent 8px 16px
      ),
      #0d1117;
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1), filter 0.25s ease;
  }
  .clip-card:hover img { transform: scale(1.045); filter: saturate(1.08); }
  .clip-card[href*="/clip/"]:has(img)::after,
  .clip-card[href*="/c/"]:has(img)::after {
    content: "▶";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    aspect-ratio: 16/9;
    display: grid;
    place-items: center;
    font-size: 1.1rem;
    color: var(--ink);
    text-shadow: none;
    opacity: 0;
    transition: opacity 0.2s ease;
    background:
      radial-gradient(circle at 50% 50%, rgba(255, 167, 34, 0.95) 0 22px, transparent 23px),
      linear-gradient(180deg, rgba(0, 0, 0, 0.28), rgba(0, 0, 0, 0.12));
    pointer-events: none;
  }
  .clip-card[href*="/clip/"]:has(img):hover::after,
  .clip-card[href*="/c/"]:has(img):hover::after { opacity: 1; }
  .clip-card .pad { padding: 0.65rem 0.8rem 0.75rem; position: relative; }
  .clip-card .title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.94rem;
    line-height: 1.25;
    letter-spacing: -0.005em;
    margin-bottom: 0.2rem;
  }
  .clip-card:hover .title { color: var(--accent); }
  .clip-card .meta { font-size: 0.76rem; line-height: 1.4; }

  .badge {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.63rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.18rem 0.5rem;
    border-radius: 99px;
    border: 1px solid var(--border);
    color: var(--fg-dim);
    vertical-align: middle;
    flex: none;
  }
  .badge-hot {
    border-color: rgba(255, 167, 34, 0.45);
    background: var(--accent-soft);
    color: var(--accent);
  }

  /* ---------- clip pages: player + dialog sidebar ---------- */
  .clip-layout { display: grid; gap: 1.2rem; align-items: start; }
  @media (min-width: 950px) {
    .clip-layout { grid-template-columns: minmax(0, 1fr) 420px; }
    .dialog-panel {
      position: sticky;
      top: 4.6rem;
      max-height: calc(100vh - 6rem);
      overflow-y: auto;
    }
  }
  .dialog-panel { padding: 0.45rem; margin: 0; }
  .dialog-panel .line { cursor: pointer; }
  .dialog-panel::-webkit-scrollbar { width: 10px; }
  .dialog-panel::-webkit-scrollbar-track { background: transparent; }
  .dialog-panel::-webkit-scrollbar-thumb {
    background: var(--bg3);
    border-radius: 99px;
    border: 3px solid transparent;
    background-clip: content-box;
  }
  .dialog-panel::-webkit-scrollbar-thumb:hover { background: var(--border-lit); background-clip: content-box; }

  /* quote page action bar: link/video icons left, Save pushed right */
  .action-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.6rem;
  }
  .action-bar .tstamp { margin-left: auto; }
  .title-actions { display: flex; gap: 0.4rem; flex: none; }
  .tbtn {
    width: 2.2rem;
    height: 2.2rem;
    display: grid;
    place-items: center;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg3);
    color: var(--fg-dim);
    cursor: pointer;
  }
  .tbtn svg { width: 17px; height: 17px; }
  #img-gif {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
  }
  .tbtn:hover { color: var(--fg); border-color: var(--border-lit); text-decoration: none; }
  .tbtn.primary {
    background: linear-gradient(135deg, #ffc247, var(--accent-hot));
    color: var(--ink);
    border-color: transparent;
  }
  .clip-credits {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
    margin: 0.55rem 0 0;
    font-size: 0.85rem;
    color: var(--fg-dim);
  }
  .clip-credits .speaker { text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.8rem; }
  .clip-credits .sep { color: #3d4658; }

  /* quote image variants */
  .variant-strip { display: flex; gap: 0.6rem; flex-wrap: wrap; margin: 1rem 0 0; align-items: center; }
  .variant-strip a { display: block; line-height: 0; }
  .variant-strip img {
    height: 84px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    display: block;
    transition: transform 0.16s ease, border-color 0.16s ease;
  }
  .variant-strip a:hover img { border-color: var(--accent); transform: translateY(-2px); }
  .strip-label {
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: #6f7a8d;
  }

  details.card > summary {
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  details.card > summary::-webkit-details-marker { display: none; }
  details.card > summary::before {
    content: "▸";
    color: var(--accent);
    transition: transform 0.15s ease;
    display: inline-block;
  }
  details.card[open] > summary::before { transform: rotate(90deg); }
  details.card > summary .meta { font-family: var(--font-mono); letter-spacing: 0; text-transform: none; }
  details.card .btn-row .meta {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    align-self: center;
  }

  /* ---------- toast ---------- */
  .toast {
    position: fixed;
    bottom: 1.4rem;
    left: 50%;
    background: linear-gradient(135deg, #ffc247, var(--accent-hot));
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.6rem 1.15rem;
    border-radius: 99px;
    opacity: 0;
    transform: translate(-50%, 12px);
    transition: opacity 0.22s ease, transform 0.22s cubic-bezier(0.2, 1.4, 0.4, 1);
    pointer-events: none;
    z-index: 50;
    box-shadow: 0 14px 34px -14px rgba(255, 122, 24, 0.9);
  }
  .toast.show { opacity: 1; transform: translate(-50%, 0); }

  /* ---------- responsive ---------- */
  @media (max-width: 640px) {
    main { padding: 1.25rem 0.9rem 4rem; }
    .site-header nav {
      gap: 0;
      padding: 0.55rem 0.6rem;
      overflow-x: auto;
      scrollbar-width: none;
      flex-wrap: nowrap;
    }
    .site-header nav::-webkit-scrollbar { display: none; }
    .nav-spacer { display: none; }
    .brand { margin-right: 0.35rem; }
    .brand-word { display: none; }
    .site-header nav > a:not(.brand) { padding: 0.45rem 0.5rem; font-size: 0.7rem; }
    .clip-grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 0.7rem; }
    .clip-card .title { font-size: 0.85rem; }
    .clip-card .meta { font-size: 0.72rem; }
    .hero .search-wrap input { height: 3.1rem; font-size: 1rem; }
    .caption-bar { font-size: 0.98rem; }
    .clip-controls { gap: 0.6rem; padding: 0.5rem 0.6rem; }
    .btn { padding: 0.45rem 0.7rem; font-size: 0.7rem; }
    .variant-strip img { height: 66px; }
  }
  @media (prefers-reduced-motion: reduce) {
    * { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; }
  }
  /* ---------- quote navigator additions ---------- */
  /* controls overlaid on the video, revealed on hover (always shown on touch) */
  .player-wrap.has-overlay { overflow: hidden; }
  .player-wrap .clip-controls.overlay {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    margin: 0;
    border: 0;
    border-radius: 0;
    background: linear-gradient(180deg, transparent, rgba(5, 7, 10, 0.88) 45%);
    padding: 1.1rem 0.85rem 0.55rem;
    opacity: 0;
    transition: opacity 0.18s ease;
    z-index: 2;
  }
  .player-wrap:hover .clip-controls.overlay,
  .player-wrap:focus-within .clip-controls.overlay { opacity: 1; }
  @media (hover: none) { .player-wrap .clip-controls.overlay { opacity: 1; } }

  .media-tabs { display: flex; gap: 0.4rem; margin-bottom: 0.6rem; }
  .mtab {
    display: inline-block;
    background: var(--bg3);
    color: var(--fg-dim);
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 0.42rem 0.95rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .mtab.on {
    background: linear-gradient(135deg, #ffc247, var(--accent-hot));
    color: var(--ink);
    border-color: transparent;
  }

  /* per-line frame thumbnails in the transcript panel */
  .transcript .line .lthumb-wrap {
    position: relative;
    width: 72px;
    aspect-ratio: 16/9;
    flex: none;
    border-radius: 5px;
    overflow: hidden;
    background: #0d1117;
    border: 1px solid var(--border);
  }
  .transcript .line .lthumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .transcript .line .lthumb-wrap .tstamp {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 0 0.28rem;
    font-size: 0.58rem;
    line-height: 1.6;
    background: rgba(0, 0, 0, 0.72);
    color: #dfe5f0;
    border-radius: 0 4px 0 0;
  }
  .transcript .line .lthumb.dead { display: none; }
  /* quote-page sidebar: speaker overlaid on the thumbnail, wider thumb */
  .dialog-panel .line .lthumb-wrap { width: 88px; }
  .dialog-panel .line .lthumb-wrap .lspeaker {
    position: absolute;
    top: 0;
    left: 0;
    max-width: 100%;
    padding: 0 0.28rem;
    font-size: 0.55rem;
    line-height: 1.7;
    font-weight: 700;
    background: rgba(0, 0, 0, 0.72);
    color: var(--accent);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    border-radius: 0 0 4px 0;
  }
  .dialog-panel .line { cursor: pointer; }
  @media (max-width: 949px) {
    /* own scroll area on mobile so playback highlighting never drags the page */
    .dialog-panel { max-height: 46vh; overflow-y: auto; }
  }

  /* image maker */
  .imgmaker { display: grid; gap: 0.6rem; }
  .imgmaker canvas {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: #000;
    display: block;
  }
  .canvas-wrap { position: relative; min-width: 0; }
  .canvas-actions {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    display: flex;
    gap: 0.4rem;
    opacity: 0.85;
  }
  .canvas-wrap:hover .canvas-actions { opacity: 1; }
  .canvas-actions button {
    width: 2.4rem;
    height: 2.4rem;
    display: grid;
    place-items: center;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(5, 7, 11, 0.72);
    backdrop-filter: blur(3px);
    color: #fff;
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
  }
  .canvas-actions button svg { width: 17px; height: 17px; }
  .canvas-actions button:hover { border-color: var(--accent); color: var(--accent); }
  .imgmaker-bar { display: grid; gap: 0.5rem; }
  /* the canvas is the control surface: per-panel hit-zones over the image —
     tap the picture to pop open its frame carousel, tap the painted words to
     pop open their editor. The text zone is inline-positioned by JS to hug
     exactly where the caption is drawn. */
  #panel-hits { position: absolute; inset: 1px; }
  .phit { position: absolute; }
  .phit-img { position: absolute; inset: 0; cursor: pointer; }
  .phit-txt { position: absolute; cursor: text; z-index: 2; }
  .phit-ico {
    position: absolute;
    top: 6px;
    left: 6px;
    width: 1.8rem;
    height: 1.8rem;
    display: grid;
    place-items: center;
    border-radius: 8px;
    background: rgba(5, 7, 11, 0.62);
    color: #fff;
    opacity: 0;
    transition: opacity 0.12s;
    pointer-events: none;
  }
  .phit-txt .phit-ico {
    top: auto;
    left: auto;
    bottom: 2px;
    right: -0.5rem;
    width: 1.4rem;
    height: 1.4rem;
  }
  .phit-ico svg { width: 15px; height: 15px; }
  .phit-txt .phit-ico svg { width: 11px; height: 11px; }
  .phit-img:hover .phit-ico,
  .phit-txt:hover .phit-ico { opacity: 0.95; }
  .phit-img:hover::before,
  .phit.strip-open .phit-img::before {
    content: "";
    position: absolute;
    inset: 3px;
    border: 2px dashed rgba(255, 255, 255, 0.45);
    border-radius: 8px;
    pointer-events: none;
  }
  .phit-txt:hover::before {
    content: "";
    position: absolute;
    inset: -2px;
    border: 1.5px dashed rgba(255, 255, 255, 0.55);
    border-radius: 6px;
    pointer-events: none;
  }
  .phit.strip-open .phit-img::before { border-style: solid; border-color: var(--accent); }
  @media (hover: none) { .phit-ico { opacity: 0.55; } }
  /* floating popups (frame carousel, caption editor) anchored under a panel */
  .canvas-pop {
    position: absolute;
    left: 0.4rem;
    right: 0.4rem;
    z-index: 5;
    background: var(--bg2);
    border: 1px solid var(--border-lit);
    border-radius: var(--radius);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.55);
    padding: 0.45rem 0.55rem;
  }
  .edit-pop textarea {
    width: 100%;
    resize: vertical;
    font-size: 0.95rem;
  }
  /* frame picker: a grid of frames covering exactly the picked panel — the
     panel becomes its own control */
  #fstrips {
    position: absolute;
    z-index: 6;
    overflow: hidden;
    background: rgba(5, 7, 11, 0.95);
    border: 1.5px solid var(--accent);
    border-radius: 10px;
  }
  #fstrips[hidden] { display: none; }
  .fgrid-scroll {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.35rem;
    scrollbar-width: thin;
    scrollbar-color: var(--border-lit) transparent;
  }
  .fgrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(128px, 1fr));
    gap: 5px;
  }
  .fgrid img {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    border-radius: 4px;
    cursor: pointer;
    opacity: 0.6;
    border: 2px solid var(--border-lit);
    background: #0d1117;
  }
  .fgrid img:hover { opacity: 0.95; }
  .fgrid img.on { opacity: 1; border-color: var(--accent); }
  /* per-line select/deselect toggle in the transcript */
  .dialog-panel .line .lsel {
    flex: none;
    align-self: center;
    width: 1.45rem;
    height: 1.45rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--border-lit);
    background: var(--bg3);
    color: var(--fg-dim);
    cursor: pointer;
    padding: 0;
    opacity: 0;
    transition: opacity 0.12s;
  }
  .dialog-panel .line:hover .lsel { opacity: 1; }
  .dialog-panel .line.in-quote .lsel {
    opacity: 1;
    border-color: var(--accent);
    color: var(--accent);
  }
  .dialog-panel .line .lsel:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--ink);
  }
  .lsel svg { width: 12px; height: 12px; }
  .lsel .ic-rem { display: none; }
  .line.in-quote .lsel .ic-add { display: none; }
  .line.in-quote .lsel .ic-rem { display: block; }
  @media (hover: none) {
    .dialog-panel .line .lsel { opacity: 0.75; }
  }
  .fs-close {
    position: absolute;
    top: 0.35rem;
    right: 0.35rem;
    z-index: 2;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    border: 1px solid var(--border-lit);
    background: var(--bg3);
    color: var(--fg);
    font-size: 1.05rem;
    line-height: 1;
    cursor: pointer;
    padding: 0;
  }
  .fs-close:hover { color: var(--accent); border-color: var(--accent); }

  /* header command-bar search */
  .nav-search {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-left: 0.9rem;
    padding: 0.34rem 0.7rem;
    background: rgba(255, 255, 255, 0.05);
    color: var(--fg-dim);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.8rem;
    cursor: pointer;
    min-width: 9rem;
  }
  .nav-search:hover { border-color: var(--border-lit); color: var(--fg); }
  .nav-search svg { width: 14px; height: 14px; flex: none; }
  .nav-search kbd {
    margin-left: auto;
    font-size: 0.62rem;
    padding: 0.05rem 0.32rem;
    border: 1px solid var(--border);
    border-radius: 5px;
    background: var(--bg2);
    color: var(--fg-dim);
  }
  @media (max-width: 640px) {
    .nav-search { min-width: 0; }
    .nav-search-hint, .nav-search kbd { display: none; }
  }
  .cmdk {
    position: fixed;
    inset: 0;
    z-index: 50;
    background: rgba(5, 7, 11, 0.72);
    backdrop-filter: blur(4px);
    padding: min(10vh, 5rem) 1rem 1rem;
  }
  .cmdk-panel {
    max-width: 44rem;
    margin: 0 auto;
    background: var(--bg2);
    border: 1px solid var(--border-lit);
    border-radius: var(--radius);
    box-shadow: 0 30px 70px -20px rgba(0, 0, 0, 0.9);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-height: min(70vh, 34rem);
  }
  .cmdk-inputwrap {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border);
  }
  .cmdk-inputwrap svg { width: 17px; height: 17px; color: var(--accent); flex: none; }
  .cmdk-inputwrap input {
    flex: 1;
    background: none;
    border: 0;
    outline: none;
    color: var(--fg);
    font-size: 1.05rem;
  }
  .cmdk-inputwrap kbd {
    font-size: 0.62rem;
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--border);
    border-radius: 5px;
    color: var(--fg-dim);
  }
  .cmdk-results { overflow-y: auto; padding: 0.4rem; }
  .cmdk-note { color: var(--fg-dim); font-size: 0.9rem; margin: 0.6rem 0.7rem; }
  .cmdk-hit {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.42rem 0.55rem;
    border-radius: 9px;
    color: var(--fg);
  }
  .cmdk-hit:hover { text-decoration: none; }
  .cmdk-hit.on { background: var(--accent-soft); }
  .cmdk-hit img {
    width: 76px;
    aspect-ratio: 16/9;
    object-fit: cover;
    border-radius: 5px;
    flex: none;
    background: #0d1117;
  }
  .cmdk-hit .cmdk-text {
    flex: 1;
    font-size: 0.92rem;
    display: -webkit-box;
