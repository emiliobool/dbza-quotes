---
import Base from "../../../layouts/Base.astro";
import QuotePage from "../../../components/QuotePage.astro";
import site from "../../../gen/site.json";
import { ytThumb, mediaLabel } from "../../../lib/util.js";

export function getStaticPaths() {
  return site.shows.flatMap((s) =>
    site.media[s.id].map((m) => ({ params: { show: s.id, item: m.id } }))
  );
}
const { show, item } = Astro.params;
const m = site.media[show].find((x) => x.id === item);
const label = mediaLabel(m);
---

<Base
  title={`Quote — ${label} | DBZA Quotes`}
  description={`A moment from ${label}. Click any line to jump to that quote; share the link or make an image.`}
  ogImage={ytThumb(m.youtube)}
  ogType="video.other"
  wide
>
  <QuotePage show={show} item={item} clip={null} />
</Base>
