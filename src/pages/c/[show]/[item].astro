---
import Base from "../../../layouts/Base.astro";
import site from "../../../gen/site.json";
import { ytThumb, mediaLabel } from "../../../lib/util.js";

export function getStaticPaths() {
  return site.shows.flatMap((s) =>
    site.media[s.id].map((m) => ({ params: { show: s.id, item: m.id } }))
  );
}
const { show, item } = Astro.params;
const m = site.media[show].find((x) => x.id === item);
const label = mediaLabel(m);
---

<Base
  title={`Clip — ${label} | DBZA Quotes`}
  description={`A moment from ${label}. Watch with synced captions, adjust the range, share the link.`}
  ogImage={ytThumb(m.youtube)}
  ogType="video.other"
  wide
>
  <p class="meta" style="margin:0 0 0.9rem"><a class="backlink" href={`/${show}/${item}/`}>← {label}</a></p>

  <div class="clip-layout">
    <div>
      <div class="player-wrap"><div id="yt-player"></div></div>
      <div class="clip-controls" id="controls"></div>
      <div class="caption-bar" id="caption"></div>

      <div class="btn-row">
        <button class="btn primary" id="copy-link" title="Copy this page's link — it encodes the current range">Copy link</button>
        <button class="btn" id="copy-yt" title="Copy a YouTube link at this timestamp — plays inline on Discord">YouTube</button>
        <button class="btn" id="copy-quote" title="Copy the selected dialog as text">Quote</button>
        <button class="btn" id="save-clip" title="Save on this device">☆</button>
        <button class="btn" id="submit-clip" title="Suggest this clip for the public quotes page">Suggest</button>
      </div>

      <details class="card">
        <summary title="Fine-tune where the clip starts and ends">Adjust range <span class="meta" id="range-label"></span></summary>
        <div class="btn-row" style="margin-top:0.6rem">
          <span class="meta" style="width:3.2rem">Start</span>
          <button class="btn" data-adj="start-prev" title="Snap to previous line">⇤</button>
          <button class="btn" data-adj="start-minus" title="Start 0.5s earlier">−0.5</button>
          <button class="btn" data-adj="start-plus" title="Start 0.5s later">+0.5</button>
          <button class="btn" data-adj="start-next" title="Snap to next line">⇥</button>
        </div>
        <div class="btn-row">
          <span class="meta" style="width:3.2rem">End</span>
          <button class="btn" data-adj="end-prev" title="Snap to previous line">⇤</button>
          <button class="btn" data-adj="end-minus" title="End 0.5s earlier">−0.5</button>
          <button class="btn" data-adj="end-plus" title="End 0.5s later">+0.5</button>
          <button class="btn" data-adj="end-next" title="Snap to next line">⇥</button>
        </div>
      </details>
    </div>

    <div class="transcript card dialog-panel" id="dialog" title="Click a line to jump there"></div>
  </div>

  <div class="toast" id="toast"></div>
</Base>

<script>
  import { createClipPlayer, escapeHtml } from "../../../lib/player.js";
  import { fmtTime } from "../../../lib/util.js";

  const SHOW = location.pathname.split("/")[2];
  const ITEM = location.pathname.split("/")[3];
  const $ = (s) => document.querySelector(s);

  const data = await fetch(`/data/transcripts/${SHOW}/${ITEM}.json`).then((r) => r.json());
  const lines = data.lines; // [start, end, kind, speaker, text]

  const params = new URLSearchParams(location.search);
  let start = Math.max(0, parseFloat(params.get("t") ?? "0") || 0);
  let dur = parseFloat(params.get("d") ?? "15") || 15;
  let end = Math.min(data.duration ?? start + dur, start + dur);

  const dialogStarts = lines.filter((l) => l[2] === "dialog").map((l) => l[0]);
  const dialogEnds = lines.filter((l) => l[2] === "dialog").map((l) => l[1]);

  const player = await createClipPlayer({
    mountId: "yt-player",
    youtube: data.youtube,
    lines,
    captionEl: $("#caption"),
    controlsEl: $("#controls"),
    start,
    end,
    onTime: (t) => {
      document.querySelectorAll("#dialog .line").forEach((el) => {
        const l = lines[+el.dataset.i];
        const active = l[0] <= t && t <= l[1] + 0.3;
        if (active && !el.classList.contains("active")) el.scrollIntoView({ block: "nearest" });
        el.classList.toggle("active", active);
      });
    },
  });

  function inRange(l) { return l[1] > start && l[0] < end; }

  function renderDialog() {
    const first = lines.findIndex(inRange);
    const lo = Math.max(0, (first === -1 ? 0 : first) - 12);
    const hi = Math.min(lines.length, (first === -1 ? 0 : lines.findLastIndex(inRange)) + 13);
    $("#dialog").innerHTML = lines.slice(lo, hi).map((l, k) => {
      const i = lo + k;
      const cls = ["line", l[2], inRange(l) ? "in-range" : ""].join(" ");
      const body = l[2] === "dialog"
        ? `${l[3] ? `<span class="speaker">${escapeHtml(l[3])}: </span>` : ""}${escapeHtml(l[4])}`
        : `[${escapeHtml(l[4])}]`;
      return `<div class="${cls}" data-i="${i}" data-t="${l[0]}">
        <span class="tstamp">${fmtTime(l[0])}</span><div class="text">${body}</div></div>`;
    }).join("");
  }

  function sync() {
    end = Math.max(start + 0.5, end);
    player.setRange(start, end);
    $("#range-label").textContent = `${fmtTime(start)} → ${fmtTime(end)}`;
    const u = new URL(location);
    u.searchParams.set("t", String(Math.round(start * 10) / 10));
    u.searchParams.set("d", String(Math.round((end - start) * 10) / 10));
    history.replaceState(null, "", u);
    renderDialog();
  }
  sync();

  $("#dialog").addEventListener("click", (e) => {
    const el = e.target.closest(".line");
    if (el) player.seek(parseFloat(el.dataset.t));
  });

  const snap = (arr, t, dir) => {
    const c = dir < 0 ? arr.filter((x) => x < t - 0.05) : arr.filter((x) => x > t + 0.05);
    return c.length ? (dir < 0 ? c[c.length - 1] : c[0]) : t;
  };
  document.querySelectorAll("[data-adj]").forEach((b) =>
    b.addEventListener("click", () => {
      const [which, op] = b.dataset.adj.split("-");
      let v = which === "start" ? start : end;
      const cues = which === "start" ? dialogStarts : dialogEnds;
      if (op === "minus") v -= 0.5;
      else if (op === "plus") v += 0.5;
      else v = snap(cues, v, op === "prev" ? -1 : 1) + (which === "start" ? -0.3 : 0.4);
      if (which === "start") start = Math.max(0, Math.min(v, end - 0.5));
      else end = Math.max(start + 0.5, v);
      sync();
    })
  );

  const toast = (msg) => {
    const t = $("#toast");
    t.textContent = msg; t.classList.add("show");
    setTimeout(() => t.classList.remove("show"), 1800);
  };
  const copy = (text, msg) => navigator.clipboard.writeText(text).then(() => toast(msg));
  const quoteText = () =>
    lines.filter(inRange).filter((l) => l[2] === "dialog")
      .map((l) => (l[3] ? `${l[3]}: ${l[4]}` : l[4])).join("\n");

  $("#copy-link").addEventListener("click", () => copy(location.href, "Link copied"));
  $("#copy-yt").addEventListener("click", () =>
    copy(`https://youtu.be/${data.youtube}?t=${Math.floor(start)}`, "YouTube link copied"));
  $("#copy-quote").addEventListener("click", () => copy(quoteText(), "Quote copied"));

  $("#save-clip").addEventListener("click", () => {
    const saved = JSON.parse(localStorage.getItem("savedClips") || "[]");
    saved.unshift({ show: SHOW, item: ITEM, t: start, d: end - start, title: data.title,
      quote: quoteText().slice(0, 200), when: Date.now() });
    localStorage.setItem("savedClips", JSON.stringify(saved.slice(0, 200)));
    toast("Saved on this device");
  });

  $("#submit-clip").addEventListener("click", async () => {
    const note = prompt("Suggest this clip for the quotes page?\nOptional note:");
    if (note === null) return;
    try {
      const r = await fetch("/api/submit", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ kind: "clip_suggestion",
          payload: { show: SHOW, item: ITEM, t: start, d: end - start, note, quote: quoteText().slice(0, 500) } }),
      });
      toast(r.ok ? "Submitted — thanks!" : "Submissions are closed right now");
    } catch { toast("Submissions are unavailable right now"); }
  });
</script>
