---
import Base from "../layouts/Base.astro";
---

<Base title="Saved clips | DBZA Quotes" description="Clips you saved — each one gets a public permalink.">
  <h1>Saved <span class="hl">clips</span></h1>
  <p class="meta" style="margin-top:-0.4rem">
    Saving mints a public permalink you can share anywhere; this list of yours lives in this browser.
  </p>
  <div id="list"></div>
</Base>

<script>
  import { fmtTime } from "../lib/util.js";
  const saved = JSON.parse(localStorage.getItem("savedClips") || "[]");
  const esc = (s) => (s || "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
  document.getElementById("list").innerHTML = saved.length
    ? saved.map((c, i) => `
      <div class="card">
        <a href="${c.url ? esc(c.url) : `/c/${c.show}/${c.item}/?t=${c.t}&d=${c.d}`}"><strong>${esc(c.title)}</strong> · ${fmtTime(c.t)} (${Math.round(c.d)}s)</a>
        <div class="quote-line dim">${esc(c.quote)}</div>
        <div style="display:flex;gap:0.5rem;align-items:center;margin-top:0.4rem">
          ${c.url ? `<button class="btn" data-copy="${esc(c.url)}">Copy link</button>` : ""}
          <button class="btn" data-del="${i}">Remove</button>
          ${c.url ? `<span class="meta" style="margin:0">${esc(c.url.replace(/^https?:\/\//, ""))}</span>` : ""}
        </div>
      </div>`).join("")
    : `<div class="empty"><strong>Emptier than Yamcha's trophy case</strong>
      <span>Open any clip and hit “☆” to stash it here.</span></div>`;
  document.getElementById("list").addEventListener("click", (e) => {
    const cp = e.target.closest("[data-copy]");
    if (cp) {
      navigator.clipboard.writeText(cp.dataset.copy).then(() => { cp.textContent = "Copied!"; });
      return;
    }
    const b = e.target.closest("[data-del]");
    if (!b) return;
    saved.splice(+b.dataset.del, 1);
    localStorage.setItem("savedClips", JSON.stringify(saved));
    location.reload();
  });
</script>
