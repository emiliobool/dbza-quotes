---
import Base from "../layouts/Base.astro";
import site from "../gen/site.json";
const nClips = site.clips.filter((c) => c.status === "published").length;
---

<Base>
  <div class="hero">
    <h1>Every line of <span class="hl">DBZA</span>, one search away</h1>
    <div class="search-wrap">
      <input
        type="search"
        id="q"
        placeholder='Try "muffin button", "dodge", "vegeta: prince"…'
        autocomplete="off"
        readonly
        data-cmdk-open
      />
    </div>
  </div>

  <div id="home-extra">
    <h2>Greatest hits</h2>
    <div class="clip-grid" id="top-clips"></div>
    <p class="meta" style="margin-top:1rem"><a href="/quotes/">All {nClips} quotes →</a></p>
  </div>
  <div class="toast" id="toast"></div>
</Base>

<script>
  import { mediaLabel } from "../lib/util.js";

  const esc = (s) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));

  const [mediaMap, clips] = await Promise.all([
    fetch("/data/media.json").then((r) => r.json()),
    fetch("/data/clips.json").then((r) => r.json()),
  ]);
  const media = mediaMap.dbza;

  const top = [...clips].sort((a, b) => (b.signal || 0) - (a.signal || 0)).slice(0, 6);
  document.getElementById("top-clips").innerHTML = top.map((c) => `
    <a class="clip-card bare" href="/clip/dbza/${c.id}/" title="${esc(c.title)} — ${esc(c.speaker || "")} · ${esc(mediaLabel(media[c.media]))}">
      <img loading="lazy" src="${c.image ?? `https://i.ytimg.com/vi/${media[c.media]?.youtube}/mqdefault.jpg`}" alt="${esc(c.quote)}">
      <span class="ep-tag">${esc(mediaLabel(media[c.media]).replace("Episode", "Ep"))}</span>
    </a>`).join("");
</script>
