---
import Base from "../../layouts/Base.astro";
import site from "../../gen/site.json";
import { fmtTime, ytThumb, ytLink, mediaLabel } from "../../lib/util.js";
import { frameUrl, lineFrameT } from "../../lib/config.js";

export function getStaticPaths() {
  return site.shows.flatMap((s) =>
    site.media[s.id].map((m) => ({ params: { show: s.id, item: m.id } }))
  );
}
const { show, item } = Astro.params;
const m = site.media[show].find((x) => x.id === item);

const transcripts = import.meta.glob("../../../public/data/transcripts/**/*.json", { eager: true });
const t = transcripts[`../../../public/data/transcripts/${show}/${item}.json`];
const lines = t.lines.map((l, i) => ({ i, start: l[0], end: l[1], kind: l[2], speaker: l[3], text: l[4] }));
const overrides = t.overrides ?? {};
const dialogCount = lines.filter((l) => l.kind === "dialog").length;

// published quotes on this item — marked in the transcript
const itemClips = site.clips.filter(
  (c) => c.show === show && c.media === item && c.status === "published"
);
const quoteAt = (l) => itemClips.find(
  (c) => l.end > (c.quote_start ?? c.start) && l.start < (c.quote_end ?? c.end)
);
const lineUrl = (l) => {
  const r = (x) => Math.round(x * 10) / 10;
  return `/c/${show}/${item}/?t=${r(Math.max(0, l.start - 1))}&d=${r(l.end + 1.5 - Math.max(0, l.start - 1))}&qs=${r(l.start)}&qe=${r(l.end)}`;
};
---

<Base
  title={`${m.title} — transcript | DBZA Quotes`}
  description={`Full searchable transcript of ${mediaLabel(m)} (${dialogCount} lines). Every line is a shareable quote.`}
  ogImage={ytThumb(m.youtube)}
  wide
>
  <p class="meta"><a class="backlink" href={`/${show}/`}>← All episodes</a></p>
  <h1>{m.title}</h1>
  <p class="clip-credits">
    <span class="tstamp">{fmtTime(m.duration)}</span> <span class="sep">·</span>
    {dialogCount} lines <span class="sep">·</span>
    <a href={ytLink(m.youtube)}>YouTube</a>
    {itemClips.length > 0 && <span class="sep">·</span>}
    {itemClips.length > 0 && <span>{itemClips.length} saved quote{itemClips.length === 1 ? "" : "s"}</span>}
  </p>

  <div class="transcript card" title="Click a line to open it as a quote — play it, share it, make an image">
    {lines.map((l) => {
      const q = l.kind === "dialog" ? quoteAt(l) : null;
      return (
        <a class={`line ${l.kind} ${q ? "in-quote" : ""}`} id={`L${l.i}`} href={q ? `/clip/${show}/${q.id}/` : lineUrl(l)} title={l.kind === "dialog" ? (l.speaker ? `${l.speaker}: ${l.text}` : l.text) : `[${l.text}]`}>
          <span class="lthumb-wrap">
            <img class="lthumb" loading="lazy" decoding="async" crossorigin="anonymous" src={frameUrl(item, lineFrameT([l.start, l.end], l.i, overrides))} alt="" onerror="this.classList.add('dead')" />
            <span class="tstamp">{fmtTime(l.start)}</span>
          </span>
          <div class="text">
            {l.kind === "dialog" ? (
              <>
                {l.speaker && <span class="speaker">{l.speaker}: </span>}
                {l.text}
                {q && <span class="badge" title={`Saved quote: ${q.title}`}>★</span>}
              </>
            ) : (
              <>[{l.text}]</>
            )}
          </div>
        </a>
      );
    })}
  </div>
</Base>

<script>
  // highlight a deep-linked line (#L123)
  const hash = location.hash;
  if (/^#L\d+$/.test(hash)) {
    const el = document.getElementById(hash.slice(1));
    if (el) { el.classList.add("active"); el.scrollIntoView({ block: "center" }); }
  }
</script>

<style>
  .transcript .line { color: inherit; text-decoration: none; }
  .transcript .line:hover { text-decoration: none; }
  .transcript .line .badge { margin-left: 0.4rem; color: var(--accent); border-color: rgba(255,167,34,0.4); }
</style>
