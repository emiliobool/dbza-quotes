---
import Base from "../../layouts/Base.astro";
import site from "../../gen/site.json";
import { fmtTime, ytThumb } from "../../lib/util.js";

export function getStaticPaths() {
  return site.shows.map((s) => ({ params: { show: s.id } }));
}
const { show } = Astro.params;
const showMeta = site.shows.find((s) => s.id === show);
const media = site.media[show];
const episodes = media.filter((m) => m.kind === "episode");
const movies = media.filter((m) => m.kind !== "episode");
const clipCount = Object.fromEntries(
  media.map((m) => [m.id, site.clips.filter((c) => c.show === show && c.media === m.id && c.status === "published").length])
);
---

<Base title={`${showMeta.title} — episodes & transcripts`} wide>
  <h1>{showMeta.title}</h1>

  <h2>Episodes</h2>
  <div class="clip-grid">
    {episodes.map((m) => (
      <a class="clip-card" href={`/${show}/${m.id}/`}>
        <img loading="lazy" src={ytThumb(m.youtube, "mqdefault")} alt={m.title} />
        <div class="pad">
          <div class="title">{m.title}</div>
          <div class="meta">{fmtTime(m.duration)}{clipCount[m.id] ? ` · ${clipCount[m.id]} quotes` : ""}</div>
        </div>
      </a>
    ))}
  </div>

  <h2>Movies & specials</h2>
  <div class="clip-grid">
    {movies.map((m) => (
      <a class="clip-card" href={`/${show}/${m.id}/`}>
        <img loading="lazy" src={ytThumb(m.youtube, "mqdefault")} alt={m.title} />
        <div class="pad">
          <div class="title">{m.title}</div>
          <div class="meta">{fmtTime(m.duration)}{clipCount[m.id] ? ` · ${clipCount[m.id]} quotes` : ""}</div>
        </div>
      </a>
    ))}
  </div>
</Base>
