---
import Base from "../layouts/Base.astro";
import site from "../gen/site.json";
import { mediaLabel, ytThumb, fmtTime, clipUrl } from "../lib/util.js";

const clips = site.clips
  .filter((c) => c.status === "published")
  .sort((a, b) => (b.signal || 0) - (a.signal || 0));
const mediaById = Object.fromEntries(site.media.dbza.map((m) => [m.id, m]));
---

<Base title="Quotes | DBZA Quotes" description={`${clips.length} iconic DBZA moments with captioned frames.`} wide>
  <h1>The <span class="hl">Quote</span> Vault</h1>
  <p class="meta" style="margin:-0.4rem 0 1rem">{clips.length} certified moments, captioned and ready to paste.</p>
  <div class="search-wrap">
    <input type="search" id="filter" placeholder={`Filter ${clips.length} quotes…`} autocomplete="off" />
  </div>
  {site.collections.length > 0 && (
    <div class="btn-row" style="margin-top:0.9rem">
      {site.collections.map((g) => (
        <a class="collection-chip" href={`/collection/${g.show}/${g.id}/`} title={g.blurb}>{g.title}</a>
      ))}
    </div>
  )}
  <div class="clip-grid" id="grid" style="margin-top:1.2rem">
    {clips.map((c) => {
      const m = mediaById[c.media];
      return (
        <a class="clip-card bare" href={clipUrl(c)} title={`${c.title} — ${c.speaker ?? ""} · ${mediaLabel(m)} · ${fmtTime(c.start)}`}
          data-k={`${c.title} ${c.quote} ${c.speaker} ${mediaLabel(m)}`.toLowerCase()}>
          <img loading="lazy" src={c.image ?? ytThumb(m.youtube, "mqdefault")} alt={c.quote} />
          <span class="ep-tag">{mediaLabel(m).replace("Episode", "Ep")}</span>
        </a>
      );
    })}
  </div>
</Base>

<script>
  const input = document.getElementById("filter");
  const cards = [...document.querySelectorAll("#grid .clip-card")];
  input.addEventListener("input", () => {
    const q = input.value.toLowerCase().trim();
    for (const c of cards) c.style.display = !q || c.dataset.k.includes(q) ? "" : "none";
  });
</script>
