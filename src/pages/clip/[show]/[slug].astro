---
import Base from "../../../layouts/Base.astro";
import QuotePage from "../../../components/QuotePage.astro";
import site from "../../../gen/site.json";
import { ytThumb, mediaLabel } from "../../../lib/util.js";

export function getStaticPaths() {
  return site.clips
    .filter((c) => c.status === "published")
    .map((c) => ({ params: { show: c.show, slug: c.id }, props: { clip: c } }));
}
const { show } = Astro.params;
const { clip } = Astro.props;
const m = site.media[show].find((x) => x.id === clip.media);
const ogImage = clip.image ? new URL(clip.image, Astro.site).href : ytThumb(m.youtube);
---

<Base
  title={`"${clip.title}" — ${mediaLabel(m)} | DBZA Quotes`}
  description={clip.quote}
  ogImage={ogImage}
  ogType="video.other"
  wide
>
  <QuotePage show={show} item={clip.media} clip={clip} />
</Base>
