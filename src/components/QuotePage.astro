---
// The quote navigator: one page drives both /clip/{slug} (curated) and
// /c/{item} (ad-hoc). The full transcript is prerendered in the sidebar;
// clicking any line navigates to that quote (curated line → its clip page,
// anything else → a stateless /c/ URL) without a reload.
import site from "../gen/site.json";
import { fmtTime, mediaLabel } from "../lib/util.js";
import { frameUrl, lineFrameT } from "../lib/config.js";

const { show, item, clip = null } = Astro.props;
const m = site.media[show].find((x) => x.id === item);

// generated by tools/build-data.mjs (runs before astro build): compact lines + frame overrides
const transcripts = import.meta.glob("../../public/data/transcripts/**/*.json", { eager: true });
const t = transcripts[`../../public/data/transcripts/${show}/${item}.json`];
const lines = t.lines.map((l, i) => ({ i, start: l[0], end: l[1], kind: l[2], speaker: l[3], text: l[4] }));
const overrides = t.overrides ?? {};

// published clips on this item (for curated-line adoption + related grid)
const itemClips = site.clips.filter(
  (c) => c.show === show && c.media === item && c.status === "published"
);
const related = itemClips.filter((c) => c.id !== clip?.id).slice(0, 8);
const groups = Object.fromEntries(site.groups.map((g) => [g.id, g]));
const group = clip?.group ? groups[clip.group] : null;

const qStart = clip ? (clip.quote_start ?? clip.start) : null;
const qEnd = clip ? (clip.quote_end ?? clip.end) : null;
const inQuote = (l) => clip && l.end > qStart && l.start < qEnd;
---

<div class="ep-strip-wrap">
  <div class="ep-strip" id="ep-strip" title="Jump to another episode or movie">
    {site.media[show].map((em) => (
      <a class:list={["ep-card", { on: em.id === item }]} href={`/c/${show}/${em.id}/`} title={em.title}>
        <img loading="lazy" decoding="async" src={`https://i.ytimg.com/vi/${em.youtube}/default.jpg`} alt={em.title} />
        <span>{em.kind === "episode" ? `E${em.number}` : `M${em.number}`}</span>
      </a>
    ))}
  </div>
</div>

<div class="clip-layout">
  <div class="clip-main">
    <div class="clip-head">
      <h1 id="q-title"><span class="qmark">“</span><span id="q-title-text">{clip ? clip.title : mediaLabel(m)}</span><span class="qmark">”</span></h1>
      <div class="title-actions">
        <button class="tbtn primary" id="copy-link" title="Copy link to this quote" aria-label="Copy link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg>
        </button>
        <button class="tbtn" id="copy-yt" title="Copy YouTube link — plays inline on Discord" aria-label="Copy YouTube link">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23 7.5a4 4 0 0 0-2.8-2.9C18 4 12 4 12 4s-6 0-8.2.6A4 4 0 0 0 1 7.5 42 42 0 0 0 .6 12 42 42 0 0 0 1 16.5a4 4 0 0 0 2.8 2.9C6 20 12 20 12 20s6 0 8.2-.6a4 4 0 0 0 2.8-2.9A42 42 0 0 0 23.4 12 42 42 0 0 0 23 7.5zM9.8 15.3V8.7L15.7 12l-5.9 3.3z"/></svg>
        </button>
        <a class="tbtn" id="tab-toggle" href="#video" title="Watch the clip" aria-label="Switch between image and video">
          <svg id="tt-video" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5-11-6.5z"/></svg>
          <svg id="tt-image" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" hidden><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="1.6"/><path d="m5 18 5-5 3 3 3-3 3 3"/></svg>
        </a>
      </div>
    </div>

    <div id="tab-video" hidden>
      <div class="player-wrap has-overlay" id="player-wrap">
        <div id="yt-player"></div>
        <div class="clip-controls overlay" id="controls"></div>
      </div>
      <div class="caption-bar" id="caption"></div>
    </div>

    <div id="tab-image">
      <div class="imgmaker">
        <div class="canvas-wrap">
          <canvas id="imgcanvas" width="640" height="480"></canvas>
          <div class="canvas-actions">
            <button id="cols-btn" hidden title="Panels per row" aria-label="Switch panels per row">
              <svg data-cols="1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="7" y="4" width="10" height="16" rx="1.5"/></svg>
              <svg data-cols="2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" hidden><rect x="4" y="4" width="7" height="16" rx="1.5"/><rect x="13" y="4" width="7" height="16" rx="1.5"/></svg>
              <svg data-cols="3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" hidden><rect x="3" y="4" width="5" height="16" rx="1"/><rect x="9.5" y="4" width="5" height="16" rx="1"/><rect x="16" y="4" width="5" height="16" rx="1"/></svg>
            </button>
            <button id="img-download" title="Download image" aria-label="Download image">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="m7 11 5 5 5-5"/><path d="M4 20h16"/></svg>
            </button>
            <button id="img-copy" title="Copy image to clipboard" aria-label="Copy image">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 4H6a2 2 0 0 0-2 2v10"/></svg>
            </button>
            <button id="img-gif" hidden title="Animated GIF — one slide per selected line" aria-label="Download GIF">GIF</button>
          </div>
        </div>
        <div id="fstrips"></div>
        <div class="imgmaker-bar">
          <div class="textwrap">
            <textarea id="imgtext" rows="2" title="Edit the caption — your image, your words"></textarea>
            <button class="txtbtn" id="copy-quote" title="Copy the dialog as text" aria-label="Copy quote text">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M10 7H5a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h2v3l1.8-.9A6 6 0 0 0 12 11.6V9a2 2 0 0 0-2-2zm11 0h-5a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h2v3l1.8-.9A6 6 0 0 0 23 11.6V9a2 2 0 0 0-2-2z"/></svg>
            </button>
          </div>
          <div class="btn-row" style="margin:0.5rem 0 0">
            <button class="btn" id="save-clip" title="Save on this device — see the Saved page">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" style="width:14px;height:14px"><path d="M12 2.7l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.5l-5.8 3.1 1.1-6.5L2.6 9.5l6.5-.9L12 2.7z"/></svg>
              Save
            </button>
            <span class="tstamp" id="flabel" style="margin-left:auto" title="Frame time"></span>
          </div>
          <p class="meta" id="img-note" hidden>Frames are still uploading — try again soon.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="transcript card dialog-panel" id="dialog">
    {lines.map((l) => (
      <div
        class={`line ${l.kind} ${inQuote(l) ? "in-quote" : ""}`}
        data-i={l.i} data-t={l.start} data-e={l.end}
        title={l.kind === "dialog" ? (l.speaker ? `${l.speaker}: ${l.text}` : l.text) : `[${l.text}]`}
      >
        <span class="lthumb-wrap">
          <img class="lthumb" loading="lazy" decoding="async" crossorigin="anonymous" src={frameUrl(item, lineFrameT([l.start, l.end], l.i, overrides))} alt="" onerror="this.classList.add('dead')" />
          {l.kind === "dialog" && l.speaker && <span class="lspeaker">{l.speaker}</span>}
          <span class="tstamp">{fmtTime(l.start)}</span>
        </span>
        <div class="text">{l.kind === "dialog" ? l.text : <>[{l.text}]</>}</div>
      </div>
    ))}
  </div>
</div>

{related.length > 0 && (
  <>
    <h2>More from this one</h2>
    <div class="clip-grid">
      {related.map((c) => (
        <a class="clip-card bare" href={`/clip/${show}/${c.id}/`} title={`${c.title} — ${c.speaker ?? ""} · ${fmtTime(c.start)}`}>
          {c.image && <img loading="lazy" src={c.image} alt={c.quote} />}
          <span class="ep-tag">{fmtTime(c.start)}</span>
        </a>
      ))}
    </div>
  </>
)}

<div class="toast" id="toast"></div>
<script
  type="application/json"
  id="qn-cfg"
  set:html={JSON.stringify({
    show,
    item,
    items: site.media[show].map((x) => x.id),
    youtube: m.youtube,
    mediaTitle: m.title,
    duration: m.duration,
    lines: t.lines,
    overrides,
    clip: clip && {
      id: clip.id, title: clip.title, speaker: clip.speaker,
      start: clip.start, end: clip.end,
      qStart: clip.quote_start ?? clip.start, qEnd: clip.quote_end ?? clip.end,
    },
    itemClips: itemClips.map((c) => ({
      id: c.id, title: c.title, speaker: c.speaker,
      start: c.start, end: c.end,
      qStart: c.quote_start ?? c.start, qEnd: c.quote_end ?? c.end,
    })),
  })}
/>

<script>
  import { initQuoteNav } from "../lib/quotenav.js";
  initQuoteNav(JSON.parse(document.getElementById("qn-cfg").textContent));

  // center the current episode in the carousel
  const strip = document.getElementById("ep-strip");
  const cur = strip?.querySelector(".ep-card.on");
  if (strip && cur) strip.scrollLeft = cur.offsetLeft - strip.clientWidth / 2 + cur.clientWidth / 2;
</script>
