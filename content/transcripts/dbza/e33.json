   "i": 42,
   "start": 143.1,
   "end": 144.3,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "'THAT, however...'"
  },
  {
   "i": 43,
   "start": 144.56,
   "end": 147.36,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "'Mine-mine-mine-mine mine-mine-mine-mine MINE-MINE-MINE-MINE-MINE!'"
