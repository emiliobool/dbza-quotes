  },
  {
   "start": 271.4,
   "end": 284.9,
   "title": "Bad Touch / Kidney Shot",
   "quote": "Ahh! Bad touch! / Kidney shot! Kidney shot! Kidney shot! / And pause...! ...*Stomach punch*! / Gonna whiz red...",
   "line_start": 95,
