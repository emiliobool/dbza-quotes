   "start": 87.28,
   "end": 90.8,
   "kind": "dialog",
   "speaker": "Freeza",
   "text": "Oh God, what's up with the sky? This planet really *is* about to blow!"
  },
  {
   "i": 25,
   "start": 90.8,
   "end": 94.48,
   "kind": "dialog",
   "speaker": "Freeza",
   "text": "I give it, like... two minutes, tops. I better get to my ship and--"
