  {
   "i": 28,
   "start": 99.82,
   "end": 103.22,
   "kind": "dialog",
   "speaker": "Freeza",
   "text": "YOU THINK YOU'RE BETTER THAN ME?! YOU'RE NOTHING BUT AN OVERGROWN MONKEY!"
  },
  {
   "i": 29,
   "start": 103.22,
   "end": 107.04,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "And you're nothing but an overgrown that-thing-Chi-chi-keeps-in-her-drawer!"
  },
  {
   "i": 30,
   "start": 107.26,
   "end": 111.92,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "'Man, Freezer's stronger than ever at 100%! I'll have to stratergize!'"
  },
  {
   "i": 31,
   "start": 112.14,
   "end": 113.96,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "'I know; a distraction!'"
