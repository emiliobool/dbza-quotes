   "i": 34,
   "start": 120.0,
   "end": 121.3,
   "kind": "dialog",
   "speaker": "Freeza",
   "text": "Immortality-is-mine!"
  },
  {
   "i": 35,
   "start": 121.3,
   "end": 123.04,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "'Ohhh, I am become error...'"
