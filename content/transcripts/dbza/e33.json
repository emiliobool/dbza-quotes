  },
  {
   "start": 302.3,
   "end": 322.6,
   "title": "Except for Krillin",
   "quote": "Turns out that we're all alive! / Except for Krillin! How unfortunate...",
   "line_start": 119,
   "line_end": 127
  },
  {
   "start": 385.5,
   "end": 421.0,
   "title": "Guru's Confession",
   "quote": "It was ME. / How?! / I drank it! / How do you think I got so FAAAT?!",
   "line_start": 152,
