 "title": "Episode 47",
 "duration": 819,
 "lines": [
  {
   "i": 0,
   "start": 14.82,
   "end": 17.28,
   "kind": "direction",
   "speaker": null,
   "text": "Creepy reptilian moan"
  },
  {
   "i": 1,
   "start": 18.06,
   "end": 21.96,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "So, what *is* this, spearmint? Your inbred mutant cousin or something?"
  },
  {
   "i": 2,
   "start": 22.06,
   "end": 24.04,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "Wait, I thought he was on *your* side."
  },
  {
   "i": 3,
   "start": 24.18,
   "end": 25.62,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "What?! Why would *I* know him?"
  },
  {
   "i": 4,
   "start": 25.9,
   "end": 28.4,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "Hello... *Brotherrr*..."
  },
  {
   "i": 5,
   "start": 28.4,
   "end": 29.2,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Come again?"
  },
  {
   "i": 6,
   "start": 29.2,
   "end": 30.56,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "In a moment."
  },
  {
   "i": 7,
   "start": 30.56,
   "end": 31.6,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "And hello..."
  },
  {
   "i": 8,
   "start": 31.9,
   "end": 35.06,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "...My BEAAAUTIFUL SISTER....."
  },
  {
   "i": 9,
   "start": 35.06,
   "end": 36.34,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "(Slurping sounds)"
  },
  {
   "i": 10,
   "start": 36.82,
   "end": 38.22,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "Oh, f*ck no!"
  },
  {
   "i": 11,
   "start": 38.46,
   "end": 39.16,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "And..."
  },
  {
   "i": 12,
   "start": 40.2,
   "end": 41.32,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "...Um."
  },
  {
   "i": 13,
   "start": 41.32,
   "end": 43.96,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "I am designated as Android 16."
  },
  {
   "i": 14,
   "start": 43.96,
   "end": 44.74,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "......."
  },
  {
   "i": 15,
   "start": 44.74,
   "end": 46.18,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "Cool. Anywho..."
  },
  {
   "i": 16,
   "start": 48.3,
   "end": 50.88,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "You have my sincerest gratitude, Piccolo~."
  },
  {
   "i": 17,
   "start": 51.18,
   "end": 55.16,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "Without power levels, I would have been left searching for them blindly."
  },
  {
   "i": 18,
   "start": 55.16,
   "end": 61.32,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "But thanks to *your* little skirmish, I have been reunited with my *family*...!"
  },
  {
   "i": 19,
   "start": 61.76,
   "end": 65.78,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "...And we have sooo much catching up to do~......!"
  },
  {
   "i": 20,
   "start": 66.4,
   "end": 68.64,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "HAAAA-AAAAA-!!!!!"
  },
  {
   "i": 21,
   "start": 68.64,
   "end": 72.18,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Okay, so am I alone or did that not explain ANYTHING?!"
  },
  {
   "i": 22,
   "start": 72.32,
   "end": 76.06,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "He calls himself Cell. He's one of Dr. Gero's creations!"
  },
  {
   "i": 23,
   "start": 76.06,
   "end": 77.38,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "He's from the future."
  },
  {
   "i": 24,
   "start": 77.38,
   "end": 79.78,
   "kind": "direction",
   "speaker": null,
   "text": "Sarcasm ABOUNDING"
  },
  {
   "i": 25,
   "start": 77.38,
   "end": 79.78,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Oh, sure! He's from the future!"
  },
  {
   "i": 26,
   "start": 79.78,
   "end": 81.54,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Yeah, and I'm a Park Ranger!"
  },
  {
   "i": 27,
   "start": 81.54,
   "end": 82.64,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "That sounds nice."
  },
  {
   "i": 28,
   "start": 82.64,
   "end": 84.0,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "Can we FOCUS?!?!"
  },
  {
   "i": 29,
   "start": 84.0,
   "end": 85.74,
   "kind": "sfx",
   "speaker": null,
   "text": "KABOOM"
  },
  {
   "i": 30,
   "start": 88.68,
   "end": 91.08,
   "kind": "dialog",
   "speaker": "Tien",
   "text": "...Guys? Is that who I think it is?"
  },
  {
   "i": 31,
   "start": 91.08,
   "end": 92.52,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Yeah, no yeah! Yeah!"
  },
  {
   "i": 32,
   "start": 92.52,
   "end": 93.22,
   "kind": "dialog",
   "speaker": "Roshi",
   "text": "Dammit!"
  },
  {
   "i": 33,
   "start": 93.22,
   "end": 95.42,
   "kind": "dialog",
   "speaker": "Roshi",
   "text": "And we still don't have that detonator."
  },
  {
   "i": 34,
   "start": 95.42,
   "end": 97.92,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Yeah no! Yeah! Yeah, no!"
  },
  {
   "i": 35,
   "start": 97.92,
   "end": 100.54,
   "kind": "dialog",
   "speaker": "Tien",
   "text": "We're out of time! We need to do something NOW!"
  },
  {
   "i": 36,
   "start": 100.54,
   "end": 101.24,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Yeah!"
  },
  {
   "i": 37,
   "start": 101.7,
   "end": 107.26,
   "kind": "dialog",
   "speaker": "Chi-Chi",
   "text": "Here's a thought: How about one of you, who can fly faster than the speed of sound, go meet Bulma halfway?"
  },
  {
   "i": 38,
   "start": 108.06,
   "end": 111.52,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Chi-Chi, you beautiful woman who lives in Goku's house!"
  },
  {
   "i": 39,
   "start": 111.52,
   "end": 112.72,
   "kind": "dialog",
   "speaker": "Chi-Chi",
   "text": "That is what I do."
  },
  {
   "i": 40,
   "start": 112.72,
   "end": 114.08,
   "kind": "dialog",
   "speaker": "Roshi",
   "text": "Well then, which one of you--"
  },
  {
   "i": 41,
   "start": 114.08,
   "end": 114.82,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "DIBS!"
  },
  {
   "i": 42,
   "start": 114.82,
   "end": 115.38,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "WOOHOO!"
  },
  {
   "i": 43,
   "start": 116.78,
   "end": 117.66,
   "kind": "dialog",
   "speaker": "Roshi",
   "text": "Well, that works."
  },
  {
   "i": 44,
   "start": 117.94,
   "end": 121.02,
   "kind": "dialog",
   "speaker": "Roshi",
   "text": "Guess this is all we can do until Goku and Vegeta get ba--"
  },
  {
   "i": 45,
   "start": 121.02,
   "end": 121.86,
   "kind": "dialog",
   "speaker": "Tien",
   "text": "*ENOUGH!*"
  },
  {
   "i": 46,
   "start": 121.86,
   "end": 125.28,
   "kind": "dialog",
   "speaker": "Tien",
   "text": "I am not a spectator! I AM A *WARRIOR*!"
  },
  {
   "i": 47,
   "start": 129.02,
   "end": 130.58,
   "kind": "dialog",
   "speaker": "Roshi",
   "text": "I can never read that guy."
  },
  {
   "i": 48,
   "start": 130.84,
   "end": 132.1,
   "kind": "dialog",
   "speaker": "Chi-Chi",
   "text": "Aren't you going to help too?"
  },
  {
   "i": 49,
   "start": 132.1,
   "end": 132.84,
   "kind": "dialog",
   "speaker": "Roshi",
   "text": "No."
  },
  {
   "i": 50,
   "start": 132.84,
   "end": 133.98,
   "kind": "dialog",
   "speaker": "Chi-Chi",
   "text": "Is it because you're old?"
  },
  {
   "i": 51,
   "start": 133.98,
   "end": 134.56,
   "kind": "dialog",
   "speaker": "Roshi",
   "text": "Yeh."
  },
  {
   "i": 52,
   "start": 135.62,
   "end": 136.6,
   "kind": "dialog",
   "speaker": "Chi-Chi",
   "text": "Where's Yamcha?"
  },
  {
   "i": 53,
   "start": 138.28,
   "end": 141.4,
   "kind": "dialog",
   "speaker": "Yamcha",
   "text": "Hey Master Roshi! You're out of toilet paper!"
  },
  {
   "i": 54,
   "start": 142.48,
   "end": 145.66,
   "kind": "direction",
   "speaker": null,
   "text": "Sounds of the toilet clogging and overflowing"
  },
  {
   "i": 55,
   "start": 142.48,
   "end": 145.66,
   "kind": "dialog",
   "speaker": "Yamcha",
   "text": "Oh no... oh jeez, OH GOD...!"
  },
  {
   "i": 56,
   "start": 165.78,
   "end": 169.36,
   "kind": "direction",
   "speaker": null,
   "text": "Rubble crashing, HOLY CRAP, how POWERFUL was that last energy display-??"
  },
  {
   "i": 57,
   "start": 173.4,
   "end": 179.06,
   "kind": "dialog",
   "speaker": "Kami",
   "text": "'Alright... he's grown just a bit stronger since last time... No big deal. We've got this.'"
  },
  {
   "i": 58,
   "start": 179.06,
   "end": 183.2,
   "kind": "dialog",
   "speaker": "Nail",
   "text": "'HE'S GOING TO KILL US. He's going to kill Piccolo, and by extension, *US*.!!!'"
  },
  {
   "i": 59,
   "start": 183.2,
   "end": 186.36,
   "kind": "dialog",
   "speaker": "Kami",
   "text": "'I'm TRYING to boost his morale, you idiot!'"
  },
  {
   "i": 60,
   "start": 187.54,
   "end": 189.92,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "Is it hard to bear, Piccolo?"
  },
  {
   "i": 61,
   "start": 190.44,
   "end": 192.66,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "My overwhelming power?"
  },
  {
   "i": 62,
   "start": 193.06,
   "end": 194.16,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "Its weight?"
  },
  {
   "i": 63,
   "start": 194.72,
   "end": 197.32,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "Its... GIRTH~?"
  },
  {
   "i": 64,
   "start": 197.7,
   "end": 198.6,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "How..."
  },
  {
   "i": 65,
   "start": 198.84,
   "end": 200.1,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "HOW MANY PEOPLE?!"
  },
  {
   "i": 66,
   "start": 202.08,
   "end": 202.92,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "...Enough."
  },
  {
   "i": 67,
   "start": 202.08,
   "end": 202.92,
   "kind": "direction",
   "speaker": null,
   "text": "EEP-!!"
  },
  {
   "i": 68,
   "start": 205.36,
   "end": 211.64,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Look, I don't know what you're on about with this family nonsense, but if you're here because of Gero, I 86'd him myself!"
  },
  {
   "i": 69,
   "start": 211.92,
   "end": 215.36,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "So why don't we cancel these family matters, shelve the photo album and--"
  },
  {
   "i": 70,
   "start": 215.36,
   "end": 216.18,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "FWUH!!!"
  },
  {
   "i": 71,
   "start": 220.36,
   "end": 221.08,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "... Come again-???"
  },
  {
   "i": 72,
   "start": 221.08,
   "end": 222.66,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "If you insist!"
  },
  {
   "i": 73,
   "start": 222.74,
   "end": 225.68,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "(Creepy laughter)"
  },
  {
   "i": 74,
   "start": 225.74,
   "end": 227.26,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "HA-HWUUAHHH-!!!!"
  },
  {
   "i": 75,
   "start": 230.26,
   "end": 232.6,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "(More creepy laughter...)"
  },
  {
   "i": 76,
   "start": 232.8,
   "end": 234.92,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Oookay! Future bugman..."
  },
  {
   "i": 77,
   "start": 235.44,
   "end": 237.6,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Let's say I, uh... Believe that now...."
  },
  {
   "i": 78,
   "start": 238.28,
   "end": 239.34,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Where do we go from here?"
  },
  {
   "i": 79,
   "start": 239.4,
   "end": 240.72,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "INSIDE ME!"
  },
  {
   "i": 80,
   "start": 240.88,
   "end": 241.74,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Stop it!"
  },
  {
   "i": 81,
   "start": 241.74,
   "end": 246.12,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "He's also a walking talking Petri dish of the galaxy's strongest fighters!"
  },
  {
   "i": 82,
   "start": 246.12,
   "end": 248.12,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "No need for flattery, Piccolo."
  },
  {
   "i": 83,
   "start": 248.12,
   "end": 249.62,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "*You're already inside me.*"
  },
  {
   "i": 84,
   "start": 249.66,
   "end": 250.66,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "STOP IT!"
  },
  {
   "i": 85,
   "start": 250.84,
   "end": 252.96,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Scared to ask, but, anything else?"
  },
  {
   "i": 86,
   "start": 252.96,
   "end": 256.14,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "Ohoh, tell them about the part where I took an entire Battleball team!"
  },
  {
   "i": 87,
   "start": 256.14,
   "end": 258.28,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "AT THE SAME TIME!"
  },
  {
   "i": 88,
   "start": 258.28,
   "end": 259.16,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "... Wait, is he kidding?"
  },
  {
   "i": 89,
   "start": 259.16,
   "end": 259.78,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "No."
  },
  {
   "i": 90,
   "start": 259.78,
   "end": 260.4,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "Ugh!"
  },
  {
   "i": 91,
   "start": 260.46,
   "end": 263.4,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "That's fun, but it really doesn't answer the big question:"
  },
  {
   "i": 92,
   "start": 263.62,
   "end": 264.9,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Why is he here?"
  },
  {
   "i": 93,
   "start": 265.0,
   "end": 268.86,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "You know, it's rude to talk about someone when they're right in front of you."
  },
  {
   "i": 94,
   "start": 268.86,
   "end": 271.4,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Okay; WHY ARE YOU HERE?"
  },
  {
   "i": 95,
   "start": 271.86,
   "end": 273.44,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "Because, BITCH..."
  },
  {
   "i": 96,
   "start": 274.1,
   "end": 275.82,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "I DRINK PEOPLE."
  },
  {
   "i": 97,
   "start": 277.58,
   "end": 278.54,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "...Yeah, f*ck that!"
  },
  {
   "i": 98,
   "start": 278.9,
   "end": 280.54,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "HYAAAAAAAH--"
  },
  {
   "i": 99,
   "start": 280.54,
   "end": 281.64,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "GAAAGH!!"
  },
  {
   "i": 100,
   "start": 281.84,
   "end": 282.9,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "HRAGH!!"
  },
  {
   "i": 101,
   "start": 282.9,
   "end": 283.74,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "GAUGH-!!"
  },
  {
   "i": 102,
   "start": 283.74,
   "end": 286.14,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "AGAHBLAGHABLAGLABALGA"
  },
  {
   "i": 103,
   "start": 287.04,
   "end": 287.98,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "You should leave."
  },
  {
   "i": 104,
   "start": 288.22,
   "end": 289.34,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "What? Why?"
  },
  {
   "i": 105,
   "start": 289.58,
   "end": 292.1,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "Neither of them can stand up to this \"Cell\"."
  },
  {
   "i": 106,
   "start": 292.34,
   "end": 295.7,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "If he defeats them, you may not be safe."
  },
  {
   "i": 107,
   "start": 295.84,
   "end": 297.12,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "I can't just run."
  },
  {
   "i": 108,
   "start": 297.12,
   "end": 299.44,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "I'm WAY too curious to see how this plays out."
  },
  {
   "i": 109,
   "start": 299.62,
   "end": 301.98,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "I believe that is a poor decision."
  },
  {
   "i": 110,
   "start": 302.32,
   "end": 302.82,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "Maybe..."
  },
  {
   "i": 111,
   "start": 303.26,
   "end": 304.46,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "But it's mine to make."
  },
  {
   "i": 112,
   "start": 305.34,
   "end": 308.36,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "GKTAAAKAAGKT-AAAAGH-!!"
  },
  {
   "i": 113,
   "start": 308.38,
   "end": 312.08,
   "kind": "dialog",
   "speaker": "Kami",
   "text": "'I believe this what the young people call, \"getting rekt\".'"
  },
  {
   "i": 114,
   "start": 312.08,
   "end": 316.0,
   "kind": "dialog",
   "speaker": "Nail",
   "text": "'Yeah, man. If you have any techniques left up your sleeve, now's the time...!'"
  },
  {
   "i": 115,
   "start": 316.26,
   "end": 318.6,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "'Yeah... I think I got one.'"
  },
  {
   "i": 116,
   "start": 318.76,
   "end": 320.3,
   "kind": "dialog",
   "speaker": "Nail",
   "text": "'Really? Since when?'"
  },
  {
   "i": 117,
   "start": 320.64,
   "end": 321.74,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "'About now-ish.'"
  },
  {
   "i": 118,
   "start": 322.24,
   "end": 326.84,
   "kind": "direction",
   "speaker": null,
   "text": "And CUE MORE SCREAMING."
  },
  {
   "i": 119,
   "start": 327.82,
   "end": 328.76,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "...Nope!"
  },
  {
   "i": 120,
   "start": 329.74,
   "end": 331.46,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "LIGHT GRENADE!"
  },
  {
   "i": 121,
   "start": 332.56,
   "end": 334.98,
   "kind": "sfx",
   "speaker": null,
   "text": "NYOOOOM"
  },
  {
   "i": 122,
   "start": 335.68,
   "end": 337.68,
   "kind": "sfx",
   "speaker": null,
   "text": "KAAAA-BOOOOOOM!!!!"
  },
  {
   "i": 123,
   "start": 349.16,
   "end": 350.86,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "...He never stood a chance."
  },
  {
   "i": 124,
   "start": 351.16,
   "end": 354.36,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "See? And you were so afraid of the big bad bug."
  },
  {
   "i": 125,
   "start": 354.96,
   "end": 356.58,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "*That is not who I meant.*"
  },
  {
   "i": 126,
   "start": 358.06,
   "end": 367.0,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "(Evil chuckling)"
  },
  {
   "i": 127,
   "start": 362.08,
   "end": 362.86,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "'OH...'"
  },
  {
   "i": 128,
   "start": 362.86,
   "end": 363.82,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "'SHHHIT....'"
  },
  {
   "i": 129,
   "start": 367.36,
   "end": 369.78,
   "kind": "dialog",
   "speaker": "Nail",
   "text": "'OOOKAY, last ditch effort didn't work...'"
  },
  {
   "i": 130,
   "start": 369.92,
   "end": 372.54,
   "kind": "dialog",
   "speaker": "Kami",
   "text": "'Any last, LAST ditch efforts?!'"
  },
  {
   "i": 131,
   "start": 372.86,
   "end": 374.14,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "Just one..."
  },
  {
   "i": 132,
   "start": 374.56,
   "end": 375.6,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "NAIL GU--!!"
  },
  {
   "i": 133,
   "start": 376.56,
   "end": 378.02,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "AAIIEE-GAH!!!!"
  },
  {
   "i": 134,
   "start": 380.02,
   "end": 382.96,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "Any last words, my big, green friend?"
  },
  {
   "i": 135,
   "start": 383.02,
   "end": 383.82,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "(Gurgle)"
  },
  {
   "i": 136,
   "start": 384.24,
   "end": 384.9,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "Well said."
  },
  {
   "i": 137,
   "start": 384.9,
   "end": 385.7,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "Good game~."
  },
  {
   "i": 138,
   "start": 387.56,
   "end": 388.1,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "(Terrified grunt)"
  },
  {
   "i": 139,
   "start": 388.1,
   "end": 389.36,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "OH, THAT AIN'T GOOD..."
  },
  {
   "i": 140,
   "start": 393.34,
   "end": 395.48,
   "kind": "dialog",
   "speaker": "Kami",
   "text": "'Well... That's it, then, isn't it?'"
  },
  {
   "i": 141,
   "start": 395.92,
   "end": 398.74,
   "kind": "dialog",
   "speaker": "Nail",
   "text": "'...... Gentlemen, it's been a privilege fighting with you....'"
  },
  {
   "i": 142,
   "start": 398.74,
   "end": 403.54,
   "kind": "direction",
   "speaker": null,
   "text": "♫ \"Nearer, My God, to Thee\" (violin rendition) ♫"
  },
  {
   "i": 143,
   "start": 403.54,
   "end": 405.36,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "(Gritting his teeth in utter fury)"
  },
  {
   "i": 144,
   "start": 403.54,
   "end": 407.48,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "You know, funny thing is... either way, we still wouldn't have Dragon Balls."
  },
  {
   "i": 145,
   "start": 407.98,
   "end": 409.5,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "MR. PICCOLOOO!!!"
  },
  {
   "i": 146,
   "start": 409.5,
   "end": 410.34,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Gohan, no!"
  },
  {
   "i": 147,
   "start": 410.34,
   "end": 412.86,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "I'LL KILL 'IM! *I'LL F*CKING KILL HIM!!!!*"
  },
  {
   "i": 148,
   "start": 413.02,
   "end": 415.44,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "You can't! Cell is too strong for you!"
  },
  {
   "i": 149,
   "start": 415.54,
   "end": 417.46,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "Mr. Piccolo would let me go!"
  },
  {
   "i": 150,
   "start": 417.46,
   "end": 418.84,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "No, he wouldn't!"
  },
  {
   "i": 151,
   "start": 418.84,
   "end": 420.4,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "And he's SMARTER than me."
  },
  {
   "i": 152,
   "start": 420.58,
   "end": 421.08,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "I--"
  },
  {
   "i": 153,
   "start": 421.88,
   "end": 424.08,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "...Wow, o-okay. That's..."
  },
  {
   "i": 154,
   "start": 424.64,
   "end": 426.28,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "...Actually a good point."
  },
  {
   "i": 155,
   "start": 426.52,
   "end": 430.82,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "And besides; the moment you leave, that door is going to open."
  },
  {
   "i": 156,
   "start": 430.82,
   "end": 431.94,
   "kind": "dialog",
   "speaker": "Mr. Popo",
   "text": "He's right, you know."
  },
  {
   "i": 157,
   "start": 431.94,
   "end": 432.74,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Every time."
  },
  {
   "i": 158,
   "start": 435.18,
   "end": 436.44,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "Ah, Piccolo..."
  },
  {
   "i": 159,
   "start": 436.94,
   "end": 438.22,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "He died as he lived."
  },
  {
   "i": 160,
   "start": 438.66,
   "end": 439.36,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "Drowning?"
  },
  {
   "i": 161,
   "start": 439.6,
   "end": 440.42,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "Alone."
  },
  {
   "i": 162,
   "start": 440.74,
   "end": 441.78,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "That is sad."
  },
  {
   "i": 163,
   "start": 441.94,
   "end": 446.16,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "Yes. Such isolation. I know his pain."
  },
  {
   "i": 164,
   "start": 446.52,
   "end": 448.2,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "So, my siblings..."
  },
  {
   "i": 165,
   "start": 448.78,
   "end": 450.5,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "Why don't you come with me..."
  },
  {
   "i": 166,
   "start": 451.12,
   "end": 452.4,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "And you'll be..."
  },
  {
   "i": 167,
   "start": 452.92,
   "end": 455.38,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "(To the tune of 'Willy Wonka's World of Imagination')...In a world of truly pure"
  },
  {
   "i": 168,
   "start": 455.48,
   "end": 457.36,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "PERFECTION~~~~~~......"
  },
  {
   "i": 169,
   "start": 457.36,
   "end": 458.22,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "*Stop it*!!"
  },
  {
   "i": 170,
   "start": 458.4,
   "end": 460.58,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "Seventeen! We need to go!"
  },
  {
   "i": 171,
   "start": 461.08,
   "end": 461.6,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "No."
  },
  {
   "i": 172,
   "start": 461.94,
   "end": 463.5,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "I'm gonna play this one out."
  },
  {
   "i": 173,
   "start": 463.52,
   "end": 465.8,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "I believe that is a *poor decision*!"
  },
  {
   "i": 174,
   "start": 466.06,
   "end": 466.7,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Probably..."
  },
  {
   "i": 175,
   "start": 467.2,
   "end": 468.56,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "But it's mine to make!"
  },
  {
   "i": 176,
   "start": 468.9,
   "end": 471.44,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "HYAAAAAAAAAAAA--"
  },
  {
   "i": 177,
   "start": 474.46,
   "end": 475.16,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "Y'know..."
  },
  {
   "i": 178,
   "start": 476.16,
   "end": 477.3,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "*He wasn't wrong.*"
  },
  {
   "i": 179,
   "start": 479.36,
   "end": 480.32,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "This... Is..."
  },
  {
   "i": 180,
   "start": 480.62,
   "end": 482.58,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "The... GROSSEST THING-..!!!"
  },
  {
   "i": 181,
   "start": 482.78,
   "end": 485.56,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "Aw, come now. Don't be so scared."
  },
  {
   "i": 182,
   "start": 485.58,
   "end": 489.32,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "Once you're a part of me, you'll be reunited with our sister in..."
  },
  {
   "i": 183,
   "start": 489.84,
   "end": 491.38,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "...I dunno; give me five minutes."
  },
  {
   "i": 184,
   "start": 491.38,
   "end": 492.24,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "Ten, tops."
  },
  {
   "i": 185,
   "start": 492.5,
   "end": 498.74,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "And once I have achieved my perfection, I'll take my time *killing every person on this planet...*"
  },
  {
   "i": 186,
   "start": 499.14,
   "end": 501.82,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "Even the mighty Goku~~..."
  },
  {
   "i": 187,
   "start": 501.82,
   "end": 504.6,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "(Maniacal laughter)"
  },
  {
   "i": 188,
   "start": 504.82,
   "end": 507.7,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "Would you care to repeat that, YOU SON OF A BITCH?"
  },
  {
   "i": 189,
   "start": 513.08,
   "end": 514.5,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "Got another one in ya?"
  },
  {
   "i": 190,
   "start": 514.5,
   "end": 516.0,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "*STOP... IT!!!*"
  },
  {
   "i": 191,
   "start": 516.38,
   "end": 519.56,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Damn, Sixteen! Where the hell did THAT come from???"
  },
  {
   "i": 192,
   "start": 519.74,
   "end": 521.3,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "And what TOOK YOU SO LONG?!?!"
  },
  {
   "i": 193,
   "start": 521.56,
   "end": 524.18,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "I was waiting to see *how things played out*."
  },
  {
   "i": 194,
   "start": 524.6,
   "end": 525.12,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Wait..."
  },
  {
   "i": 195,
   "start": 525.56,
   "end": 527.1,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Was that *sarcasm*?"
  },
  {
   "i": 196,
   "start": 527.22,
   "end": 529.28,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "(Surprisingly Sassy tone.) *I am not programmed for sarcasm...*"
  },
  {
   "i": 197,
   "start": 529.44,
   "end": 530.54,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "..... I'm proud of you."
  },
  {
   "i": 198,
   "start": 530.6,
   "end": 534.16,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "Now if you'll excuse me, I will eliminate Cell."
  },
  {
   "i": 199,
   "start": 534.16,
   "end": 536.44,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "I thought you were only programmed to kill Goku."
  },
  {
   "i": 200,
   "start": 536.7,
   "end": 541.78,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "This \"Cell\" is comprised of 10.78% of Son Goku's DNA."
  },
  {
   "i": 201,
   "start": 542.28,
   "end": 543.5,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "These parameters..."
  },
  {
   "i": 202,
   "start": 544.08,
   "end": 545.5,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "ARE ACCEPTABLE."
  },
  {
   "i": 203,
   "start": 546.72,
   "end": 549.06,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "Oh, ok, I guess we're doing THIS now!!!"
  },
  {
   "i": 204,
   "start": 549.06,
   "end": 550.28,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "HAAAAAAAAAAH"
  },
  {
   "i": 205,
   "start": 550.28,
   "end": 551.88,
   "kind": "sfx",
   "speaker": null,
   "text": "(THU-CLANK!!!)"
  },
  {
   "i": 206,
   "start": 554.28,
   "end": 555.12,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "RAGH!!! (THUD!!)"
  },
  {
   "i": 207,
   "start": 558.2,
   "end": 559.2,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "HEHEHEHE~!!!"
  },
  {
   "i": 208,
   "start": 559.42,
   "end": 564.18,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "Ohhhh! An admirable attempt by the red-headed stepchild!"
  },
  {
   "i": 209,
   "start": 564.2,
   "end": 567.26,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "But don't feel too disappointed; for now..."
  },
  {
   "i": 210,
   "start": 567.5,
   "end": 569.5,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "YOU shall be a part of ME!"
  },
  {
   "i": 211,
   "start": 569.5,
   "end": 570.36,
   "kind": "direction",
   "speaker": null,
   "text": "muffled Vacuum sounds"
  },
  {
   "i": 212,
   "start": 570.96,
   "end": 572.54,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "...? Of ME!"
  },
  {
   "i": 213,
   "start": 571.6,
   "end": 572.54,
   "kind": "direction",
   "speaker": null,
   "text": "More Muffled Vacuum sounds"
  },
  {
   "i": 214,
   "start": 572.66,
   "end": 573.16,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "Agh????"
  },
  {
   "i": 215,
   "start": 573.84,
   "end": 575.64,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "*Of MEEEEEE!!!*"
  },
  {
   "i": 216,
   "start": 574.5,
   "end": 575.64,
   "kind": "direction",
   "speaker": null,
   "text": "Even MORE Muffled Vacuum sounds"
  },
  {
   "i": 217,
   "start": 575.64,
   "end": 576.66,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "AGH, GOD!"
  },
  {
   "i": 218,
   "start": 576.9,
   "end": 579.32,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "Gah, what are you made of??? Pure METAL?!?!"
  },
  {
   "i": 219,
   "start": 579.86,
   "end": 583.02,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "Affirmative. I am *ANDROID* 16."
  },
  {
   "i": 220,
   "start": 583.46,
   "end": 584.1,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "Oh..."
  },
  {
   "i": 221,
   "start": 584.74,
   "end": 585.84,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "Errors have been made..."
  },
  {
   "i": 222,
   "start": 586.08,
   "end": 587.96,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "HWAAAAAAAAAAAAAAGH-!!!!!!!"
  },
  {
   "i": 223,
   "start": 587.96,
   "end": 589.74,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "HAAAAH"
  },
  {
   "i": 224,
   "start": 587.96,
   "end": 589.74,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "AAAAAAAAAAAAAAAAAAAAAA-"
  },
  {
   "i": 225,
   "start": 589.74,
   "end": 591.74,
   "kind": "direction",
   "speaker": null,
   "text": "IMPERFECT CRASH!!"
  },
  {
   "i": 226,
   "start": 592.0,
   "end": 593.22,
   "kind": "direction",
   "speaker": null,
   "text": "STOMP!!"
  },
  {
   "i": 227,
   "start": 592.0,
   "end": 593.22,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "AAAAAAAAAAAAGH-!!!!!!!"
  },
  {
   "i": 228,
   "start": 594.98,
   "end": 596.32,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "N-n-now I know what you're thinking..!!"
  },
  {
   "i": 229,
   "start": 596.6,
   "end": 598.02,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "\"Should I rip off his tail?\""
  },
  {
   "i": 230,
   "start": 598.34,
   "end": 600.34,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "And the answer might surprise--"
  },
  {
   "i": 231,
   "start": 600.34,
   "end": 600.84,
   "kind": "direction",
   "speaker": null,
   "text": "RRRIP!!!!"
  },
  {
   "i": 232,
   "start": 600.84,
   "end": 603.66,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "WAAAAAAAAAAAAAAAAA-!!!!!!!!!!!!!!!!!!!!!!!"
  },
  {
   "i": 233,
   "start": 603.66,
   "end": 605.2,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "....... I was not ready for today..."
  },
  {
   "i": 234,
   "start": 603.66,
   "end": 606.88,
   "kind": "direction",
   "speaker": null,
   "text": "Cell continues to cry out in excruciating pain"
  },
  {
   "i": 235,
   "start": 605.2,
   "end": 606.88,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "I don't think ANY OF US WERE........"
  },
  {
   "i": 236,
   "start": 607.4,
   "end": 610.1,
   "kind": "direction",
   "speaker": null,
   "text": "Cell panting in pain"
  },
  {
   "i": 237,
   "start": 610.36,
   "end": 611.3,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "Do you know..."
  },
  {
   "i": 238,
   "start": 611.3,
   "end": 613.64,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "How long it's gonna take..."
  },
  {
   "i": 239,
   "start": 613.64,
   "end": 615.64,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "*TO REGROW MY TAIL?!*"
  },
  {
   "i": 240,
   "start": 616.38,
   "end": 617.0,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": ".... Pardon m--"
  },
  {
   "i": 241,
   "start": 617.0,
   "end": 617.5,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "Boop. (Wait wha-)"
  },
  {
   "i": 242,
   "start": 617.5,
   "end": 619.42,
   "kind": "direction",
   "speaker": null,
   "text": "... HURK-ASGD!!"
  },
  {
   "i": 243,
   "start": 619.42,
   "end": 623.54,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "Thanks to Uncle Piccolo's cells, an ultimately fruitless effort."
  },
  {
   "i": 244,
   "start": 623.9,
   "end": 625.68,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "But if it's any consolation..."
  },
  {
   "i": 245,
   "start": 625.94,
   "end": 627.94,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "...That *hurt like hell!*"
  },
  {
   "i": 246,
   "start": 628.4,
   "end": 630.76,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "My mistake was starting at the wrong end."
  },
  {
   "i": 247,
   "start": 631.06,
   "end": 632.34,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "My next attempt..."
  },
  {
   "i": 248,
   "start": 632.34,
   "end": 634.0,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "Will be on your HEAD."
  },
  {
   "i": 249,
   "start": 634.0,
   "end": 635.68,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "(Chuckling)"
  },
  {
   "i": 250,
   "start": 635.68,
   "end": 639.46,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "And your second mistake is assuming I'll give you another chance."
  },
  {
   "i": 251,
   "start": 639.46,
   "end": 641.44,
   "kind": "sfx",
   "speaker": null,
   "text": "(POWER BURST, ZOOM!!)"
  },
  {
   "i": 252,
   "start": 641.44,
   "end": 643.44,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "GAGH!!"
  },
  {
   "i": 253,
   "start": 644.14,
   "end": 645.66,
   "kind": "sfx",
   "speaker": null,
   "text": "WHOOSH!!!"
  },
  {
   "i": 254,
   "start": 646.5,
   "end": 647.72,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "ROCKET PUNCH!"
  },
  {
   "i": 255,
   "start": 649.16,
   "end": 649.66,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "WHA-?!?"
  },
  {
   "i": 256,
   "start": 649.66,
   "end": 650.4,
   "kind": "sfx",
   "speaker": null,
   "text": "WHAM!!!!"
  },
  {
   "i": 257,
   "start": 649.66,
   "end": 650.4,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "PAH-!!!!!!!"
  },
  {
   "i": 258,
   "start": 650.52,
   "end": 651.66,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "'Wow. Really?'"
  },
  {
   "i": 259,
   "start": 651.68,
   "end": 653.36,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "'THAT IS SO COOL!'"
  },
  {
   "i": 260,
   "start": 655.48,
   "end": 656.18,
   "kind": "sfx",
   "speaker": null,
   "text": "(CLANK!)"
  },
  {
   "i": 261,
   "start": 656.42,
   "end": 658.42,
   "kind": "sfx",
   "speaker": null,
   "text": "(WHAM, CRASH!!)"
  },
  {
   "i": 262,
   "start": 659.04,
   "end": 661.04,
   "kind": "direction",
   "speaker": null,
   "text": "Robotic clanking sounds as 16 picks up Cell."
  },
  {
   "i": 263,
   "start": 661.04,
   "end": 663.04,
   "kind": "direction",
   "speaker": null,
   "text": "CEEEERRAASH!!!!"
  },
  {
   "i": 264,
   "start": 663.36,
   "end": 665.72,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "Hagh, what is *HAPPENING RIGHT NOW?!?!?!?!?!*"
  },
  {
   "i": 265,
   "start": 666.12,
   "end": 667.78,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "Where in the f*ck am I?!?!?"
  },
  {
   "i": 266,
   "start": 668.26,
   "end": 669.78,
   "kind": "sfx",
   "speaker": null,
   "text": "CLANK CLANK"
  },
  {
   "i": 267,
   "start": 670.26,
   "end": 671.8,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "Wait. What's that noise-?"
  },
  {
   "i": 268,
   "start": 672.58,
   "end": 675.18,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "Hold on... Now I see a light..!!"
  },
  {
   "i": 269,
   "start": 675.42,
   "end": 676.66,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "*WALK TOWARDS IT!!!!!*"
  },
  {
   "i": 270,
   "start": 676.66,
   "end": 677.58,
   "kind": "sfx",
   "speaker": null,
   "text": "BOOM!!!"
  },
  {
   "i": 271,
   "start": 677.58,
   "end": 678.38,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "WHAT THE-"
  },
  {
   "i": 272,
   "start": 678.38,
   "end": 681.92,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "HEEEEEEEEEEEEEEEEELLLLLLLLLLLllllloooaaooao"
  },
  {
   "i": 273,
   "start": 689.76,
   "end": 690.72,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "...Oh my God..."
  },
  {
   "i": 274,
   "start": 691.08,
   "end": 692.38,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "He actually did it (!)"
  },
  {
   "i": 275,
   "start": 692.94,
   "end": 694.86,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "Why are you still here?!"
  },
  {
   "i": 276,
   "start": 695.02,
   "end": 698.5,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Oh, come on, we can't just leave you here! We're the Three Amigos!"
  },
  {
   "i": 277,
   "start": 698.62,
   "end": 700.24,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "You do not understand."
  },
  {
   "i": 278,
   "start": 700.5,
   "end": 704.48,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "I do not know if I am entirely capable of eliminating this \"Cell\"."
  },
  {
   "i": 279,
   "start": 704.78,
   "end": 706.54,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "And should he absorb the two of you..."
  },
  {
   "i": 280,
   "start": 706.86,
   "end": 708.84,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "...He will wreak havoc upon this world."
  },
  {
   "i": 281,
   "start": 709.12,
   "end": 711.62,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Well, yeah, but... We were gonna do that too."
  },
  {
   "i": 282,
   "start": 711.78,
   "end": 712.36,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "Yes..."
  },
  {
   "i": 283,
   "start": 712.84,
   "end": 714.36,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "But I LIKE you."
  },
  {
   "i": 284,
   "start": 714.44,
   "end": 715.02,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "Aw~!"
  },
  {
   "i": 285,
   "start": 715.4,
   "end": 719.72,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "Over the past last few days, I have come to feel a great adoration for this planet."
  },
  {
   "i": 286,
   "start": 720.26,
   "end": 721.34,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "From it's trees..."
  },
  {
   "i": 287,
   "start": 721.74,
   "end": 722.76,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "...To it's birds..."
  },
  {
   "i": 288,
   "start": 723.44,
   "end": 724.44,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "...To it's people..."
  },
  {
   "i": 289,
   "start": 725.42,
   "end": 726.38,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "...To it's birds."
  },
  {
   "i": 290,
   "start": 726.84,
   "end": 729.58,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "I do not wish to cause anymore destruction."
  },
  {
   "i": 291,
   "start": 729.9,
   "end": 733.04,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "Actually, Sixteen... I think you've got the right idea."
  },
  {
   "i": 292,
   "start": 733.68,
   "end": 734.86,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Yeah, you know what?"
  },
  {
   "i": 293,
   "start": 735.04,
   "end": 736.64,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Screw that noise, man!"
  },
  {
   "i": 294,
   "start": 736.88,
   "end": 740.14,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Forget destroying everything, forget killing people,"
  },
  {
   "i": 295,
   "start": 740.56,
   "end": 741.34,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "And you know what?"
  },
  {
   "i": 296,
   "start": 741.34,
   "end": 741.84,
   "kind": "sfx",
   "speaker": null,
   "text": "TUH"
  },
  {
   "i": 297,
   "start": 742.16,
   "end": 744.6,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Forget killing Son Goku!"
  },
  {
   "i": 298,
   "start": 744.6,
   "end": 746.4,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "LET'S NOT GET CRAZY!"
  },
  {
   "i": 299,
   "start": 747.2,
   "end": 748.48,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "TOO LATE~~~~!!!!!!"
  },
  {
   "i": 300,
   "start": 748.48,
   "end": 750.48,
   "kind": "dialog",
   "speaker": "Imperfect Cell",
   "text": "(Maniacal Cackling)"
  },
  {
   "i": 301,
   "start": 750.48,
   "end": 751.46,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "AGH-!!!"
  },
  {
   "i": 302,
   "start": 751.46,
   "end": 754.86,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Oh God, this is totally disgusting! This isn't how this is supposed to work!"
  },
  {
   "i": 303,
   "start": 754.86,
   "end": 758.18,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "I'm not supposed to die like this! I'M TOO COOL!"
  },
  {
   "i": 304,
   "start": 758.18,
   "end": 762.6,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "SOMEONE PULL OFF HIS TAIL! I'M TOO COOL FOR THIS! I'M TOO COOL--!"
  },
  {
   "i": 305,
   "start": 762.6,
   "end": 763.3,
   "kind": "sfx",
   "speaker": null,
   "text": "GULP"
  },
  {
   "i": 306,
   "start": 764.48,
   "end": 766.14,
   "kind": "direction",
   "speaker": null,
   "text": "ENERGY GATHERS"
  },
  {
   "i": 307,
   "start": 766.28,
   "end": 771.04,
   "kind": "direction",
   "speaker": null,
   "text": "CELL SCREAMS HIS VOICE CHANGING DURING WHICH"
  },
  {
   "i": 308,
   "start": 774.44,
   "end": 775.18,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "RRRRGH!!"
  },
  {
   "i": 309,
   "start": 775.72,
   "end": 783.44,
   "kind": "sfx",
   "speaker": null,
   "text": "(Electricity crackling.........)"
  },
  {
   "i": 310,
   "start": 785.56,
   "end": 787.56,
   "kind": "direction",
   "speaker": null,
   "text": "OH.... SHIT..."
  },
  {
   "i": 311,
   "start": 788.66,
   "end": 792.4,
   "kind": "direction",
   "speaker": null,
   "text": "DBZA OUTRO THEME"
  },
  {
   "i": 312,
   "start": 796.26,
   "end": 802.48,
   "kind": "direction",
   "speaker": null,
   "text": "Pokémon evolution theme (Generation I - R/B/Y)"
  },
  {
   "i": 313,
   "start": 803.26,
   "end": 806.08,
   "kind": "direction",
   "speaker": null,
   "text": "Evolution complete theme"
  }
 ],
