   "i": 72,
   "start": 237.12,
   "end": 237.74,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "Ugh!"
  },
  {
   "i": 73,
   "start": 240.6,
   "end": 241.24,
   "kind": "dialog",
   "speaker": "Tien",
   "text": "YOU!"
