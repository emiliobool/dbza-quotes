  {
   "i": 33,
   "start": 105.12,
   "end": 112.62,
   "kind": "dialog",
   "speaker": "Semi-Perfect Cell",
   "text": "I'd concern yourself less with him, and start focusing on what's important... Meeeee."
  },
  {
   "i": 34,
   "start": 112.62,
   "end": 115.86,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "You! Give me back my brother, you fish-lipped asshole!"
  },
  {
   "i": 35,
   "start": 115.86,
   "end": 119.16,
   "kind": "dialog",
   "speaker": "Semi-Perfect Cell",
   "text": "Now, now, being hurtful isn't gonna bring him back."
  },
  {
   "i": 36,
   "start": 119.16,
   "end": 120.64,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "You're a monster!"
  },
  {
   "i": 37,
   "start": 120.64,
   "end": 123.12,
   "kind": "dialog",
   "speaker": "Semi-Perfect Cell",
   "text": "And he was *delicious*."
  },
  {
   "i": 38,
   "start": 123.12,
   "end": 125.6,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "And you honestly think I'd let you do the same to me?"
  },
  {
   "i": 39,
   "start": 125.6,
   "end": 128.28,
   "kind": "dialog",
   "speaker": "Semi-Perfect Cell",
   "text": "To be honest, your compliance isn't a factor."
  },
  {
   "i": 40,
   "start": 128.54,
   "end": 130.98,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "Well then... I'll just have to do this..."
  },
  {
   "i": 41,
   "start": 131.96,
   "end": 133.44,
   "kind": "dialog",
   "speaker": "Semi-Perfect Cell",
   "text": "...Give yourself a boob exam?"
  },
  {
   "i": 42,
   "start": 133.44,
   "end": 135.92,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "No; explode my bomb."
  },
  {
   "i": 43,
   "start": 135.92,
   "end": 136.96,
   "kind": "dialog",
   "speaker": "Semi-Perfect Cell",
   "text": "In your boob?"
  },
  {
   "i": 44,
   "start": 136.96,
   "end": 138.86,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "*No*; in my ches--"
  },
  {
   "i": 45,
   "start": 138.86,
   "end": 139.72,
   "kind": "dialog",
   "speaker": "Semi-Perfect Cell",
   "text": "Booby bomb!"
  },
  {
   "i": 46,
   "start": 139.72,
   "end": 140.98,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "I'm serious!"
  },
  {
   "i": 47,
   "start": 140.98,
   "end": 149.34,
   "kind": "dialog",
   "speaker": "Semi-Perfect Cell",
   "text": "OK, OK... but before we do something we're all going to regret... let's see what our brother thinks."
  },
  {
   "i": 48,
   "start": 149.34,
   "end": 150.28,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "Wh-- what?"
  },
  {
   "i": 49,
   "start": 152.54,
   "end": 154.62,
   "kind": "dialog",
   "speaker": "Semi-Perfect Cell",
   "text": "Yo shiggy-diggy whassup my sizzle!"
  },
  {
   "i": 50,
   "start": 154.8,
   "end": 155.74,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "Oh my God..."
  },
  {
   "i": 51,
   "start": 156.04,
   "end": 161.0,
   "kind": "dialog",
   "speaker": "Semi-Perfect Cell",
   "text": "Yea don't blow your tits sis, that's whack. You gotta chill yaself before you kill yaself."
  },
  {
   "i": 52,
   "start": 161.0,
   "end": 162.84,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "This can't actually be real."
  },
  {
   "i": 53,
   "start": 162.84,
   "end": 174.26,
   "kind": "dialog",
   "speaker": "Semi-Perfect Cell",
   "text": "Oh, it's real. And it's happening. So what you needa do is calm down, and get all up in Cell. It's downright tubular in here. We got candy and puppies and--"
  },
  {
   "i": 54,
   "start": 174.26,
   "end": 176.4,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "You know absolutely nothing about us, do you?"
  },
  {
   "i": 55,
   "start": 176.72,
   "end": 179.08,
   "kind": "dialog",
   "speaker": "Semi-Perfect Cell",
   "text": "OK, to be fair, I just met you."
  },
  {
   "i": 56,
   "start": 179.08,
   "end": 180.3,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "This isn't a game!"
  },
  {
   "i": 57,
   "start": 180.3,
   "end": 182.54,
   "kind": "dialog",
   "speaker": "Semi-Perfect Cell",
   "text": "Ohhh, but it *is*!"
  },
  {
   "i": 58,
   "start": 182.54,
   "end": 188.78,
   "kind": "dialog",
   "speaker": "Semi-Perfect Cell",
   "text": "All you have to do is kill yourself before I catch you. It's like tag... for keeps."
  },
  {
   "i": 59,
   "start": 188.78,
   "end": 194.04,
   "kind": "dialog",
   "speaker": "Semi-Perfect Cell",
   "text": "And now with both Piccolo and Sixteen out of the way... we can play."
  },
  {
   "i": 60,
   "start": 194.04,
   "end": 194.8,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "Guh!"
  },
  {
   "i": 61,
   "start": 197.16,
   "end": 197.92,
   "kind": "dialog",
   "speaker": "Tien",
   "text": "Not yet!"
  },
  {
   "i": 62,
   "start": 197.92,
   "end": 198.42,
   "kind": "dialog",
   "speaker": "Semi-Perfect Cell",
   "text": "Huh?"
  },
  {
   "i": 63,
   "start": 199.06,
   "end": 204.72,
   "kind": "dialog",
   "speaker": "Semi-Perfect Cell",
   "text": "Ohohoho, my God! It's *Tien*! What, was Krillin busy?!"
