  {
   "i": 64,
   "start": 204.72,
   "end": 205.42,
   "kind": "dialog",
   "speaker": "Tien",
   "text": "(Focused grunt)"
  },
  {
   "i": 65,
   "start": 205.74,
   "end": 210.58,
   "kind": "dialog",
   "speaker": "Semi-Perfect Cell",
   "text": "Come on, buddy, you can't be serious. With your power level?"
  },
  {
   "i": 66,
   "start": 210.58,
   "end": 217.16,
   "kind": "dialog",
   "speaker": "Semi-Perfect Cell",
   "text": "You're no Android, you're no Namekian, and you're certainly no Super Saiyan."
  },
  {
   "i": 67,
   "start": 217.86,
   "end": 219.9,
   "kind": "dialog",
   "speaker": "Semi-Perfect Cell",
   "text": "You're just human."
  },
  {
   "i": 68,
   "start": 220.28,
   "end": 222.24,
   "kind": "dialog",
   "speaker": "Tien",
   "text": "Yeah? Well, you know what?!"
  },
