   "line_end": 65
  },
  {
   "start": 294.4,
   "end": 328.24,
   "title": "Hit Me As Hard As You Can",
   "quote": "I want you. To hit me. As hard. As. You. Can! — And if I don't play along? — Well, then I guess your father was right about you--",
   "line_start": 93,
   "line_end": 106
  },
  {
   "start": 334.9,
   "end": 348.56,
   "title": "You're Either Perfect, or You're Not Me",
   "quote": "\"You're either perfect, or you're *not me*.\"",
   "line_start": 110,
   "line_end": 114
  },
  {
   "start": 424.4,
   "end": 433.38,
   "title": "BUT I LIVE HERE!",
   "quote": "He is going to blow up the planet (!) — BUT I LIVE HERE!",
   "line_start": 141,
   "line_end": 144
  },
  {
   "start": 459.4,
   "end": 477.4,
   "title": "FINAL FLASH",
   "quote": "FINAALL FLAAAASH!!! — Aw, how cute, he named it--OH SHIT!",
