   "line_end": 176
  },
  {
   "start": 551.9,
   "end": 569.98,
   "title": "WE DON'T HAVE DRAGON BALLS, TRUNKS!",
   "quote": "WHY WON'T YOU DIE?!? — Prince... has this *ever* worked? ... WE DON'T HAVE DRAGON BALLS, TRUNKS!",
