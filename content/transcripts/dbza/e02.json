 "title": "Episode 2",
 "duration": 478,
 "lines": [
  {
   "i": 0,
   "start": 8.38,
   "end": 10.88,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Hey Piccolo, mind if I ask you somethin'?"
  },
  {
   "i": 1,
   "start": 11.16,
   "end": 11.88,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "What is it?"
  },
  {
   "i": 2,
   "start": 12.46,
   "end": 14.2,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "You’re not human either, right?"
  },
  {
   "i": 3,
   "start": 14.84,
   "end": 15.6,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "Yeah...?"
  },
  {
   "i": 4,
   "start": 15.96,
   "end": 18.26,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "And your dad spit you out as an egg, right?"
  },
  {
   "i": 5,
   "start": 18.74,
   "end": 19.9,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "What about it?"
  },
  {
   "i": 6,
   "start": 20.6,
   "end": 21.5,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Are..."
  },
  {
   "i": 7,
   "start": 21.92,
   "end": 23.24,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Are you a Yoshi?"
  },
  {
   "i": 8,
   "start": 24.72,
   "end": 28.68,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "...Yes, Goku; I’m a green f***ing dinosaur!"
  },
  {
   "i": 9,
   "start": 29.14,
   "end": 30.06,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Can..."
  },
  {
   "i": 10,
   "start": 30.54,
   "end": 31.72,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Can I ride you?"
  },
  {
   "i": 11,
   "start": 32.22,
   "end": 33.5,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "Huuuurrrrgh...!"
  },
  {
   "i": 12,
   "start": 54.38,
   "end": 65.62,
   "kind": "direction",
   "speaker": null,
   "text": "Gohan is crying"
  },
  {
   "i": 13,
   "start": 55.64,
   "end": 56.52,
   "kind": "dialog",
   "speaker": "Raditz",
   "text": "Shut up."
  },
  {
   "i": 14,
   "start": 57.28,
   "end": 58.34,
   "kind": "dialog",
   "speaker": "Raditz",
   "text": "I said shut up!"
  },
  {
   "i": 15,
   "start": 59.4,
   "end": 60.38,
   "kind": "dialog",
   "speaker": "Raditz",
   "text": "SHUT UP!"
  },
  {
   "i": 16,
   "start": 60.38,
   "end": 62.9,
   "kind": "dialog",
   "speaker": "Raditz",
   "text": "Dammit, why isn’t screaming angrily making you cry less?!"
  },
  {
   "i": 17,
   "start": 63.44,
   "end": 65.62,
   "kind": "dialog",
   "speaker": "Raditz",
   "text": "Aw, to hell with this, you're roomin' in the time-out pod."
  },
  {
   "i": 18,
   "start": 65.62,
   "end": 67.14,
   "kind": "direction",
   "speaker": null,
   "text": "Gohan's cries are silenced by Raditz closing the pod door"
  },
  {
   "i": 19,
   "start": 67.14,
   "end": 69.68,
   "kind": "dialog",
   "speaker": "Raditz",
   "text": "'Thank sweet merciful God that’s over.'"
  },
  {
   "i": 20,
   "start": 70.0,
   "end": 71.56,
   "kind": "dialog",
   "speaker": "Raditz",
   "text": "Now I can just sit back and--"
  },
  {
   "i": 21,
   "start": 71.56,
   "end": 72.78,
   "kind": "direction",
   "speaker": null,
   "text": "Scouter beeps"
  },
  {
   "i": 22,
   "start": 73.12,
   "end": 76.76,
   "kind": "dialog",
   "speaker": "Raditz",
   "text": "...beat the crap out of whoever’s coming, (Sigh), great..."
  },
  {
   "i": 23,
   "start": 76.76,
   "end": 79.56,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Raditz, give me back my son!"
  },
  {
   "i": 24,
   "start": 80.06,
   "end": 81.84,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Wheeeeee!"
  },
  {
   "i": 25,
   "start": 82.14,
   "end": 87.56,
   "kind": "dialog",
   "speaker": "Raditz",
   "text": "Hmmm... so, you’re here already... and I see you brought the Namekian as well."
  },
  {
   "i": 26,
   "start": 87.56,
   "end": 90.32,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "A-actually, that hasn’t been explained yet."
  },
  {
   "i": 27,
   "start": 90.32,
   "end": 90.92,
   "kind": "dialog",
   "speaker": "Raditz",
   "text": "Oh..."
  },
  {
   "i": 28,
   "start": 91.32,
   "end": 93.6,
   "kind": "dialog",
   "speaker": "Raditz",
   "text": "Well, it’s not like anyone cares about him anyway."
  },
  {
   "i": 29,
   "start": 93.96,
   "end": 95.72,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "Well, screw you too!"
  },
  {
   "i": 30,
   "start": 95.72,
   "end": 96.48,
   "kind": "sfx",
   "speaker": null,
   "text": "THUD"
  },
  {
   "i": 31,
   "start": 96.72,
   "end": 99.64,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Piccolo? You use weighted training clothes as well?"
  },
  {
   "i": 32,
   "start": 99.64,
   "end": 103.42,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "No, Goku; I just *love* to get naked when I’m around you."
  },
  {
   "i": 33,
   "start": 103.86,
   "end": 105.86,
   "kind": "dialog",
   "speaker": "Raditz",
   "text": "'Their power level is rising...'"
  },
  {
   "i": 34,
   "start": 106.32,
   "end": 109.22,
   "kind": "dialog",
   "speaker": "Raditz",
   "text": "So... nudity makes you stronger on this planet!"
  },
  {
   "i": 35,
   "start": 109.22,
   "end": 110.04,
   "kind": "direction",
   "speaker": null,
   "text": "Raditz unzips"
  },
  {
   "i": 36,
   "start": 110.2,
   "end": 113.42,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Uh, no; we’re wearing weighted clothing."
  },
  {
   "i": 37,
   "start": 113.42,
   "end": 114.92,
   "kind": "direction",
   "speaker": null,
   "text": "Raditz zips back up"
  },
  {
   "i": 38,
   "start": 113.42,
   "end": 114.92,
   "kind": "dialog",
   "speaker": "Raditz",
   "text": "Oh... of course!"
  },
  {
   "i": 39,
   "start": 114.92,
   "end": 117.82,
   "kind": "dialog",
   "speaker": "Raditz",
   "text": "Because that would be ridiculous! A-hahahaha...!"
  },
  {
   "i": 40,
   "start": 117.82,
   "end": 119.34,
   "kind": "direction",
   "speaker": null,
   "text": "Awkward silence"
  },
  {
   "i": 41,
   "start": 119.34,
   "end": 122.0,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "So that hair *does* compensate for something."
  },
  {
   "i": 42,
   "start": 122.0,
   "end": 124.42,
   "kind": "dialog",
   "speaker": "Phil Ken Sebben",
   "text": "Ha ha! Dangly parts."
  },
  {
   "i": 43,
   "start": 124.66,
   "end": 125.66,
   "kind": "dialog",
   "speaker": "Raditz",
   "text": "SHUT UP!"
  },
  {
   "i": 44,
   "start": 125.66,
   "end": 126.66,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "ERGH!"
  },
  {
   "i": 45,
   "start": 125.66,
   "end": 126.66,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "OOARGH!"
  },
  {
   "i": 46,
   "start": 128.0,
   "end": 130.12,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "OK, what the hell was that?"
  },
  {
   "i": 47,
   "start": 130.12,
   "end": 132.42,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "I don’t know! But let’s try it again..."
  },
  {
   "i": 48,
   "start": 132.42,
   "end": 133.94,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "from *behind*!"
  },
  {
   "i": 49,
   "start": 133.94,
   "end": 134.78,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "AHHHH!"
  },
  {
   "i": 50,
   "start": 133.94,
   "end": 134.78,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "HURRRGH!"
  },
  {
   "i": 51,
   "start": 135.18,
   "end": 135.84,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "AGHH! GUWAH!"
  },
  {
   "i": 52,
   "start": 136.46,
   "end": 138.82,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "We *really* shouldn’t be announcing our attack strategy--"
  },
  {
   "i": 53,
   "start": 138.82,
   "end": 139.44,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Rush him!"
  },
  {
   "i": 54,
   "start": 139.44,
   "end": 140.44,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "Dammit, Goku!"
  },
  {
   "i": 55,
   "start": 141.1,
   "end": 142.3,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "HURRRGH!"
  },
  {
   "i": 56,
   "start": 141.1,
   "end": 143.42,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "Will you at least try to dodge this one?!"
  },
  {
   "i": 57,
   "start": 143.42,
   "end": 144.1,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Dodge wha--?"
  },
  {
   "i": 58,
   "start": 144.1,
   "end": 145.22,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "WHOA, GEEZ!"
  },
  {
   "i": 59,
   "start": 145.6,
   "end": 146.52,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "ARRGH!"
  },
  {
   "i": 60,
   "start": 148.48,
   "end": 149.4,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Ha! You missed me--!"
  },
  {
   "i": 61,
   "start": 149.72,
   "end": 150.26,
   "kind": "dialog",
   "speaker": "Raditz",
   "text": "My bad."
  },
  {
   "i": 62,
   "start": 150.26,
   "end": 151.7,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "AGH! Ugh!"
  },
  {
   "i": 63,
   "start": 151.04,
   "end": 151.7,
   "kind": "sfx",
   "speaker": null,
   "text": "SLAM"
  },
  {
   "i": 64,
   "start": 153.36,
   "end": 154.46,
   "kind": "dialog",
   "speaker": "Raditz",
   "text": "Hu-hu-hu-hu!"
  },
  {
   "i": 65,
   "start": 154.46,
   "end": 157.94,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "'Note to self: Less talky, more fighty.'"
  },
  {
   "i": 66,
   "start": 157.94,
   "end": 158.58,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Ahh..."
  },
  {
   "i": 67,
   "start": 159.0,
   "end": 163.9,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Hey, Piccolo, we may be taking a beating, but at least we managed to dodge that one."
  },
  {
   "i": 68,
   "start": 163.9,
   "end": 166.88,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "High fiiii-EEEE-ee!"
  },
  {
   "i": 69,
   "start": 167.24,
   "end": 168.6,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Uh... handsha--"
  },
  {
   "i": 70,
   "start": 169.56,
   "end": 170.32,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Thumbs u--"
  },
  {
   "i": 71,
   "start": 171.56,
   "end": 172.64,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "...G-good job."
  },
  {
   "i": 72,
   "start": 172.64,
   "end": 174.94,
   "kind": "dialog",
   "speaker": "Raditz",
   "text": "HAHA, AHAHAha, AHAHha!"
  },
  {
   "i": 73,
   "start": 174.94,
   "end": 179.88,
   "kind": "dialog",
   "speaker": "Raditz",
   "text": "\"Aw, excuse me, has anyone seen my arm? You can’t miss it - it’s green!\" Hahaha...!"
  },
  {
   "i": 74,
   "start": 179.88,
   "end": 181.72,
   "kind": "direction",
   "speaker": null,
   "text": "Raditz continues to laugh"
  },
  {
   "i": 75,
   "start": 179.88,
   "end": 181.72,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "Yeah... anyway, listen."
  },
  {
   "i": 76,
   "start": 181.72,
   "end": 186.34,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "I’ve got one more attack that should do it. Upside is, I can use it with one arm."
  },
  {
   "i": 77,
   "start": 186.34,
   "end": 187.64,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "And what's the down side?"
  },
  {
   "i": 78,
   "start": 187.64,
   "end": 189.64,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "You’ll have to distract him while I charge it..."
  },
  {
   "i": 79,
   "start": 189.64,
   "end": 190.64,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "That's not too ba--"
  },
  {
   "i": 80,
   "start": 190.64,
   "end": 191.9,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "...For five minutes."
  },
  {
   "i": 81,
   "start": 191.9,
   "end": 194.86,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "And considering he beat us to a pulp in under one-- eh..."
  },
  {
   "i": 82,
   "start": 194.86,
   "end": 196.76,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "ah, never mind, I’m sure you can handle it."
  },
  {
   "i": 83,
   "start": 197.04,
   "end": 199.56,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Wow... you really have that much faith in me?"
  },
  {
   "i": 84,
   "start": 199.88,
   "end": 202.12,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "Yeah, sure... why not?"
  },
  {
   "i": 85,
   "start": 202.12,
   "end": 203.98,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Well then, I won’t disappoint you."
  },
  {
   "i": 86,
   "start": 204.18,
   "end": 205.42,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Here goes nothin'!"
  },
  {
   "i": 87,
   "start": 205.42,
   "end": 208.26,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "HURRRGH! Ready or not, here I co--!"
  },
  {
   "i": 88,
   "start": 208.26,
   "end": 209.48,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "AGGGHH!"
  },
  {
   "i": 89,
   "start": 208.26,
   "end": 209.48,
   "kind": "direction",
   "speaker": null,
   "text": "Sounds of Goku getting thrashed throughout"
  },
  {
   "i": 90,
   "start": 209.48,
   "end": 211.66,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "♪ 'Dun dunnnn duh dun dun...' ♪"
  },
  {
   "i": 91,
   "start": 211.66,
   "end": 212.6,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "♪ 'Mahna mahna' ♪"
  },
  {
   "i": 92,
   "start": 212.6,
   "end": 213.64,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "♪ 'Dun duh dun duh...' ♪"
  },
  {
   "i": 93,
   "start": 214.38,
   "end": 217.78,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "♪ 'Mahna mahna. Dunnn duh duh duh duh, duh duh duh, duh duh duh, dunna' ♪"
  },
  {
   "i": 94,
   "start": 217.78,
   "end": 219.7,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "♪ 'I'm a chargin’ my attack.' ♪"
  },
  {
   "i": 95,
   "start": 219.94,
   "end": 221.14,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Ha! Got your tail!"
  },
  {
   "i": 96,
   "start": 221.52,
   "end": 223.12,
   "kind": "dialog",
   "speaker": "Raditz",
   "text": "Please let me go?"
  },
  {
   "i": 97,
   "start": 223.12,
   "end": 225.74,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Well... since you asked nicely..."
  },
  {
   "i": 98,
   "start": 225.74,
   "end": 226.78,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "AHHH!"
  },
  {
   "i": 99,
   "start": 226.78,
   "end": 227.68,
   "kind": "direction",
   "speaker": null,
   "text": "Goku continues to get pummeled"
  },
  {
   "i": 100,
   "start": 227.68,
   "end": 234.3,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "'Perhaps on second thought, a whole five-minute startup time for an attack is preeetty abysmal in terms of usability in battle...'"
  },
  {
   "i": 101,
   "start": 234.56,
   "end": 235.8,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Piccolo help!"
  },
  {
   "i": 102,
   "start": 235.8,
   "end": 237.92,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Ha! Got your tail! Again!"
  },
  {
   "i": 103,
   "start": 237.92,
   "end": 239.52,
   "kind": "dialog",
   "speaker": "Raditz",
   "text": "Please let go?"
  },
  {
   "i": 104,
   "start": 239.52,
   "end": 241.52,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "I’m not falling for that again!"
  },
  {
   "i": 105,
   "start": 241.8,
   "end": 243.98,
   "kind": "dialog",
   "speaker": "Raditz",
   "text": "Pretty please let me go?"
  },
  {
   "i": 106,
   "start": 244.14,
   "end": 245.38,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Wellllll..."
  },
  {
   "i": 107,
   "start": 245.38,
   "end": 246.88,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Ooh, OW! Spine!"
  },
  {
   "i": 108,
   "start": 246.88,
   "end": 249.78,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "OW! Ribs! Definitely ribs!"
  },
  {
   "i": 109,
   "start": 249.78,
   "end": 254.86,
   "kind": "dialog",
   "speaker": "Raditz",
   "text": "Aha! Attacking an opponent roughly four times your strength in a one-on-one battle..."
  },
  {
   "i": 110,
   "start": 254.86,
   "end": 256.46,
   "kind": "dialog",
   "speaker": "Raditz",
   "text": "A cunning strategy!"
  },
  {
   "i": 111,
   "start": 256.98,
   "end": 259.02,
   "kind": "dialog",
   "speaker": "Raditz",
   "text": "No... no n-not “cunning”..."
  },
  {
   "i": 112,
   "start": 259.02,
   "end": 260.48,
   "kind": "dialog",
   "speaker": "Raditz",
