{"item": "k02", "show": "dbza", "youtube": "ESDAXKC2418", "title": "Episode 2", "duration": 408, "lines": [{"i": 0, "start": 0.0, "end": 1.74, "kind": "dialog", "speaker": "Freeza", "text": "This is a parody. Buy the f*cking show!"}, {"i": 1, "start": 1.84, "end": 6.72, "kind": "direction", "speaker": null, "text": "Traffic"}, {"i": 2, "start": 6.72, "end": 13.88, "kind": "direction", "speaker": null, "text": "Silence and beeping"}, {"i": 3, "start": 13.88, "end": 14.86, "kind": "dialog", "speaker": "Krillin", "text": "LETS GO TO SPACE!!"}, {"i": 4, "start": 15.64, "end": 17.96, "kind": "direction", "speaker": null, "text": "Dragon Soul"}, {"i": 5, "start": 18.68, "end": 19.54, "kind": "dialog", "speaker": "Krillin", "text": "Go to Namek!"}, {"i": 6, "start": 19.54, "end": 20.6, "kind": "dialog", "speaker": "Gohan", "text": "Is that Namek?"}, {"i": 7, "start": 20.6, "end": 21.2, "kind": "dialog", "speaker": "Krillin", "text": "No!"}, {"i": 8, "start": 21.2, "end": 22.14, "kind": "dialog", "speaker": "Gohan", "text": "Is that Namek?"}, {"i": 9, "start": 22.14, "end": 22.72, "kind": "dialog", "speaker": "Krillin", "text": "No!!"}, {"i": 10, "start": 22.72, "end": 24.02, "kind": "dialog", "speaker": "Gohan", "text": "Is THAT Namek?"}, {"i": 11, "start": 24.02, "end": 24.98, "kind": "dialog", "speaker": "Krillin", "text": "BOOYAH!!!"}, {"i": 12, "start": 25.08, "end": 26.32, "kind": "dialog", "speaker": "Krillin", "text": "This place is boring!"}, {"i": 13, "start": 26.48, "end": 27.48, "kind": "dialog", "speaker": "Gohan", "text": "Is that a Saiyan pod?"}, {"i": 14, "start": 27.48, "end": 29.22, "kind": "dialog", "speaker": "Krillin", "text": "WE'RE ALL GONNA DIEEEEEEEEEEEEE"}, {"i": 15, "start": 29.22, "end": 30.18, "kind": "dialog", "speaker": "Krillin", "text": "EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE [Vegeta] I'm on Namek now."}, {"i": 16, "start": 30.18, "end": 30.92, "kind": "dialog", "speaker": "Cui", "text": "Hey Vegeta!"}, {"i": 17, "start": 30.92, "end": 31.42, "kind": "dialog", "speaker": "Vegeta", "text": "Hi Cui."}, {"i": 18, "start": 32.06, "end": 32.62, "kind": "dialog", "speaker": "Vegeta", "text": "Bye Cui."}, {"i": 19, "start": 32.92, "end": 34.58, "kind": "dialog", "speaker": "Freeza", "text": "Hello, I'm Space Napol-Hitler"}, {"i": 20, "start": 34.58, "end": 35.14, "kind": "dialog", "speaker": "Freeza", "text": "Give me the thing."}, {"i": 21, "start": 35.14, "end": 35.66, "kind": "dialog", "speaker": "Namekian", "text": "No!"}, {"i": 22, "start": 35.66, "end": 36.22, "kind": "dialog", "speaker": "Freeza", "text": "Give me the thing"}, {"i": 23, "start": 36.22, "end": 36.76, "kind": "dialog", "speaker": "Namekian", "text": "No!"}, {"i": 24, "start": 36.76, "end": 37.36, "kind": "dialog", "speaker": "Freeza", "text": "Kill his kid."}, {"i": 25, "start": 37.96, "end": 38.6, "kind": "direction", "speaker": null, "text": "Wilhelm scream"}, {"i": 26, "start": 38.6, "end": 39.36, "kind": "dialog", "speaker": "Freeza", "text": "Give me the thing."}, {"i": 27, "start": 39.36, "end": 39.98, "kind": "dialog", "speaker": "Namekian", "text": "Here!"}, {"i": 28, "start": 39.98, "end": 40.48, "kind": "dialog", "speaker": "Freeza", "text": "Good!"}, {"i": 29, "start": 40.48, "end": 40.98, "kind": "dialog", "speaker": "Freeza", "text": "Kill him!"}, {"i": 30, "start": 40.98, "end": 41.54, "kind": "dialog", "speaker": "Namekian", "text": "But the thing!"}, {"i": 31, "start": 42.78, "end": 43.34, "kind": "dialog", "speaker": "Freeza", "text": "Other kid!"}, {"i": 32, "start": 43.34, "end": 43.92, "kind": "dialog", "speaker": "Gohan", "text": "No!"}, {"i": 33, "start": 44.46, "end": 45.06, "kind": "dialog", "speaker": "Krillin", "text": "Quack!"}, {"i": 34, "start": 45.86, "end": 46.9, "kind": "dialog", "speaker": "Freeza", "text": "What the space fu-"}, {"i": 35, "start": 46.9, "end": 47.72, "kind": "dialog", "speaker": "Krillin", "text": "Think we're in the clear!"}, {"i": 36, "start": 47.72, "end": 48.96, "kind": "sfx", "speaker": null, "text": "Dodoria screaming"}, {"i": 37, "start": 48.96, "end": 50.0, "kind": "dialog", "speaker": "Krillin", "text": "WE'RE ALL GONNA DIE!!!"}, {"i": 38, "start": 50.0, "end": 51.24, "kind": "dialog", "speaker": "Gohan", "text": "Use your Solar Flare!"}, {"i": 39, "start": 51.24, "end": 51.94, "kind": "dialog", "speaker": "Krillin", "text": "Oh, I do know tha-"}, {"i": 40, "start": 51.94, "end": 52.44, "kind": "dialog", "speaker": "Krillin", "text": "Sol"}, {"i": 41, "start": 52.44, "end": 52.94, "kind": "dialog", "speaker": "Krillin", "text": "Sol Flah!!!"}, {"i": 42, "start": 53.38, "end": 54.16, "kind": "dialog", "speaker": "Dodoria", "text": "AH! Bitch!"}, {"i": 43, "start": 54.16, "end": 55.3, "kind": "dialog", "speaker": "Dodoria", "text": "AH! Double bitch!"}, {"i": 44, "start": 55.8, "end": 56.76, "kind": "dialog", "speaker": "Vegeta", "text": "'Sup Chubs McKenzie?"}, {"i": 45, "start": 56.76, "end": 58.28, "kind": "dialog", "speaker": "Vegeta", "text": "Any last words before I kill you ?"}, {"i": 46, "start": 58.68, "end": 61.3, "kind": "dialog", "speaker": "Dodoria", "text": "I have a thick..."}, {"i": 47, "start": 61.3, "end": 63.24, "kind": "dialog", "speaker": "Dodoria", "text": "I have a thick... meaty..."}, {"i": 48, "start": 63.24, "end": 65.02, "kind": "dialog", "speaker": "Dodoria", "text": "...vagina."}, {"i": 49, "start": 65.02, "end": 66.4, "kind": "direction", "speaker": null, "text": "shocked silence"}, {"i": 50, "start": 68.78, "end": 71.02, "kind": "direction", "speaker": null, "text": "retching noises"}, {"i": 51, "start": 71.02, "end": 72.0, "kind": "dialog", "speaker": "Gohan", "text": "We're alive!"}, {"i": 52, "start": 72.0, "end": 72.86, "kind": "dialog", "speaker": "Krillin", "text": "But they have the thing!"}, {"i": 53, "start": 72.86, "end": 73.7, "kind": "dialog", "speaker": "Gohan", "text": "We have a thing"}, {"i": 54, "start": 73.7, "end": 74.52, "kind": "dialog", "speaker": "Dende", "text": "My name is-"}, {"i": 55, "start": 74.52, "end": 75.26, "kind": "dialog", "speaker": "Krillin", "text": "Little Green!"}, {"i": 56, "start": 75.26, "end": 76.36, "kind": "direction", "speaker": null, "text": "The Heavy - \"Short Change Hero\""}, {"i": 57, "start": 76.36, "end": 78.06, "kind": "dialog", "speaker": "Dende", "text": "My parents are dead!"}, {"i": 58, "start": 78.06, "end": 79.54, "kind": "dialog", "speaker": "Dende", "text": "[1st form Frieza] Dodoria's dead?!?"}, {"i": 59, "start": 79.54, "end": 80.18, "kind": "dialog", "speaker": "Zarbon", "text": "Mmm."}, {"i": 60, "start": 80.18, "end": 81.34, "kind": "dialog", "speaker": "Zarbon", "text": "[1st form Frieza] Vegeta? Get him!"}, {"i": 61, "start": 81.34, "end": 82.16, "kind": "dialog", "speaker": "Zarbon", "text": "Mmm!"}, {"i": 62, "start": 82.4, "end": 83.32, "kind": "dialog", "speaker": "Krillin", "text": "We're stayin' here!"}, {"i": 63, "start": 83.32, "end": 84.84, "kind": "dialog", "speaker": "Krillin", "text": "Gohan, look after Little Green!"}, {"i": 64, "start": 84.84, "end": 85.42, "kind": "dialog", "speaker": "Dende", "text": "Hey."}, {"i": 65, "start": 85.42, "end": 86.0, "kind": "dialog", "speaker": "Krillin", "text": "Bulma!"}, {"i": 66, "start": 86.56, "end": 88.44, "kind": "dialog", "speaker": "Krillin", "text": "Do not do ANYTHING."}, {"i": 67, "start": 88.92, "end": 90.2, "kind": "dialog", "speaker": "Krillin", "text": "For this entire trip."}, {"i": 68, "start": 91.48, "end": 92.02, "kind": "dialog", "speaker": "Krillin", "text": "Good!"}, {"i": 69, "start": 92.32, "end": 93.0, "kind": "dialog", "speaker": "Vegeta", "text": "Found me a thing!"}, {"i": 70, "start": 93.56, "end": 94.6, "kind": "dialog", "speaker": "Vegeta", "text": "Time to get more things!"}, {"i": 71, "start": 95.88, "end": 96.98, "kind": "dialog", "speaker": "Vegeta", "text": "Hey, it's the gay one."}, {"i": 72, "start": 97.02, "end": 99.78, "kind": "dialog", "speaker": "Zarbon", "text": "Maybe I'm gay. Or maybe stereotypes are bullshit!"}, {"i": 73, "start": 99.78, "end": 100.42, "kind": "dialog", "speaker": "Zarbon", "text": "Mmm.."}, {"i": 74, "start": 100.78, "end": 101.44, "kind": "dialog", "speaker": "Zarbon", "text": "[Post-Transformation Zarbon] PUSSY!"}, {"i": 75, "start": 101.44, "end": 102.16, "kind": "dialog", "speaker": "Vegeta", "text": "OH NO!!"}, {"i": 76, "start": 104.04, "end": 104.82, "kind": "dialog", "speaker": "Krillin", "text": "So who are you?"}, {"i": 77, "start": 104.82, "end": 106.04, "kind": "dialog", "speaker": "Guru", "text": "I am Guru."}, {"i": 78, "start": 106.04, "end": 106.9, "kind": "dialog", "speaker": "Krillin", "text": "Oh okay well.."}, {"i": 79, "start": 106.9, "end": 109.98, "kind": "dialog", "speaker": "Guru", "text": "But you can call me super mega ultra alpha omega hyper..."}, {"i": 80, "start": 109.98, "end": 111.72, "kind": "dialog", "speaker": "Nail", "text": "Just take the thing. He'll be at this for a while."}, {"i": 81, "start": 111.72, "end": 112.34, "kind": "dialog", "speaker": "Krillin", "text": "WOOHOO!!"}, {"i": 82, "start": 114.86, "end": 115.6, "kind": "dialog", "speaker": "Zarbon", "text": "Mmm."}, {"i": 83, "start": 117.28, "end": 118.7, "kind": "dialog", "speaker": "Vegeta", "text": "GRAB ALL THE THINGS!!!"}, {"i": 84, "start": 118.7, "end": 120.7, "kind": "dialog", "speaker": "Vegeta", "text": "HAHAHAHAHAHAHAHAHAHAHAHAHAHA!!!!"}, {"i": 85, "start": 120.86, "end": 121.7, "kind": "dialog", "speaker": "Krillin", "text": "I got a thing!"}, {"i": 86, "start": 121.7, "end": 122.32, "kind": "dialog", "speaker": "Krillin", "text": "Where's Gohan?"}, {"i": 87, "start": 122.32, "end": 123.14, "kind": "dialog", "speaker": "Vegeta", "text": "HAHAHAHAHA-"}, {"i": 88, "start": 123.14, "end": 123.78, "kind": "dialog", "speaker": "Krillin", "text": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA-"}, {"i": 89, "start": 123.78, "end": 124.5, "kind": "dialog", "speaker": "Vegeta", "text": "HAHAHAHAHAHAHAHHAHAHAHAHAHAHAHAHAHAH [Zarbon] Mmm."}, {"i": 90, "start": 124.5, "end": 125.0, "kind": "dialog", "speaker": "Vegeta", "text": "HAHAHAHAHHHAHAHAHAHAHA"}, {"i": 91, "start": 125.0, "end": 125.6, "kind": "dialog", "speaker": "Post-Transformed Zarbon", "text": "MMMM!"}, {"i": 92, "start": 125.6, "end": 127.96, "kind": "dialog", "speaker": "Vegeta", "text": "HAHAH HAHAHAHAHAHAHAHAHAH"}, {"i": 93, "start": 127.96, "end": 129.12, "kind": "direction", "speaker": null, "text": "Vegeta] *HAHAHAHAHAHAHAHAHAHA"}, {"i": 94, "start": 129.12, "end": 129.62, "kind": "dialog", "speaker": "Krillin", "text": "AAAaaaah-"}, {"i": 95, "start": 129.62, "end": 130.9, "kind": "dialog", "speaker": "Krillin", "text": "... no, seriously, where's Gohan?"}, {"i": 96, "start": 130.9, "end": 131.68, "kind": "dialog", "speaker": "Gohan", "text": "Oh, hi Vegeta-"}, {"i": 97, "start": 132.2, "end": 134.32, "kind": "dialog", "speaker": "Vegeta", "text": "HAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHA"}, {"i": 98, "start": 134.32, "end": 135.2, "kind": "dialog", "speaker": "Gohan", "text": "Still got his thing."}, {"i": 99, "start": 135.2, "end": 136.74, "kind": "dialog", "speaker": "Vegeta", "text": "HAHAHAHAHAHAHAHAHHAHAHAHA-"}, {"i": 100, "start": 139.28, "end": 142.56, "kind": "dialog", "speaker": "Vegeta", "text": "FUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUU-"}, {"i": 101, "start": 144.52, "end": 146.54, "kind": "dialog", "speaker": "Vegeta", "text": "-uuuuuUUUUUUUUUUUUU-"}, {"i": 102, "start": 146.54, "end": 147.64, "kind": "dialog", "speaker": "Freeza", "text": "Zarbon's dead?!?"}, {"i": 103, "start": 147.64, "end": 148.58, "kind": "dialog", "speaker": "Underling", "text": "Zarbon's dead."}, {"i": 104, "start": 148.58, "end": 149.28, "kind": "dialog", "speaker": "Freeza", "text": "F*CK!"}, {"i": 105, "start": 149.28, "end": 150.14, "kind": "dialog", "speaker": "Freeza", "text": "Call the Ginyus!"}, {"i": 106, "start": 150.14, "end": 150.66, "kind": "dialog", "speaker": "Underling", "text": "'Kay."}, {"i": 107, "start": 151.24, "end": 153.12, "kind": "dialog", "speaker": "Freeza", "text": "Seriously, though, what IS today?"}, {"i": 108, "start": 153.54, "end": 155.78, "kind": "dialog", "speaker": "Guru", "text": "...Bigger, longer and uncut Guru."}, {"i": 109, "start": 156.2, "end": 157.16, "kind": "dialog", "speaker": "Guru", "text": "Oh, hello!"}, {"i": 110, "start": 157.16, "end": 158.1, "kind": "dialog", "speaker": "Kid Gohan", "text": "Why am I here?"}, {"i": 111, "start": 158.1, "end": 159.26, "kind": "dialog", "speaker": "Dende", "text": "Why am *I* here!?"}, {"i": 112, "start": 159.26, "end": 159.8, "kind": "dialog", "speaker": "Guru", "text": "Power up!"}, {"i": 113, "start": 160.56, "end": 161.7, "kind": "dialog", "speaker": "Kid Gohan", "text": "Will this actually matter?"}, {"i": 114, "start": 161.7, "end": 162.42, "kind": "dialog", "speaker": "Grand Elder Guru", "text": "Probably not."}, {"i": 115, "start": 162.42, "end": 163.14, "kind": "dialog", "speaker": "Vegeta", "text": "HEY GUYS!!"}, {"i": 116, "start": 163.14, "end": 165.22, "kind": "dialog", "speaker": "Vegeta", "text": "YOU REMIND ME OF SOME ASSHOLES I'M GONNA KILL!"}, {"i": 117, "start": 165.22, "end": 165.84, "kind": "dialog", "speaker": "Krillin", "text": "aaaaaAAAAA-"}, {"i": 118, "start": 165.84, "end": 166.68, "kind": "dialog", "speaker": "Vegeta", "text": "BUT THERE'S NOT TIME FOR THAT..."}, {"i": 119, "start": 166.68, "end": 167.94, "kind": "dialog", "speaker": "Vegeta", "text": "BECAUSE THE GINYUS ARE COMING!!"}, {"i": 120, "start": 167.94, "end": 168.44, "kind": "dialog", "speaker": "Krillin", "text": "Okay what-"}, {"i": 121, "start": 168.44, "end": 169.34, "kind": "dialog", "speaker": "Vegeta", "text": "RRRRIGHT NOW!!"}, {"i": 122, "start": 169.34, "end": 169.84, "kind": "dialog", "speaker": "Vegeta", "text": "Ginyu!"}, {"i": 123, "start": 169.84, "end": 170.34, "kind": "dialog", "speaker": "Vegeta", "text": "Jeice!"}, {"i": 124, "start": 170.34, "end": 170.84, "kind": "dialog", "speaker": "Vegeta", "text": "Burter!"}, {"i": 125, "start": 170.84, "end": 171.34, "kind": "dialog", "speaker": "Vegeta", "text": "Guldo!"}, {"i": 126, "start": 171.34, "end": 171.84, "kind": "dialog", "speaker": "Vegeta", "text": "Recoome!"}, {"i": 127, "start": 171.84, "end": 172.64, "kind": "dialog", "speaker": "Captain Ginyu", "text": "And together we are..."}, {"i": 128, "start": 172.64, "end": 173.54, "kind": "dialog", "speaker": "Captain Ginyu", "text": "The Ginyu F-"}, {"i": 129, "start": 174.58, "end": 176.06, "kind": "dialog", "speaker": "Captain Ginyu", "text": "ᴴᵉʸ ᵍᵘʸˢ ᶦ ᵐᵃᵈᵉ ᶦᵗ"}, {"i": 130, "start": 176.06, "end": 177.38, "kind": "dialog", "speaker": "Krillin", "text": "Goku's ship killed the Ginyus!"}, {"i": 131, "start": 177.38, "end": 179.02, "kind": "dialog", "speaker": "Krillin", "text": "...and he's out of commission, what are the odds?"}, {"i": 132, "start": 179.02, "end": 180.0, "kind": "dialog", "speaker": "Vegeta", "text": "Put him in..."}, {"i": 133, "start": 180.0, "end": 181.26, "kind": "dialog", "speaker": "Vegeta", "text": "Put him in... the Pod!"}, {"i": 134, "start": 181.26, "end": 182.26, "kind": "sfx", "speaker": null, "text": "Dramatic music sting"}, {"i": 135, "start": 182.9, "end": 184.86, "kind": "dialog", "speaker": "Goku", "text": "...I wonder if this'll become a trend?"}, {"i": 136, "start": 184.86, "end": 185.82, "kind": "dialog", "speaker": "Krillin", "text": "Where's Freeza?"}, {"i": 137, "start": 186.18, "end": 187.94, "kind": "sfx", "speaker": null, "text": "Nail screaming"}, {"i": 138, "start": 187.94, "end": 189.52, "kind": "dialog", "speaker": "Krillin", "text": "TEAM THREE STAR!!"}, {"i": 139, "start": 189.52, "end": 191.6, "kind": "dialog", "speaker": "Vegeta", "text": "That's not funny! It's never been funny!"}, {"i": 140, "start": 191.6, "end": 192.74, "kind": "dialog", "speaker": "Vegeta", "text": "It's never gonna be funny!!"}, {"i": 141, "start": 192.74, "end": 194.62, "kind": "dialog", "speaker": "Vegeta", "text": "Put on these clothes, Imma nap."}, {"i": 142, "start": 194.62, "end": 196.4, "kind": "dialog", "speaker": "Krillin", "text": "Hey Gohan, I found the things! Wanna do the thing?"}, {"i": 143, "start": 196.4, "end": 198.04, "kind": "dialog", "speaker": "Gohan", "text": "Sure, but when did Dende get here?"}, {"i": 144, "start": 198.04, "end": 198.7, "kind": "dialog", "speaker": "Dende", "text": "Hey."}, {"i": 145, "start": 200.14, "end": 201.06, "kind": "dialog", "speaker": "Gohan", "text": "So what are we-"}, {"i": 146, "start": 201.06, "end": 202.06, "kind": "dialog", "speaker": "Krillin", "text": "Bring Piccolo back!"}, {"i": 147, "start": 202.06, "end": 202.7, "kind": "dialog", "speaker": "Piccolo", "text": "YEAH!"}, {"i": 148, "start": 202.7, "end": 203.64, "kind": "dialog", "speaker": "Krillin", "text": "Now bring him to Namek!"}, {"i": 149, "start": 203.64, "end": 204.16, "kind": "dialog", "speaker": "Piccolo", "text": "NOOO-"}, {"i": 150, "start": 204.66, "end": 205.42, "kind": "dialog", "speaker": "Piccolo", "text": "-OOOOO!!"}, {"i": 151, "start": 205.42, "end": 206.14, "kind": "dialog", "speaker": "Nail", "text": "Oh, hi."}, {"i": 152, "start": 206.14, "end": 206.76, "kind": "dialog", "speaker": "Piccolo", "text": "'Sup?"}, {"i": 153, "start": 206.76, "end": 207.9, "kind": "dialog", "speaker": "Nail", "text": "Wanna see something cool?"}, {"i": 154, "start": 207.9, "end": 208.62, "kind": "dialog", "speaker": "Piccolo", "text": "Eh, why not?"}, {"i": 155, "start": 208.62, "end": 209.36, "kind": "dialog", "speaker": "Piccolo", "text": "UUUUUUUUU-"}, {"i": 156, "start": 209.36, "end": 210.24, "kind": "dialog", "speaker": "Krillin", "text": "And for our last wish-"}, {"i": 157, "start": 210.24, "end": 213.1, "kind": "dialog", "speaker": "Vegeta", "text": "YOU'LL GIVE ME INMORTALITY OR I MURDER HIS PARENTS!!"}, {"i": 158, "start": 213.1, "end": 214.02, "kind": "dialog", "speaker": "Dende", "text": "Joke's on you."}, {"i": 159, "start": 219.5, "end": 220.44, "kind": "dialog", "speaker": "Vegeta", "text": "Wait, am I immortal?"}, {"i": 160, "start": 220.44, "end": 221.1, "kind": "dialog", "speaker": "Freeza", "text": "I don't know..."}, {"i": 161, "start": 221.1, "end": 222.14, "kind": "dialog", "speaker": "Freeza", "text": "Let's see!"}, {"i": 162, "start": 222.14, "end": 223.66, "kind": "dialog", "speaker": "Krillin", "text": "Hu hu hu, He's pissed!"}, {"i": 163, "start": 223.66, "end": 225.26, "kind": "dialog", "speaker": "Vegeta", "text": "Hah! I'm not afraid of you!"}, {"i": 164, "start": 225.26, "end": 226.1, "kind": "sfx", "speaker": null, "text": "Super Mario power-up sound effect"}, {"i": 165, "start": 226.1, "end": 227.58, "kind": "dialog", "speaker": "Freeza", "text": "How about now?"}, {"i": 166, "start": 227.58, "end": 228.34, "kind": "dialog", "speaker": "Krillin", "text": "HAH! Horny."}, {"i": 167, "start": 229.22, "end": 230.76, "kind": "sfx", "speaker": null, "text": "Super Mario \"star power\" sound effect"}, {"i": 168, "start": 231.66, "end": 232.78, "kind": "dialog", "speaker": "Freeza", "text": "Alright who's nex-"}, {"i": 169, "start": 233.8, "end": 235.2, "kind": "dialog", "speaker": "Piccolo", "text": "I'm two guys now."}, {"i": 170, "start": 235.2, "end": 235.82, "kind": "dialog", "speaker": "Nail", "text": "'Sup?"}, {"i": 171, "start": 235.82, "end": 236.78, "kind": "dialog", "speaker": "Gohan", "text": "Krillin! Nooooo!"}, {"i": 172, "start": 236.78, "end": 237.6, "kind": "dialog", "speaker": "Krillin", "text": "I'm okay!"}, {"i": 173, "start": 237.6, "end": 238.64, "kind": "dialog", "speaker": "Gohan", "text": "What? How?"}, {"i": 174, "start": 239.1, "end": 239.6, "kind": "dialog", "speaker": "Dende", "text": "Hey."}, {"i": 175, "start": 240.9, "end": 243.22, "kind": "dialog", "speaker": "Freeza", "text": "And this is my fourth and final form!"}, {"i": 176, "start": 243.22, "end": 244.42, "kind": "dialog", "speaker": "Krillin", "text": "What happened to the third form?"}, {"i": 177, "start": 244.42, "end": 246.96, "kind": "dialog", "speaker": "Vegeta", "text": "I don