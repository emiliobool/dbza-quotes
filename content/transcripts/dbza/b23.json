{"item":"b23","show":"dbza","youtube":"zaubG06FZ1Q","title":"Who Ya Gonna Call?","duration":49,"lines":[{"i":0,"start":1.12,"end":3.0,"kind":"dialog","speaker":"Gotenks","text":"Super Ghost Kamikaze Attack!"},{"i":1,"start":2.5,"end":3.84,"kind":"dialog","speaker":"Gotenks","text":"Whoa!"},{"i":2,"start":17.5,"end":18.24,"kind":"dialog","speaker":null,"text":"Hey!"},{"i":3,"start":20.58,"end":21.22,"kind":"dialog","speaker":null,"text":"Woo!"},{"i":4,"start":22.76,"end":23.46,"kind":"dialog","speaker":null,"text":"Hey!"},{"i":5,"start":23.9,"end":25.48,"kind":"dialog","speaker":"Gotenks","text":"Wait, Uncle Nappa?"},{"i":6,"start":25.76,"end":27.48,"kind":"dialog","speaker":"Nappa","text":"Hey, kids! How's it hanging?"},{"i":7,"start":27.78,"end":29.26,"kind":"dialog","speaker":"Gotenks","text":"What are you doing here?"},{"i":8,"start":29.0,"end":33.88,"kind":"dialog","speaker":"Nappa","text":"Ah, yeah, so I was having a stroke in my trailer, and it did not end well."},{"i":9,"start":32.96,"end":35.94,"kind":"dialog","speaker":"Gotenks","text":"Our condolences?"},{"i":10,"start":36.14,"end":37.56,"kind":"dialog","speaker":"Nappa","text":"Eh, it's my fault."},{"i":11,"start":37.4,"end":40.0,"kind":"dialog","speaker":"Nappa","text":"Shouldn't have made that extra notch in the belt."},{"i":12,"start":39.86,"end":41.14,"kind":"dialog","speaker":"Gotenks","text":"I don't get it."},{"i":13,"start":40.34,"end":42.76,"kind":"dialog","speaker":"Nappa","text":"Ask Trunks' dad."},{"i":14,"start":41.84,"end":43.82,"kind":"dialog","speaker":"Gotenks","text":"But he's dead."},{"i":15,"start":44.78,"end":46.0,"kind":"dialog","speaker":"Nappa","text":"Fuck am I doing here?"},{"i":16,"start":45.84,"end":47.82,"kind":"dialog","speaker":"Vegeta","text":"Oh no."},{"i":17,"start":47.8,"end":49.0,"kind":"dialog","speaker":"Nappa","text":"VEGETA!"}],"segments":[]}
