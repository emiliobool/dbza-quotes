{"item": "cv03", "show": "dbza", "youtube": "5XJKbvEPuFQ", "title": "Cell Vs Ryu & Ken", "duration": 135, "lines": [{"i": 0, "start": 6.0, "end": 6.98, "kind": "dialog", "speaker": "Cell", "text": "Hm."}, {"i": 1, "start": 6.98, "end": 8.36, "kind": "dialog", "speaker": "Cell", "text": "I feel different."}, {"i": 2, "start": 8.36, "end": 9.3, "kind": "dialog", "speaker": "Ken", "text": "Hey, ugly!"}, {"i": 3, "start": 11.62, "end": 12.36, "kind": "dialog", "speaker": "Ken", "text": "Hey!"}, {"i": 4, "start": 12.36, "end": 14.14, "kind": "dialog", "speaker": "Ken", "text": "I'm talkin' to you!"}, {"i": 5, "start": 14.14, "end": 19.7, "kind": "dialog", "speaker": "Cell", "text": "Me? I'm sorry, I heard \"ugly\" and assumed you MUST be talking to someone else."}, {"i": 6, "start": 20.14, "end": 22.64, "kind": "dialog", "speaker": "Ryu", "text": "Beauty, is in the fight of the beholder."}, {"i": 7, "start": 22.64, "end": 25.38, "kind": "dialog", "speaker": "Ken", "text": "Name's Ken Masters, and this is Ryu."}, {"i": 8, "start": 25.38, "end": 30.4, "kind": "dialog", "speaker": "Ken", "text": "You're the six and a half-foot tall pain in our butts who's threatening to destroy the world, aren't you?"}, {"i": 9, "start": 30.4, "end": 32.0, "kind": "dialog", "speaker": "Cell", "text": "6' 8'', actually."}, {"i": 10, "start": 32.0, "end": 36.14, "kind": "dialog", "speaker": "Cell", "text": "By your get-ups, I'm assuming you're here to challenge me."}, {"i": 11, "start": 36.14, "end": 39.0, "kind": "dialog", "speaker": "Ryu", "text": "The truth lies in the heart of battle."}, {"i": 12, "start": 39.6, "end": 42.44, "kind": "dialog", "speaker": "Ken", "text": "Eh, d-don't pay attention to that; it's just how he communicates."}, {"i": 13, "start": 42.44, "end": 47.2, "kind": "dialog", "speaker": "Ryu", "text": "The only way warriors can TRULY communicate is with our fists!"}, {"i": 14, "start": 47.2, "end": 48.5, "kind": "dialog", "speaker": "Cell", "text": "What about our..."}, {"i": 15, "start": 48.5, "end": 50.1, "kind": "dialog", "speaker": "Cell", "text": "MOUTHS? ( ͡° ͜ʖ ͡°)"}, {"i": 16, "start": 50.1, "end": 55.42, "kind": "dialog", "speaker": "Ken", "text": "Stand back, Ryu... I'm gonna take the first and ONLY round."}, {"i": 17, "start": 55.42, "end": 58.66, "kind": "dialog", "speaker": "Cell", "text": "Ho-oh boy, excellent! Then let us begin!"}, {"i": 18, "start": 61.34, "end": 63.18, "kind": "dialog", "speaker": "Ken", "text": "Shippu Jinraikyaku!"}, {"i": 19, "start": 67.66, "end": 69.2, "kind": "dialog", "speaker": "Ken", "text": "...uh, hey Ryu? Uh, you wanna--"}, {"i": 20, "start": 69.2, "end": 69.76, "kind": "dialog", "speaker": "Cell", "text": "Shoryuken!"}, {"i": 21, "start": 69.76, "end": 70.28, "kind": "dialog", "speaker": "Ken", "text": "AAAAGH--!! [LOL]"}, {"i": 22, "start": 70.28, "end": 70.78, "kind": "dialog", "speaker": "Ken", "text": "{TING}"}, {"i": 23, "start": 71.84, "end": 73.48, "kind": "dialog", "speaker": "Ryu", "text": "Ken, no!"}, {"i": 24, "start": 73.48, "end": 74.96, "kind": "direction", "speaker": null, "text": "LOLWUT?"}, {"i": 25, "start": 74.96, "end": 78.28, "kind": "dialog", "speaker": "Ryu", "text": "The... the Dark Hado! It's coming out!"}, {"i": 26, "start": 78.28, "end": 80.52, "kind": "dialog", "speaker": "Ryu", "text": "I... can't... control it!"}, {"i": 27, "start": 80.52, "end": 83.06, "kind": "dialog", "speaker": "Ryu", "text": "It's going to... overtake me!"}, {"i": 28, "start": 84.42, "end": 86.38, "kind": "dialog", "speaker": "Cell", "text": "...Have you tried praying it away?"}, {"i": 29, "start": 86.38, "end": 90.42, "kind": "dialog", "speaker": "Ryu", "text": "Consciousness... losing... consciousness..."}, {"i": 30, "start": 90.42, "end": 92.06, "kind": "dialog", "speaker": "Ryu", "text": "Fading into..."}, {"i": 31, "start": 92.06, "end": 93.86, "kind": "dialog", "speaker": "Ryu", "text": "darkness..."}, {"i": 32, "start": 94.7, "end": 96.74, "kind": "dialog", "speaker": "Cell", "text": "Well, at least someone finally threw a punch..."}, {"i": 33, "start": 98.38, "end": 99.24, "kind": "dialog", "speaker": "Cell", "text": "...!"}, {"i": 34, "start": 99.82, "end": 100.5, "kind": "dialog", "speaker": "Ryu", "text": "EEEEEEGH!"}, {"i": 35, "start": 100.5, "end": 102.54, "kind": "dialog", "speaker": "Ryu", "text": "EEEEEEGH! CELL: AAAAAAGH!"}, {"i": 36, "start": 107.88, "end": 109.32, "kind": "dialog", "speaker": "Cell", "text": "...WHAT JUST HAPPENED?!"}, {"i": 37, "start": 110.36, "end": 111.48, "kind": "dialog", "speaker": "Ken", "text": "AAAAAH-HOO-HOO-HOO--!"}], "segments": []}