 "lines": [
  {
   "i": 0,
   "start": 7.84,
   "end": 10.22,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Alright, Gohan... keep your power level down."
  },
  {
   "i": 1,
   "start": 10.46,
   "end": 14.34,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "I’m trying, but I can’t seem to get it as low as yours, Krillin."
  },
  {
   "i": 2,
   "start": 14.34,
   "end": 16.74,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "But I haven’t ev-- I mean, yeah!"
  },
  {
   "i": 3,
   "start": 17.3,
   "end": 18.26,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Like me!"
  },
  {
   "i": 4,
   "start": 18.26,
   "end": 20.92,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "Hey, Krillin, look! The Dragon Balls!"
  },
  {
   "i": 5,
   "start": 21.16,
   "end": 24.92,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "*Whoa*, those things are *huge*! AC/DC be *damned*!"
  },
  {
   "i": 6,
   "start": 25.76,
   "end": 28.18,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Jeez... these aliens are scary."
  },
  {
   "i": 7,
   "start": 27.18,
   "end": 27.68,
   "kind": "dialog",
   "speaker": "Dodoria",
   "text": "Heh."
  },
  {
   "i": 8,
   "start": 28.8,
   "end": 30.28,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Especially that one in the front."
  },
  {
   "i": 9,
   "start": 29.58,
   "end": 30.28,
   "kind": "dialog",
   "speaker": "Freeza",
   "text": "He-heh, heh."
  },
  {
   "i": 10,
   "start": 30.62,
   "end": 32.02,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Looks like a total FAG."
  },
  {
   "i": 11,
   "start": 32.02,
   "end": 32.7,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "Krillin!"
  },
  {
   "i": 12,
   "start": 32.96,
   "end": 35.4,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "What? A \"Freaky Alien Genotype\"."
  },
  {
   "i": 13,
   "start": 35.9,
   "end": 36.9,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "What’d you think I meant?"
  },
  {
   "i": 14,
   "start": 37.08,
   "end": 40.62,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "Oh. I thought you were calling him a derogatory term for a homosexual."
  },
  {
   "i": 15,
   "start": 40.62,
   "end": 41.76,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "THAT THING’S A GUY?!"
  },
  {
   "i": 16,
   "start": 41.76,
   "end": 43.62,
   "kind": "direction",
   "speaker": null,
   "text": "♫ \"Cha-La Head-Cha-La\" ♫"
  },
  {
   "i": 17,
   "start": 43.62,
   "end": 46.38,
   "kind": "dialog",
   "speaker": null,
   "text": "♫ CHA-LA HEAD-CHA-LA ♫"
  },
  {
   "i": 18,
   "start": 47.14,
   "end": 50.78,
   "kind": "dialog",
   "speaker": null,
   "text": "♫ Egao urutora zetto de ♫ (With a smile that’s Ultra-Z)"
  },
  {
   "i": 19,
   "start": 50.78,
   "end": 54.1,
   "kind": "dialog",
   "speaker": null,
   "text": "♫ Kyô mo ai-yai-yai-yai-yai~ ♫ (Even today is ai-yai-yai-yai-yai~)"
  },
  {
   "i": 20,
   "start": 54.1,
   "end": 55.84,
   "kind": "dialog",
   "speaker": null,
   "text": "♫ Sparking! [fading echo] ♫"
  },
  {
   "i": 21,
   "start": 62.52,
   "end": 64.08,
   "kind": "dialog",
   "speaker": "Dodoria",
   "text": "Hmm? What was that?"
  },
  {
   "i": 22,
   "start": 64.08,
   "end": 65.46,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "Nnngh..."
  },
  {
   "i": 23,
   "start": 64.08,
   "end": 65.46,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Nnnuhhh...."
  },
  {
   "i": 24,
   "start": 65.8,
   "end": 66.44,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Quack!"
  },
  {
   "i": 25,
   "start": 67.0,
   "end": 69.0,
   "kind": "dialog",
   "speaker": "Dodoria",
   "text": "Oh, it’s just a space duck."
  },
  {
   "i": 26,
   "start": 69.36,
   "end": 70.64,
   "kind": "dialog",
   "speaker": "Mouri",
   "text": "Who are you?"
  },
  {
   "i": 27,
   "start": 70.82,
   "end": 73.42,
   "kind": "dialog",
   "speaker": "Freeza",
   "text": "Hello. Allow us to introduce ourselves."
  },
  {
   "i": 28,
   "start": 73.42,
   "end": 78.56,
   "kind": "dialog",
   "speaker": "Freeza",
   "text": "My name is Freeza, and we’re a traveling improv group. Here, let me give you a demonstration:"
  },
  {
   "i": 29,
   "start": 78.56,
   "end": 83.46,
   "kind": "dialog",
   "speaker": "Freeza",
   "text": "My men shall play a group of drunken sailors, and you’re a bunch of baby seals."
  },
  {
   "i": 30,
   "start": 83.64,
   "end": 84.46,
   "kind": "dialog",
   "speaker": "Freeza",
   "text": "Aaaand, go."
  },
  {
   "i": 31,
   "start": 84.62,
   "end": 85.24,
   "kind": "sfx",
   "speaker": null,
   "text": "POW"
  },
  {
   "i": 32,
   "start": 84.62,
   "end": 85.24,
   "kind": "dialog",
   "speaker": "Namekian 1",
   "text": "AGH!"
  },
  {
   "i": 33,
   "start": 85.64,
   "end": 86.42,
   "kind": "dialog",
   "speaker": "Namekian 2",
   "text": "GAAGH--guh!"
  },
  {
   "i": 34,
   "start": 86.58,
   "end": 87.68,
   "kind": "dialog",
   "speaker": "Freeza",
   "text": "Aaand, scene."
  },
  {
   "i": 35,
   "start": 88.04,
   "end": 88.62,
   "kind": "dialog",
   "speaker": "Mouri",
   "text": "Ugh..."
  },
  {
   "i": 36,
   "start": 88.04,
   "end": 89.62,
   "kind": "direction",
   "speaker": null,
   "text": "Young Namekians whimper"
  },
  {
   "i": 37,
   "start": 89.62,
   "end": 93.64,
   "kind": "dialog",
   "speaker": "Mouri",
   "text": "What do you want from us? Why are you slaughtering our people?"
  },
  {
   "i": 38,
   "start": 92.64,
   "end": 93.14,
   "kind": "dialog",
   "speaker": "Zarbon",
   "text": "Mmm!"
  },
  {
   "i": 39,
   "start": 93.7,
   "end": 101.16,
   "kind": "dialog",
   "speaker": "Freeza",
   "text": "Well, you see - I was just in the area, and I thought this would be a delightful place for a summer home-- what the f**k do you think I’m here for?!"
  },
  {
   "i": 40,
   "start": 102.08,
   "end": 103.34,
   "kind": "dialog",
   "speaker": "Mouri",
   "text": "...Our trees?"
  },
  {
   "i": 41,
   "start": 104.42,
   "end": 105.56,
   "kind": "dialog",
   "speaker": "Freeza",
   "text": "...Zarbon, two or three more."
  },
  {
   "i": 42,
   "start": 105.56,
   "end": 106.22,
   "kind": "dialog",
   "speaker": "Zarbon",
   "text": "Two or three more?"
  },
  {
   "i": 43,
   "start": 106.22,
   "end": 106.82,
   "kind": "dialog",
   "speaker": "Freeza",
   "text": "Two or three more."
  },
  {
   "i": 44,
   "start": 106.82,
   "end": 107.44,
   "kind": "sfx",
   "speaker": null,
   "text": "POW"
  },
  {
   "i": 45,
   "start": 106.82,
   "end": 107.44,
   "kind": "dialog",
   "speaker": "Namekian 3",
   "text": "GAH!"
  },
  {
   "i": 46,
   "start": 107.44,
   "end": 108.12,
   "kind": "dialog",
   "speaker": "Namekian 4",
   "text": "GAAUGH!"
  },
  {
   "i": 47,
   "start": 108.74,
   "end": 112.78,
   "kind": "dialog",
   "speaker": "Freeza",
   "text": "Very good, Zarbon! See? Why can’t you be more like him, Dodoria?"
  },
  {
   "i": 48,
   "start": 112.92,
   "end": 115.46,
   "kind": "dialog",
   "speaker": "Dodoria",
   "text": "Sorreh. Just listening to the space duck."
  },
  {
   "i": 49,
   "start": 115.82,
   "end": 117.44,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "QUACK! QUACK!"
  },
  {
   "i": 50,
   "start": 117.48,
   "end": 119.48,
   "kind": "dialog",
   "speaker": "Dodoria",
   "text": "What a majestic creature..."
  },
  {
   "i": 51,
   "start": 119.84,
   "end": 122.26,
   "kind": "dialog",
   "speaker": "Freeza",
   "text": "Now-h-how, then, all kidding aside…"
  },
  {
   "i": 52,
   "start": 122.62,
   "end": 124.3,
   "kind": "dialog",
   "speaker": "Freeza",
   "text": "Where’s the Dragon Ball?"
  },
  {
   "i": 53,
   "start": 124.52,
   "end": 125.68,
   "kind": "dialog",
   "speaker": "Mouri",
   "text": "We don’t have it."
  },
  {
   "i": 54,
   "start": 125.98,
   "end": 135.4,
   "kind": "dialog",
   "speaker": "Freeza",
   "text": "You know, I’d be inclined to believe you if the last village elder didn’t say the exact same thing… until we killed everyone and tortured the information out of him, of course."
  },
  {
   "i": 55,
   "start": 135.76,
   "end": 137.76,
   "kind": "direction",
   "speaker": null,
   "text": "Namekians grunt / whimper in fear"
  },
  {
   "i": 56,
   "start": 135.76,
   "end": 141.18,
   "kind": "dialog",
   "speaker": "Freeza",
   "text": "It’s the darndest thing, too… you’re beginning to remind me a lot of him..."
  },
  {
   "i": 57,
   "start": 141.78,
   "end": 143.88,
   "kind": "dialog",
   "speaker": "Mouri",
   "text": "Please... do not be upset."
  },
  {
   "i": 58,
   "start": 143.88,
   "end": 148.04,
   "kind": "dialog",
   "speaker": "Freeza",
   "text": "Ohhh, I don’t get upset. I have people to do that for me."
  },
  {
   "i": 59,
   "start": 148.04,
   "end": 148.78,
   "kind": "dialog",
   "speaker": "Freeza",
   "text": "Dodoria..."
  },
  {
   "i": 60,
   "start": 148.78,
   "end": 149.76,
   "kind": "dialog",
   "speaker": "Dodoria",
   "text": "With gusto."
  },
  {
   "i": 61,
   "start": 150.0,
   "end": 159.1,
   "kind": "direction",
   "speaker": null,
   "text": "Foreboding music; young Namekians whimper"
  },
  {
   "i": 62,
   "start": 159.1,
   "end": 163.04,
   "kind": "dialog",
   "speaker": "Mouri",
   "text": "(Grunting)"
  },
  {
   "i": 63,
   "start": 159.1,
   "end": 163.04,
   "kind": "direction",
   "speaker": null,
   "text": "Foreboding music"
  },
  {
   "i": 64,
   "start": 163.04,
   "end": 164.28,
   "kind": "direction",
   "speaker": null,
   "text": "Scouter beeps"
  },
  {
   "i": 65,
   "start": 164.28,
   "end": 165.24,
   "kind": "dialog",
   "speaker": "Namekian Warrior",
   "text": "Stop right there!"
  },
  {
   "i": 66,
   "start": 166.48,
   "end": 168.34,
   "kind": "direction",
   "speaker": null,
   "text": "Musical swell (heroic music)"
  },
  {
   "i": 67,
   "start": 169.82,
   "end": 172.52,
   "kind": "dialog",
   "speaker": "Freeza",
   "text": "Oh, look - more baby seals."
  },
  {
   "i": 68,
   "start": 172.78,
   "end": 173.5,
   "kind": "direction",
   "speaker": null,
   "text": "♫ ▶ ♫"
  },
  {
   "i": 69,
   "start": 172.78,
   "end": 175.94,
   "kind": "dialog",
   "speaker": "Namekian Warrior",
   "text": "We’re here to stop this senseless slaughter of our people."
  },
  {
   "i": 70,
   "start": 175.94,
   "end": 176.7,
   "kind": "direction",
   "speaker": null,
   "text": "♫ ⏸ ♫"
  },
  {
   "i": 71,
   "start": 175.94,
   "end": 177.26,
   "kind": "dialog",
   "speaker": "Freeza",
   "text": "Ninety two..."
  },
  {
   "i": 72,
   "start": 177.26,
   "end": 178.0,
   "kind": "direction",
   "speaker": null,
   "text": "♫ ▶ ♫"
  },
  {
   "i": 73,
   "start": 177.26,
   "end": 181.16,
   "kind": "dialog",
   "speaker": "Namekian Warrior",
   "text": "This has gone on for too long. And now, you’re going to pay."
  },
  {
   "i": 74,
   "start": 181.16,
   "end": 181.9,
   "kind": "direction",
   "speaker": null,
   "text": "♫ ⏸ ♫"
  },
  {
   "i": 75,
   "start": 181.16,
   "end": 182.7,
   "kind": "dialog",
   "speaker": "Freeza",
   "text": "Three hundred and fifty-five…"
  },
  {
   "i": 76,
   "start": 182.7,
   "end": 183.66,
   "kind": "direction",
   "speaker": null,
   "text": "♫ ▶ ♫"
  },
  {
   "i": 77,
   "start": 182.7,
   "end": 183.66,
   "kind": "dialog",
   "speaker": "Namekian Warrior",
   "text": "We are…"
  },
  {
   "i": 78,
   "start": 183.66,
   "end": 184.52,
   "kind": "dialog",
   "speaker": "Namekian Warrior",
   "text": "We…"
  },
  {
   "i": 79,
   "start": 184.52,
   "end": 185.18,
   "kind": "direction",
   "speaker": null,
   "text": "♫ ⏸ ♫"
  },
  {
   "i": 80,
   "start": 184.52,
   "end": 185.18,
   "kind": "dialog",
   "speaker": "Namekian Warrior",
   "text": "What are you--"
  },
  {
   "i": 81,
   "start": 185.18,
   "end": 187.18,
   "kind": "dialog",
   "speaker": "Freeza",
   "text": "No, go on, continue, don’t mind me."
  },
  {
   "i": 82,
   "start": 187.96,
   "end": 189.26,
   "kind": "dialog",
   "speaker": "Namekian Warrior",
   "text": "...Aaand…"
  },
  {
   "i": 83,
   "start": 188.46,
   "end": 189.26,
   "kind": "direction",
   "speaker": null,
   "text": "♫ ▶ ♫"
  },
  {
   "i": 84,
   "start": 189.26,
   "end": 191.1,
   "kind": "dialog",
   "speaker": "Namekian Warrior",
   "text": "We are the ones who will stop you!"
  },
  {
   "i": 85,
   "start": 191.1,
   "end": 191.9,
   "kind": "direction",
   "speaker": null,
   "text": "♫ ⏸ ♫"
  },
  {
   "i": 86,
   "start": 191.1,
   "end": 192.9,
   "kind": "dialog",
   "speaker": "Freeza",
   "text": "Ooh, wow, four hundred and nineteen."
  },
  {
   "i": 87,
   "start": 192.9,
   "end": 193.4,
   "kind": "direction",
   "speaker": null,
   "text": "♫ ▶ ♫"
  },
  {
   "i": 88,
   "start": 192.9,
   "end": 193.4,
   "kind": "dialog",
   "speaker": "Namekian Warrior",
   "text": "That--"
  },
  {
   "i": 89,
   "start": 193.4,
   "end": 194.2,
   "kind": "direction",
   "speaker": null,
   "text": "♫ ⏹ ♫ (Needle scratch)"
  },
  {
   "i": 90,
   "start": 193.4,
   "end": 195.26,
   "kind": "dialog",
   "speaker": "Namekian Warrior",
   "text": "What the Hell are you doing?!"
  },
  {
   "i": 91,
   "start": 195.26,
   "end": 197.7,
   "kind": "dialog",
   "speaker": "Freeza",
   "text": "Oh, sorry, it’s a little hobby of mine."
  },
  {
   "i": 92,
   "start": 197.7,
   "end": 205.3,
   "kind": "dialog",
   "speaker": "Freeza",
   "text": "I hear these heroic speeches so wearily often, so I started making a mental list of how many times I’ve heard certain lines."
  },
  {
   "i": 93,
   "start": 205.84,
   "end": 208.12,
   "kind": "dialog",
   "speaker": "Namekian Warrior",
   "text": "You… You insane bastard!"
  },
  {
   "i": 94,
   "start": 208.12,
   "end": 209.64,
   "kind": "dialog",
   "speaker": "Freeza",
   "text": "One hundred and ninety."
  },
  {
   "i": 95,
   "start": 209.9,
   "end": 216.26,
   "kind": "dialog",
   "speaker": "Namekian Warrior",
   "text": "Yeah? Well... uh... we’re going... to… F**K YOUR *FACE*!"
  },
  {
   "i": 96,
   "start": 216.26,
   "end": 218.52,
   "kind": "dialog",
   "speaker": "Freeza",
   "text": "Ho-ho-ho, my...!"
  },
  {
   "i": 97,
   "start": 218.52,
   "end": 219.1,
   "kind": "dialog",
   "speaker": "Freeza",
   "text": "Twelve."
  },
  {
   "i": 98,
   "start": 219.1,
   "end": 219.98,
   "kind": "dialog",
   "speaker": "Namekian Warrior",
   "text": "Hrrrrgh!"
  },
  {
   "i": 99,
   "start": 219.98,
   "end": 221.1,
   "kind": "dialog",
   "speaker": "Freeza",
   "text": "Zarbon, give the command!"
  },
  {
   "i": 100,
   "start": 221.1,
   "end": 222.7,
   "kind": "dialog",
   "speaker": "Zarbon",
   "text": "Dodoria, give the command!"
  },
  {
   "i": 101,
   "start": 222.7,
   "end": 223.28,
   "kind": "dialog",
   "speaker": "Dodoria",
   "text": "*Get ‘em*."
  },
  {
   "i": 102,
   "start": 223.28,
   "end": 225.72,
   "kind": "dialog",
   "speaker": "Freeza Mooks",
   "text": "HAAAAAAAAAAAAAAAAA!"
  },
  {
   "i": 103,
   "start": 233.22,
   "end": 235.04,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "Krillin! We have to help them!"
  },
  {
   "i": 104,
   "start": 235.04,
   "end": 237.64,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Gohan, we need to stick to the plan."
  },
  {
   "i": 105,
   "start": 237.64,
   "end": 238.22,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "QUACK!"
  },
  {
   "i": 106,
   "start": 238.22,
   "end": 241.32,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "What plan? You just keep quacking over and over."
  },
  {
   "i": 107,
   "start": 241.32,
   "end": 243.4,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "And we’re still *alive*!"
  },
  {
   "i": 108,
   "start": 245.38,
   "end": 248.28,
   "kind": "dialog",
   "speaker": "Zarbon",
   "text": "Sir, they seem to be stronger than we thought."
  },
  {
   "i": 109,
   "start": 248.28,
   "end": 251.6,
   "kind": "dialog",
   "speaker": "Freeza",
   "text": "Oh, how cute. They can hide their little power levels."
  },
  {
   "i": 110,
   "start": 251.82,
   "end": 253.14,
   "kind": "sfx",
   "speaker": null,
   "text": "KABOOOM"
  },
  {
   "i": 111,
   "start": 251.82,
   "end": 253.14,
   "kind": "direction",
