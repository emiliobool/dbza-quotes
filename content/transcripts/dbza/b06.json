{"item":"b06","show":"dbza","youtube":"UPYq7SCdIYM","title":"What's Her Name Again","duration":30,"lines":[{"i":0,"start":0.48,"end":3.5,"kind":"dialog","speaker":"Goku","text":"Oh wow! Look at you, Krillin, you've got hair!"},{"i":1,"start":3.5,"end":5.46,"kind":"dialog","speaker":"Krillin","text":"And proof I had sex!"},{"i":2,"start":5.54,"end":6.46,"kind":"dialog","speaker":"Marron","text":"Hello!"},{"i":3,"start":6.52,"end":8.2,"kind":"dialog","speaker":"Goku","text":"Aww, what's your name?"},{"i":4,"start":8.34,"end":9.06,"kind":"dialog","speaker":"Marron","text":"Marron!"},{"i":5,"start":10.44,"end":12.18,"kind":"dialog","speaker":"Goku","text":"So we gonna talk about that, or..."},{"i":6,"start":12.18,"end":14.74,"kind":"dialog","speaker":"Krillin","text":"Talk about what? It's my grandmother's name."},{"i":7,"start":15.06,"end":20.34,"kind":"dialog","speaker":"Goku","text":"Talk... about how great it is you can still have children."},{"i":8,"start":20.66,"end":22.12,"kind":"dialog","speaker":"Krillin","text":"Uh, thank you?"},{"i":9,"start":21.7,"end":23.66,"kind":"dialog","speaker":"Goku","text":"You're welcome, goodbye!"},{"i":10,"start":25.86,"end":29.04,"kind":"dialog","speaker":"Android 18","text":"You're right, it is funnier if we act like I don't know."},{"i":11,"start":28.98,"end":30.0,"kind":"dialog","speaker":"Krillin","text":"Told ya! Thank you."}],"segments":[]}