{"item": "k01", "show": "dbza", "youtube": "Uo5Rhn8zuPA", "title": "Episode 1", "duration": 130, "lines": [{"i": 0, "start": 0.0, "end": 2.76, "kind": "dialog", "speaker": "Vegeta", "text": "This is a parody official release support Akira Toriyama!"}, {"i": 1, "start": 4.14, "end": 4.86, "kind": "dialog", "speaker": "Farmer", "text": "You're an alien!"}, {"i": 2, "start": 4.86, "end": 5.76, "kind": "dialog", "speaker": "Raditz", "text": "I'm an alien."}, {"i": 3, "start": 5.76, "end": 6.62, "kind": "dialog", "speaker": "Piccolo", "text": "Am I an alien?"}, {"i": 4, "start": 6.62, "end": 7.12, "kind": "dialog", "speaker": "Raditz", "text": "Probably."}, {"i": 5, "start": 7.12, "end": 8.24, "kind": "dialog", "speaker": "Raditz", "text": "Where's my brother?"}, {"i": 6, "start": 8.24, "end": 8.84, "kind": "dialog", "speaker": "Piccolo", "text": "I don't know."}, {"i": 7, "start": 8.84, "end": 10.14, "kind": "dialog", "speaker": "Raditz", "text": "Then you're useless to me!"}, {"i": 8, "start": 10.84, "end": 13.44, "kind": "sfx", "speaker": null, "text": "Dragon Soul!"}, {"i": 9, "start": 13.46, "end": 14.22, "kind": "dialog", "speaker": "Goku", "text": "I have a kid!"}, {"i": 10, "start": 14.22, "end": 15.32, "kind": "dialog", "speaker": "Gohan", "text": "I'm socially awkward."}, {"i": 11, "start": 15.32, "end": 16.48, "kind": "dialog", "speaker": "Krillin", "text": "He's adorable!"}, {"i": 12, "start": 16.48, "end": 17.14, "kind": "dialog", "speaker": "Krillin", "text": "AHHH!!"}, {"i": 13, "start": 17.14, "end": 17.72, "kind": "direction", "speaker": null, "text": "DINGDINGDINGDINGDINGDINGDINGDINGDING"}, {"i": 14, "start": 17.72, "end": 18.4, "kind": "direction", "speaker": null, "text": "EXPLOSION"}, {"i": 15, "start": 18.4, "end": 19.7, "kind": "dialog", "speaker": "Raditz", "text": "I'm here for my brother."}, {"i": 16, "start": 19.7, "end": 20.52, "kind": "dialog", "speaker": "Goku", "text": "Am I your brother?"}, {"i": 17, "start": 20.52, "end": 21.16, "kind": "dialog", "speaker": "Raditz", "text": "Yes."}, {"i": 18, "start": 21.16, "end": 22.64, "kind": "dialog", "speaker": "Raditz", "text": "DUN DUN DUN"}, {"i": 19, "start": 22.64, "end": 23.5, "kind": "dialog", "speaker": "Raditz", "text": "DUNDUNDUN"}, {"i": 20, "start": 23.5, "end": 24.74, "kind": "dialog", "speaker": "Raditz", "text": "DUUUUN"}, {"i": 21, "start": 24.74, "end": 25.66, "kind": "dialog", "speaker": "Raditz", "text": "I'm taking your son."}, {"i": 22, "start": 25.66, "end": 26.2, "kind": "dialog", "speaker": "Goku", "text": "No you're not!"}, {"i": 23, "start": 26.2, "end": 26.78, "kind": "dialog", "speaker": "Goku", "text": "*Slam* Goku: UNGH"}, {"i": 24, "start": 26.78, "end": 27.98, "kind": "dialog", "speaker": "Goku", "text": "Ahh! He took my son!"}, {"i": 25, "start": 28.02, "end": 29.06, "kind": "dialog", "speaker": "Piccolo", "text": "I'm here to help you."}, {"i": 26, "start": 29.06, "end": 29.78, "kind": "dialog", "speaker": "Goku", "text": "Aren't we enemies?"}, {"i": 27, "start": 29.78, "end": 31.04, "kind": "dialog", "speaker": "Piccolo", "text": "Nobody watched DragonBall."}, {"i": 28, "start": 31.04, "end": 31.72, "kind": "dialog", "speaker": "Piccolo", "text": "Let's go!"}, {"i": 29, "start": 31.72, "end": 32.8, "kind": "dialog", "speaker": "Goku", "text": "Are you a Yoshi?"}, {"i": 30, "start": 32.8, "end": 33.5, "kind": "dialog", "speaker": "Piccolo", "text": "Hells yeah!"}, {"i": 31, "start": 34.32, "end": 35.66, "kind": "dialog", "speaker": "Goku", "text": "Gimme back my son!"}, {"i": 32, "start": 35.66, "end": 36.38, "kind": "direction", "speaker": null, "text": "Unzipping noise"}, {"i": 33, "start": 36.84, "end": 37.34, "kind": "dialog", "speaker": "Goku", "text": "Gross."}, {"i": 34, "start": 37.34, "end": 38.28, "kind": "dialog", "speaker": "Phil Sebben", "text": "Hahaa!"}, {"i": 35, "start": 38.28, "end": 38.78, "kind": "dialog", "speaker": "Goku", "text": "Ugh! Piccolo: Urgh!"}, {"i": 36, "start": 38.78, "end": 40.72, "kind": "direction", "speaker": null, "text": "Lots of fighting"}, {"i": 37, "start": 40.72, "end": 41.84, "kind": "dialog", "speaker": "Goku", "text": "Piccolo! Get him!"}, {"i": 38, "start": 41.84, "end": 43.72, "kind": "dialog", "speaker": "Piccolo", "text": "Mekanzapalapagah!"}, {"i": 39, "start": 43.72, "end": 44.38, "kind": "dialog", "speaker": "Goku", "text": "Ungh!"}, {"i": 40, "start": 44.38, "end": 46.02, "kind": "dialog", "speaker": "Goku", "text": "🐣 Piccolo got a DOUBLE KILL!"}, {"i": 41, "start": 47.04, "end": 47.98, "kind": "dialog", "speaker": "Goku", "text": "And now I am the dead!"}, {"i": 42, "start": 48.16, "end": 48.66, "kind": "dialog", "speaker": "Goku", "text": "Bleh."}, {"i": 43, "start": 48.66, "end": 49.88, "kind": "dialog", "speaker": "Krillin", "text": "Oh no, Goku's dead!"}, {"i": 44, "start": 49.88, "end": 51.18, "kind": "dialog", "speaker": "Vegeta", "text": "Hey Nappa, let's go to Earth."}, {"i": 45, "start": 51.18, "end": 51.8, "kind": "dialog", "speaker": "Nappa", "text": "Ballin."}, {"i": 46, "start": 51.8, "end": 53.26, "kind": "dialog", "speaker": "Krillin", "text": "Oh no, more Saiyans!"}, {"i": 47, "start": 53.26, "end": 54.16, "kind": "dialog", "speaker": "Piccolo", "text": "I'm taking Gohan!"}, {"i": 48, "start": 54.68, "end": 55.5, "kind": "dialog", "speaker": "Mr Popo", "text": "Hi, maggots."}, {"i": 49, "start": 55.5, "end": 56.26, "kind": "dialog", "speaker": "Mr Popo", "text": "I'm training you."}, {"i": 50, "start": 56.26, "end": 58.18, "kind": "dialog", "speaker": "Mr Popo", "text": "I'm terrifying and a potential rapist!"}, {"i": 51, "start": 58.18, "end": 59.42, "kind": "dialog", "speaker": "Mr Popo", "text": "But I'll never say it flat out."}, {"i": 52, "start": 60.9, "end": 61.4, "kind": "dialog", "speaker": "Mr Popo", "text": "BUH! [Krillin Screams]"}, {"i": 53, "start": 61.4, "end": 62.18, "kind": "dialog", "speaker": "Piccolo", "text": "Dodge! [Gohan Screams]"}, {"i": 54, "start": 62.18, "end": 62.96, "kind": "dialog", "speaker": "Bojack", "text": "Yarr!"}, {"i": 55, "start": 62.96, "end": 63.66, "kind": "dialog", "speaker": "Goku", "text": "Who are you?"}, {"i": 56, "start": 63.66, "end": 66.38, "kind": "dialog", "speaker": "King Kai", "text": "I'm King Kai. You now know the Kaio-ken and the Spirit Bomb."}, {"i": 57, "start": 66.38, "end": 67.82, "kind": "dialog", "speaker": "King Kai", "text": "F*ck off. Shut up, Bojack."}, {"i": 58, "start": 67.82, "end": 70.02, "kind": "dialog", "speaker": "Piccolo", "text": "Twelve months have passed! Let's go fight Saiyans."}, {"i": 59, "start": 70.02, "end": 71.56, "kind": "dialog", "speaker": "Krillin", "text": "Oh god, it's the Saiyans!"}, {"i": 60, "start": 71.56, "end": 72.06, "kind": "dialog", "speaker": "Vegeta", "text": "Hi."}, {"i": 61, "start": 72.06, "end": 72.84, "kind": "dialog", "speaker": "Krillin", "text": "Yamcha's here!"}, {"i": 62, "start": 72.84, "end": 73.44, "kind": "direction", "speaker": null, "text": "Explosion"}, {"i": 63, "start": 73.44, "end": 74.46, "kind": "dialog", "speaker": "Krillin", "text": "Yamcha's dead!"}, {"i": 64, "start": 74.46, "end": 75.42, "kind": "dialog", "speaker": "Vegeta", "text": "Nappa, get 'em!"}, {"i": 65, "start": 75.42, "end": 78.6, "kind": "dialog", "speaker": "Nappa", "text": "I am hilarious and you will quote everything I say."}, {"i": 66, "start": 78.6, "end": 79.6, "kind": "dialog", "speaker": "Krillin", "text": "Tien, get 'em!"}, {"i": 67, "start": 79.6, "end": 82.08, "kind": "dialog", "speaker": "Tien", "text": "I am the only serious character in this show. That's the joke."}, {"i": 68, "start": 82.08, "end": 82.58, "kind": "direction", "speaker": null, "text": "Explosion"}, {"i": 69, "start": 82.58, "end": 83.5, "kind": "direction", "speaker": null, "text": "Slam* *Slam"}, {"i": 70, "start": 83.5, "end": 85.66, "kind": "dialog", "speaker": "Krillin", "text": "Oh god, everyone's dead!"}, {"i": 71, "start": 85.66, "end": 88.04, "kind": "dialog", "speaker": "Nappa", "text": "Hilariously derailing one liner."}, {"i": 72, "start": 88.04, "end": 88.92, "kind": "dialog", "speaker": "Goku", "text": "Goku's here."}, {"i": 73, "start": 88.92, "end": 89.72, "kind": "dialog", "speaker": "Krillin", "text": "Goku's here!"}, {"i": 74, "start": 89.72, "end": 91.64, "kind": "dialog", "speaker": "Vegeta", "text": "It's OVER NINE THOUSAAAAAAAAAAAAA-"}, {"i": 75, "start": 91.64, "end": 92.14, "kind": "dialog", "speaker": "Nappa", "text": "AAAAAAAAAA-"}, {"i": 76, "start": 92.14, "end": 92.64, "kind": "dialog", "speaker": "Vegeta", "text": "AAAAAAAAA-"}, {"i": 77, "start": 92.64, "end": 93.14, "kind": "dialog", "speaker": "Nappa", "text": "AAAAAAA-"}, {"i": 78, "start": 93.14, "end": 94.08, "kind": "direction", "speaker": null, "text": "Vegeta and Nappa yelling"}, {"i": 79, "start": 94.08, "end": 94.84, "kind": "direction", "speaker": null, "text": "Explosion"}, {"i": 80, "start": 94.84, "end": 95.54, "kind": "dialog", "speaker": "Nappa", "text": "Vegeta WHY!"}, {"i": 81, "start": 95.54, "end": 96.64, "kind": "dialog", "speaker": "Vegeta", "text": "Because I'm a monkey!"}, {"i": 82, "start": 96.64, "end": 97.6, "kind": "direction", "speaker": null, "text": "Great Ape Vegeta roars"}, {"i": 83, "start": 97.6, "end": 98.28, "kind": "dialog", "speaker": "Goku", "text": "Kaio-ken!"}, {"i": 84, "start": 98.28, "end": 98.96, "kind": "dialog", "speaker": "Great Ape Vegeta", "text": "Kaio-what?"}, {"i": 85, "start": 98.96, "end": 99.46, "kind": "dialog", "speaker": "Great Ape Vegeta", "text": "AH!"}, {"i": 86, "start": 100.84, "end": 102.16, "kind": "dialog", "speaker": "Vegeta", "text": "Oh no! I'm not a monkey!"}, {"i": 87, "start": 102.16, "end": 104.16, "kind": "dialog", "speaker": "Vegeta", "text": "OH NO! THE KID'S A MONKEY!"}, {"i": 88, "start": 104.16, "end": 105.9, "kind": "dialog", "speaker": "Vegeta", "text": "Destructo Disc!"}, {"i": 89, "start": 105.9, "end": 106.96, "kind": "dialog", "speaker": "Krillin", "text": "The F*CK ?"}, {"i": 90, "start": 107.48, "end": 107.98, "kind": "dialog", "speaker": "Vegeta", "text": "Yay!"}, {"i": 91, "start": 108.36, "end": 108.94, "kind": "dialog", "speaker": "Vegeta", "text": "No!"}, {"i": 92, "start": 109.26, "end": 110.88, "kind": "direction", "speaker": null, "text": "Slam"}, {"i": 93, "start": 110.88, "end": 111.78, "kind": "dialog", "speaker": "Vegeta", "text": "Leaving now..."}, {"i": 94, "start": 112.62, "end": 114.46, "kind": "dialog", "speaker": "Goku", "text": "And we'll never see him again!"}, {"i": 95, "start": 114.48, "end": 116.18, "kind": "dialog", "speaker": "Vegeta", "text": "They'll see me next episode."}, {"i": 96, "start": 116.18, "end": 116.76, "kind": "direction", "speaker": null, "text": "ding"}, {"i": 97, "start": 116.76, "end": 118.2, "kind": "dialog", "speaker": "Ghost Nappa", "text": "And I'm a ghost!"}, {"i": 98, "start": 118.62, "end": 119.94, "kind": "dialog", "speaker": "Ghost Nappa", "text": "Or am I...?"}, {"i": 99, "start": 119.94, "end": 120.5, "kind": "dialog", "speaker": "Ghost Nappa", "text": "DUNDUNDUN"}, {"i": 100, "start": 120.5, "end": 122.42, "kind": "dialog", "speaker": "Ghost Nappa", "text": "BWOOUGH"}, {"i": 101, "start": 122.74, "end": 127.2, "kind": "sfx", "speaker": null, "text": "Dragon Soul!"}, {"i": 102, "start": 127.2, "end": 129.38, "kind": "dialog", "speaker": "Yugi", "text": "This has how many subscribers?"}], "segments": []}