 "title": "Episode 8",
 "duration": 574,
 "lines": [
  {
   "i": 0,
   "start": 7.82,
   "end": 9.54,
   "kind": "dialog",
   "speaker": "Mr. Kent",
   "text": "[TV] And there you have it, folks."
  },
  {
   "i": 1,
   "start": 9.54,
   "end": 13.26,
   "kind": "dialog",
   "speaker": "Mr. Kent",
   "text": "That man is dead. Very, very dead."
  },
  {
   "i": 2,
   "start": 13.36,
   "end": 17.16,
   "kind": "dialog",
   "speaker": "Jimmy",
   "text": "[TV] Mr. Kent, if you had to come up with a word for how dead he is, what would it be?"
  },
  {
   "i": 3,
   "start": 17.44,
   "end": 19.0,
   "kind": "dialog",
   "speaker": "Mr. Kent",
   "text": "[TV] \"Cadaverific!\""
  },
  {
   "i": 4,
   "start": 19.28,
   "end": 22.22,
   "kind": "dialog",
   "speaker": "Bulma",
   "text": "(Crying)"
  },
  {
   "i": 5,
   "start": 22.22,
   "end": 27.5,
   "kind": "dialog",
   "speaker": "Bulma",
   "text": "Yamcha! No! I was saving myself for him!"
  },
  {
   "i": 6,
   "start": 27.5,
   "end": 30.0,
   "kind": "dialog",
   "speaker": "Bulma",
   "text": "(Crying)"
  },
  {
   "i": 7,
   "start": 30.82,
   "end": 31.84,
   "kind": "dialog",
   "speaker": "Roshi",
   "text": "...Bulls**t!"
  },
  {
   "i": 8,
   "start": 52.72,
   "end": 53.42,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Yamcha..."
  },
  {
   "i": 9,
   "start": 53.9,
   "end": 54.62,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Yamcha!"
  },
  {
   "i": 10,
   "start": 55.56,
   "end": 59.84,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Yamcha was our friend... and you bastards killed him!"
  },
  {
   "i": 11,
   "start": 60.42,
   "end": 63.42,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Don’t worry, Yamcha... I’ll avenge you!"
  },
  {
   "i": 12,
   "start": 63.74,
   "end": 66.1,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "Oh, right. *You're* going to avenge him."
  },
  {
   "i": 13,
   "start": 66.34,
   "end": 69.04,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "The FIVE-YEAR-OLD over here is stronger than you are."
  },
  {
   "i": 14,
   "start": 69.18,
   "end": 69.68,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "But I--"
  },
  {
   "i": 15,
   "start": 69.68,
   "end": 72.2,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "Face it, you’re pretty much here as a meat shield."
  },
  {
   "i": 16,
   "start": 72.34,
   "end": 76.18,
   "kind": "dialog",
   "speaker": "Nappa",
   "text": "Ha! Look at him, Vegeta. He’s like the *Raditz* of their group."
  },
  {
   "i": 17,
   "start": 76.34,
   "end": 77.1,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "That's it!"
  },
  {
   "i": 18,
   "start": 77.48,
   "end": 79.2,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "I can’t take it anymore!"
  },
  {
   "i": 19,
   "start": 79.48,
   "end": 81.8,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "I can only be pushed so far!"
  },
  {
   "i": 20,
   "start": 82.46,
   "end": 85.72,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "KRILLIN LIMIT BREEEEEAK!!"
  },
  {
   "i": 21,
   "start": 88.46,
   "end": 91.78,
   "kind": "direction",
   "speaker": null,
   "text": "Saibamen shriek"
  },
  {
   "i": 22,
   "start": 92.16,
   "end": 96.02,
   "kind": "direction",
   "speaker": null,
   "text": "♫ Final Fantasy 7 victory fanfare ♫"
  },
  {
   "i": 23,
   "start": 96.4,
   "end": 98.4,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "(Panting)"
  },
  {
   "i": 24,
   "start": 98.82,
   "end": 100.96,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "That was... for Yamcha."
  },
  {
   "i": 25,
   "start": 101.48,
   "end": 105.14,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Congratulations, you've just destroyed the equivalent of three Raditz."
  },
  {
   "i": 26,
   "start": 105.14,
   "end": 106.92,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "That’s right! What now, you son of a bi--?!"
  },
  {
   "i": 27,
   "start": 106.92,
   "end": 108.96,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Nappa here is worth FIVE Raditz..."
  },
  {
   "i": 28,
   "start": 108.96,
   "end": 109.62,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "I, uh..."
  },
  {
   "i": 29,
   "start": 110.32,
   "end": 110.82,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "what?"
  },
  {
   "i": 30,
   "start": 111.02,
   "end": 113.48,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "...and I am worth *fifteen* Raditz."
  },
  {
   "i": 31,
   "start": 113.96,
   "end": 114.54,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "I..."
  },
  {
   "i": 32,
   "start": 115.56,
   "end": 116.24,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Awww..."
  },
  {
   "i": 33,
   "start": 116.52,
   "end": 118.88,
   "kind": "dialog",
   "speaker": "Nappa",
   "text": "Aw, come on, don’t get so down on yourself."
  },
  {
   "i": 34,
   "start": 119.02,
   "end": 123.4,
   "kind": "dialog",
   "speaker": "Nappa",
   "text": "At least you’ve proven that YOUR Raditz is *still* stronger than our Raditz."
  },
  {
   "i": 35,
   "start": 124.44,
   "end": 127.68,
   "kind": "dialog",
   "speaker": "Raditz",
   "text": "I... hate... *all* of you!"
  },
  {
   "i": 36,
   "start": 128.5,
   "end": 131.58,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "So in short - good for you. Oh, by the way, you missed one."
  },
  {
   "i": 37,
   "start": 132.2,
   "end": 132.8,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "Aaah!"
  },
  {
   "i": 38,
   "start": 132.8,
   "end": 133.76,
   "kind": "direction",
   "speaker": null,
   "text": "Shriek"
  },
  {
   "i": 39,
   "start": 134.7,
   "end": 135.2,
   "kind": "direction",
   "speaker": null,
   "text": "Whimper"
  },
  {
   "i": 40,
   "start": 135.2,
   "end": 135.86,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "Yeah, no."
  },
  {
   "i": 41,
   "start": 136.36,
   "end": 136.86,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "Hargh!"
  },
  {
   "i": 42,
   "start": 137.64,
   "end": 138.16,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "Argh!"
  },
  {
   "i": 43,
   "start": 138.64,
   "end": 139.4,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "HARGH!"
  },
  {
   "i": 44,
   "start": 139.62,
   "end": 140.88,
   "kind": "direction",
   "speaker": null,
   "text": "Terrified shriek"
  },
  {
   "i": 45,
   "start": 142.38,
   "end": 144.64,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "That was incredible, Mr. Piccolo!"
  },
  {
   "i": 46,
   "start": 144.86,
   "end": 146.1,
   "kind": "dialog",
   "speaker": "Tien",
   "text": "Yeah! Way to go!"
  },
  {
   "i": 47,
   "start": 146.42,
   "end": 147.38,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "But, what about--?"
  },
  {
   "i": 48,
   "start": 147.38,
   "end": 149.3,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "Well, we can all learn a thing or two."
  },
  {
   "i": 49,
   "start": 149.56,
   "end": 150.76,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "But I just killed three of them--!"
  },
  {
   "i": 50,
   "start": 150.76,
   "end": 152.24,
   "kind": "dialog",
   "speaker": "Chiaotzu",
   "text": "Nobody cares, Krillin!"
  },
  {
   "i": 51,
   "start": 152.64,
   "end": 153.54,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Aww..."
  },
  {
   "i": 52,
   "start": 153.88,
   "end": 157.14,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Well, Nappa - looks like it’s your turn to teach them a lesson."
  },
  {
   "i": 53,
   "start": 157.52,
   "end": 159.64,
   "kind": "dialog",
   "speaker": "Nappa",
   "text": "Yeah, right outta Saiyan University!"
  },
  {
   "i": 54,
   "start": 159.88,
   "end": 161.8,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Hold on, you went to college?"
  },
  {
   "i": 55,
   "start": 161.8,
   "end": 162.3,
   "kind": "dialog",
   "speaker": "Nappa",
   "text": "Yup."
  },
  {
   "i": 56,
   "start": 162.44,
   "end": 165.66,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "*What the hell* could someone like you possibly major in?"
  },
  {
   "i": 57,
   "start": 165.72,
   "end": 167.28,
   "kind": "dialog",
   "speaker": "Nappa",
   "text": "Child Psychology..."
  },
  {
   "i": 58,
   "start": 167.58,
   "end": 169.42,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "Wow! That sounds really interest--!"
  },
  {
   "i": 59,
   "start": 169.42,
   "end": 171.06,
   "kind": "dialog",
   "speaker": "Nappa",
   "text": "...*with a minor in Pain*!"
  },
  {
   "i": 60,
   "start": 171.44,
   "end": 172.14,
   "kind": "dialog",
   "speaker": "Tien",
   "text": "Uhuh...?!"
  },
  {
   "i": 61,
   "start": 171.44,
   "end": 172.14,
   "kind": "dialog",
   "speaker": "Nappa",
   "text": "Hurrrr..."
  },
  {
   "i": 62,
   "start": 172.14,
   "end": 172.82,
   "kind": "dialog",
   "speaker": "Tien",
   "text": "GAUGH!"
  },
  {
   "i": 63,
   "start": 172.14,
   "end": 172.82,
   "kind": "dialog",
   "speaker": "Nappa",
   "text": "RAAGH!"
  },
  {
   "i": 64,
   "start": 173.34,
   "end": 176.24,
   "kind": "dialog",
   "speaker": "Tien",
   "text": "*YAAAAAAAUGHAAAAAAAH*!!"
  },
  {
   "i": 65,
   "start": 176.36,
   "end": 177.94,
   "kind": "dialog",
   "speaker": "Tien",
   "text": "Haaaagh...!"
  },
  {
   "i": 66,
   "start": 176.36,
   "end": 179.48,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Looks like he’s been... *disarmed*!"
  },
  {
   "i": 67,
   "start": 177.94,
   "end": 179.48,
   "kind": "dialog",
   "speaker": "Tien",
   "text": "HURAAARGH!!"
  },
  {
   "i": 68,
   "start": 180.22,
   "end": 181.94,
   "kind": "direction",
   "speaker": null,
   "text": "Wind blows"
  },
  {
   "i": 69,
   "start": 182.3,
   "end": 183.06,
   "kind": "dialog",
   "speaker": "Nappa",
   "text": "I get it!"
  },
  {
   "i": 70,
   "start": 183.06,
   "end": 183.96,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Shut it, Nappa."
  },
  {
   "i": 71,
   "start": 184.62,
   "end": 185.12,
   "kind": "dialog",
   "speaker": "Tien",
   "text": "Guh!"
  },
  {
   "i": 72,
   "start": 185.58,
   "end": 187.22,
   "kind": "dialog",
   "speaker": "Nappa",
   "text": "Oh, I LOVE this game!"
  },
  {
   "i": 73,
   "start": 187.88,
   "end": 188.66,
   "kind": "dialog",
   "speaker": "Nappa",
   "text": "Tag!"
  },
  {
   "i": 74,
   "start": 187.88,
   "end": 188.66,
   "kind": "dialog",
   "speaker": "Tien",
   "text": "Guahg!"
  },
  {
   "i": 75,
   "start": 189.2,
   "end": 189.92,
   "kind": "dialog",
   "speaker": "Tien",
   "text": "Huagh!"
  },
  {
   "i": 76,
   "start": 191.14,
   "end": 192.86,
   "kind": "dialog",
   "speaker": "Nappa",
   "text": "No tagbacks."
  },
  {
   "i": 77,
   "start": 193.14,
   "end": 195.76,
   "kind": "dialog",
   "speaker": "Tien",
   "text": "'Agh, damn. This guy’s strong.'"
  },
  {
   "i": 78,
   "start": 196.06,
   "end": 198.58,
   "kind": "dialog",
   "speaker": "Tien",
   "text": "'Maybe it would be best if I just took Chiaotzu and...'"
  },
  {
   "i": 79,
   "start": 198.96,
   "end": 200.32,
   "kind": "dialog",
   "speaker": "Tien",
   "text": "'Wait, where is he??'"
  },
  {
   "i": 80,
   "start": 200.32,
   "end": 203.04,
   "kind": "dialog",
   "speaker": "Nappa",
   "text": "Vegeta! The Pokémon’s on my back."
  },
  {
   "i": 81,
   "start": 204.22,
   "end": 205.7,
   "kind": "dialog",
   "speaker": "Tien",
   "text": "Chiaotzu! No!!"
  },
  {
   "i": 82,
   "start": 205.7,
   "end": 207.62,
   "kind": "dialog",
   "speaker": "Nappa",
   "text": "I can’t get it off, Vegeta!"
  },
  {
   "i": 83,
   "start": 207.84,
   "end": 210.12,
   "kind": "dialog",
   "speaker": "Nappa",
   "text": "Here! I’ll use Rock Smash."
  },
  {
   "i": 84,
   "start": 210.4,
   "end": 211.78,
   "kind": "direction",
   "speaker": null,
   "text": "Booming crunch"
  },
  {
   "i": 85,
   "start": 210.4,
   "end": 211.78,
   "kind": "dialog",
   "speaker": "Chiaotzu",
   "text": "UU-HU!"
  },
  {
   "i": 86,
   "start": 211.78,
   "end": 214.1,
   "kind": "dialog",
   "speaker": "Tien",
   "text": "Chiaotzu! You get down from there this instant!"
  },
  {
   "i": 87,
   "start": 214.24,
   "end": 217.06,
   "kind": "dialog",
   "speaker": "Chiaotzu",
   "text": "[telepathically] No! I have to do this, Tenshinhan!"
  },
  {
   "i": 88,
   "start": 217.06,
   "end": 221.28,
   "kind": "dialog",
   "speaker": "Chiaotzu",
   "text": "For all the people of Earth! Our friends! And especially you!"
  },
  {
   "i": 89,
   "start": 221.6,
   "end": 222.58,
   "kind": "dialog",
   "speaker": "Tien",
   "text": "But Chiaotzu...!"
  },
  {
   "i": 90,
   "start": 222.58,
   "end": 226.18,
   "kind": "dialog",
   "speaker": "Chiaotzu",
   "text": "[t] Don’t worry! You can just wish me back with the Dragon Balls!"
  },
  {
   "i": 91,
   "start": 226.34,
   "end": 228.1,
   "kind": "dialog",
   "speaker": "Chiaotzu",
   "text": "Now goodbye, my friend!"
  },
  {
   "i": 92,
   "start": 228.62,
   "end": 230.52,
   "kind": "dialog",
   "speaker": "Tien",
   "text": "That won’t work, Chiaotzu!!"
  },
  {
   "i": 93,
   "start": 230.52,
   "end": 234.66,
   "kind": "dialog",
   "speaker": "Tien",
   "text": "We already wished you back once with the Dragon Balls! We can’t do it twice!"
  },
  {
   "i": 94,
   "start": 235.54,
   "end": 236.04,
   "kind": "dialog",
   "speaker": "Chiaotzu",
   "text": "[t] ...Wait, wha--?"
  },
  {
   "i": 95,
   "start": 239.16,
   "end": 241.16,
   "kind": "dialog",
   "speaker": "Tien",
   "text": "(Gasping)"
  },
  {
   "i": 96,
   "start": 241.96,
   "end": 244.6,
   "kind": "dialog",
   "speaker": "Tien",
   "text": "No! NO! Chiaotzu!"
  },
  {
   "i": 97,
   "start": 244.98,
   "end": 247.22,
   "kind": "dialog",
   "speaker": "Tien",
   "text": "CHIAOTZUUUU!!"
  },
  {
   "i": 98,
   "start": 248.96,
   "end": 250.04,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Oh, my God..."
  },
  {
   "i": 99,
   "start": 250.78,
   "end": 252.72,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "He blew into more pieces than Yamcha!"
  },
  {
   "i": 100,
   "start": 252.92,
   "end": 253.5,
   "kind": "dialog",
   "speaker": "Tien",
   "text": "Krillin!"
  },
  {
   "i": 101,
   "start": 253.8,
   "end": 254.3,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "What?"
  },
  {
   "i": 102,
   "start": 254.54,
   "end": 256.14,
   "kind": "dialog",
   "speaker": "Tien",
   "text": "He was my closest friend!"
  },
  {
   "i": 103,
   "start": 256.48,
   "end": 256.98,
   "kind": "dialog",
   "speaker": "Tien",
   "text": "I..."
  },
  {
   "i": 104,
   "start": 258.16,
   "end": 259.08,
   "kind": "dialog",
   "speaker": "Tien",
   "text": "I loved him."
  },
  {
   "i": 105,
   "start": 259.92,
   "end": 262.4,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "As a memorial to Yamcha... ”gay”."
  },
  {
   "i": 106,
   "start": 262.98,
   "end": 265.94,
   "kind": "dialog",
   "speaker": "Tien",
   "text": "'At least your sacrifice wasn’t in vain, my friend.'"
  },
  {
   "i": 107,
   "start": 266.24,
   "end": 268.98,
   "kind": "dialog",
   "speaker": "Nappa",
   "text": "Aww, dang it, Vegeta. He used Self Destruct."
  },
  {
   "i": 108,
   "start": 269.14,
   "end": 270.62,
   "kind": "dialog",
   "speaker": "Nappa",
   "text": "I hate it when they do that."
  },
  {
   "i": 109,
   "start": 270.96,
   "end": 271.82,
   "kind": "dialog",
   "speaker": "Tien",
   "text": "DAMMIT!"
  },
  {
   "i": 110,
   "start": 272.04,
   "end": 275.64,
   "kind": "dialog",
   "speaker": "Nappa",
   "text": "Awwww, I think I made him mad, Vegeta. Should I talk to him about it?"
  },
  {
   "i": 111,
   "start": 275.9,
   "end": 279.34,
   "kind": "dialog",
   "speaker": "Nappa",
   "text": "The first step to working out your problems is healthy communication."
  },
  {
   "i": 112,
   "start": 279.46,
   "end": 280.84,
   "kind": "dialog",
   "speaker": "Tien",
   "text": "FFRAAAAAAAGH!!"
  },
  {
