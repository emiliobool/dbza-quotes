{"item":"b22","show":"dbza","youtube":"KsUNAtBxwwA","title":"Best Buuddies","duration":58,"lines":[{"i":0,"start":0.2,"end":2.36,"kind":"dialog","speaker":"Majin Buu","text":"Buu hungry! Buu eat doggy!"},{"i":1,"start":2.44,"end":5.14,"kind":"dialog","speaker":"Hercule","text":"No, Buu! We do not eat dogs!"},{"i":2,"start":5.34,"end":6.56,"kind":"dialog","speaker":"Majin Buu","text":"Buu confused."},{"i":3,"start":6.82,"end":10.0,"kind":"dialog","speaker":"Majin Buu","text":"If humans eat cows and pigs, why no we eat dogs?"},{"i":4,"start":10.2,"end":14.22,"kind":"dialog","speaker":"Hercule","text":"Because they're cute, domesticated, and functional."},{"i":5,"start":14.52,"end":16.54,"kind":"dialog","speaker":"Majin Buu","text":"So, say please and Buu not eat you."},{"i":6,"start":17.2,"end":18.28,"kind":"dialog","speaker":"Hercule","text":"Yes?"},{"i":7,"start":18.62,"end":20.44,"kind":"dialog","speaker":"Majin Buu","text":"Then Buu want DoorDash."},{"i":8,"start":20.44,"end":22.42,"kind":"dialog","speaker":"Hercule","text":"Oh, come on. They're overpriced."},{"i":9,"start":22.32,"end":23.42,"kind":"dialog","speaker":"Majin Buu","text":"Uber Eats!"},{"i":10,"start":22.82,"end":24.36,"kind":"dialog","speaker":"Hercule","text":"That's worse!"},{"i":11,"start":24.26,"end":25.3,"kind":"dialog","speaker":"Majin Buu","text":"Postmates!"},{"i":12,"start":24.62,"end":26.7,"kind":"dialog","speaker":"Hercule","text":"They're all bad, Buu!"},{"i":13,"start":26.64,"end":28.24,"kind":"dialog","speaker":"Majin Buu","text":"Then Buu eat driver!"},{"i":14,"start":28.38,"end":33.26,"kind":"dialog","speaker":"Hercule","text":"Just don't eat people no more. Use your magic and turn rocks into food."},{"i":15,"start":34.42,"end":36.1,"kind":"dialog","speaker":"Majin Buu","text":"Satan is genius."},{"i":16,"start":36.78,"end":38.34,"kind":"dialog","speaker":"Majin Buu","text":"No eat people no more."},{"i":17,"start":39.4,"end":41.1,"kind":"dialog","speaker":"Majin Buu","text":"Eat rocks instead."},{"i":18,"start":41.56,"end":42.42,"kind":"dialog","speaker":"Hercule","text":"Wait a second."},{"i":19,"start":42.86,"end":45.36,"kind":"dialog","speaker":"Hercule","text":"Did I just save humanity?"},{"i":20,"start":46.48,"end":49.08,"kind":"dialog","speaker":"Hercule","text":"I did. I saved the world."},{"i":21,"start":49.8,"end":51.9,"kind":"dialog","speaker":"Hercule","text":"Everything's gonna be..."},{"i":22,"start":53.4,"end":53.96,"kind":"dialog","speaker":null,"text":"Fucked."}],"segments":[]}
