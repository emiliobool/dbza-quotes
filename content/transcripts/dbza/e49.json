  },
  {
   "i": 31,
   "start": 118.04,
   "end": 121.78,
   "kind": "dialog",
   "speaker": "Cell",
   "text": "Ah! Krillin, my arch-nemesis."
  },
  {
   "i": 32,
   "start": 121.94,
   "end": 125.2,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Cell, you fiend, we meet at last- AGAIN!"
  },
  {
   "i": 33,
   "start": 125.76,
   "end": 127.34,
   "kind": "dialog",
   "speaker": "Mommy",
   "text": "Thank you for saving me!"
  },
  {
   "i": 34,
   "start": 127.62,
   "end": 129.92,
   "kind": "dialog",
   "speaker": "Mommy",
   "text": "You're so brave, and attractive!"
  },
  {
   "i": 35,
   "start": 130.06,
   "end": 131.16,
   "kind": "dialog",
   "speaker": "Kid",
   "text": "Will you be my new daddy?"
  },
  {
   "i": 36,
   "start": 131.42,
   "end": 138.62,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Listen! I know you both just lost a husband and a father, and you need to fill that void- but I have eyes for another."
  },
  {
   "i": 37,
   "start": 138.62,
   "end": 139.44,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Now go!"
  },
  {
   "i": 38,
   "start": 139.8,
   "end": 140.74,
   "kind": "dialog",
   "speaker": "Mommy",
   "text": "Okay."
  },
  {
   "i": 39,
   "start": 140.96,
   "end": 142.36,
   "kind": "dialog",
   "speaker": "Kid",
   "text": "I love you new daddy!"
  },
  {
   "i": 40,
   "start": 143.04,
   "end": 145.14,
   "kind": "dialog",
   "speaker": "Cell",
   "text": "Now, we shall battle!"
  },
  {
   "i": 41,
   "start": 145.66,
   "end": 148.8,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Wup! Eep! Up!"
  },
  {
   "i": 42,
   "start": 152.22,
   "end": 154.22,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "It's no use Cell-"
  },
  {
   "i": 43,
   "start": 154.22,
   "end": 156.06,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "I've studied all your moves!"
  },
  {
   "i": 44,
   "start": 156.1,
   "end": 157.0,
   "kind": "dialog",
   "speaker": "Cell",
   "text": "Curse you!"
  },
  {
   "i": 45,
   "start": 157.42,
   "end": 159.42,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Now for my ultimate technique-!"
  },
  {
   "i": 46,
   "start": 160.08,
   "end": 163.0,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "SOOLAAAR FLAAAAREE!!!"
  },
  {
   "i": 47,
   "start": 168.66,
   "end": 170.26,
   "kind": "dialog",
   "speaker": "Little Man",
   "text": "Little Man: We on a plane mama."
  },
  {
   "i": 48,
   "start": 171.12,
   "end": 173.12,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "[Wait that's not my ultimate attack i thought the Kienza-]"
  },
  {
   "i": 49,
   "start": 173.7,
   "end": 175.56,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "UGH GODDAMMIT EVERY TIME!"
  },
  {
   "i": 50,
   "start": 175.7,
   "end": 177.22,
   "kind": "direction",
   "speaker": null,
   "text": "♫ Aqua - Halloween ♫"
  },
  {
   "i": 51,
   "start": 177.52,
   "end": 178.02,
   "kind": "direction",
   "speaker": null,
   "text": "cue loud crash"
  },
  {
   "i": 52,
   "start": 179.46,
   "end": 181.28,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "I SAID NOT TODAY!"
  },
  {
   "i": 53,
   "start": 181.28,
   "end": 183.28,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "WAHTAAHH"
  },
  {
   "i": 54,
   "start": 183.9,
   "end": 186.76,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "How? How did you best my penultimate technique?"
  },
  {
   "i": 55,
   "start": 187.36,
   "end": 188.62,
   "kind": "dialog",
   "speaker": "Cell",
   "text": "I blinked."
  },
  {
   "i": 56,
   "start": 188.8,
   "end": 189.5,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Oh, that'd do it."
  },
  {
   "i": 57,
   "start": 190.16,
   "end": 192.74,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Well then, let's see how you handle my ulti-"
  },
  {
   "i": 58,
   "start": 192.96,
   "end": 194.98,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "ACK!"
  },
  {
   "i": 59,
   "start": 195.16,
   "end": 196.72,
   "kind": "dialog",
   "speaker": "Kid",
   "text": "Are you okay new daddy?"
  },
  {
   "i": 60,
   "start": 196.94,
   "end": 199.08,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Ash sh vuv, sh vuv sh hunna HAMAM nonna ma!"
  },
  {
   "i": 61,
   "start": 199.26,
   "end": 200.16,
   "kind": "dialog",
   "speaker": "Kid",
   "text": "What you say?"
  },
  {
   "i": 62,
   "start": 200.36,
   "end": 203.86,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "I said, Ash sh vuv, sh vuv sh hunna HAMAM nonna ma!"
  },
  {
   "i": 63,
   "start": 207.88,
   "end": 209.26,
   "kind": "dialog",
   "speaker": "Cell",
   "text": "Well, Krillin..."
  },
  {
   "i": 64,
   "start": 209.82,
   "end": 215.88,
   "kind": "dialog",
   "speaker": "Cell",
   "text": "It seems that even in your wildest dreams- you still can't measure up."
  },
  {
   "i": 65,
   "start": 216.08,
   "end": 217.8,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Wha- What are you saying?"
  },
  {
   "i": 66,
   "start": 218.16,
   "end": 220.34,
   "kind": "dialog",
   "speaker": "Cell",
   "text": "I'm sayin', wake up."
  },
  {
   "i": 67,
   "start": 220.7,
   "end": 222.04,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Wha-, what?"
  },
  {
   "i": 68,
   "start": 222.22,
   "end": 223.68,
   "kind": "dialog",
   "speaker": "Cell",
   "text": "I said... WAKE UP"
  },
  {
   "i": 69,
   "start": 223.68,
   "end": 224.78,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "AH!"
  },
  {
   "i": 70,
   "start": 224.78,
   "end": 229.04,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Oh man, I had the craziest dream, Cell was there."
  },
