{"item": "b15", "show": "dbza", "youtube": "5jTYqbodBZo", "title": "Keep Your Eyes On The Buu", "duration": 60, "lines": [{"i": 0, "start": 0.24, "end": 5.34, "kind": "dialog", "speaker": "Babidi", "text": "Finally, after all these years and all of my hard work, he's finally been set free!"}, {"i": 1, "start": 5.8, "end": 7.28, "kind": "dialog", "speaker": "Babidi", "text": "My baby boy!"}, {"i": 2, "start": 7.62, "end": 9.28, "kind": "dialog", "speaker": "Babidi", "text": "Majin Buu!"}, {"i": 3, "start": 9.66, "end": 10.02, "kind": "dialog", "speaker": "Majin Buu", "text": "Buu!"}, {"i": 4, "start": 11.3, "end": 14.66, "kind": "dialog", "speaker": "Majin Buu", "text": "Buu-buu-buu! Buu-buu-buu! Buu-buu-buu! Buu-buu-buu!"}, {"i": 5, "start": 14.96, "end": 16.02, "kind": "dialog", "speaker": "Majin Buu", "text": "Ha-ha-ha-ha!"}, {"i": 6, "start": 16.72, "end": 19.36, "kind": "dialog", "speaker": "Dabura", "text": "I'm sorry. Does he need to go back in the oven?"}, {"i": 7, "start": 19.86, "end": 22.68, "kind": "dialog", "speaker": "Babidi", "text": "I'm a clone, so I don't really remember the original."}, {"i": 8, "start": 23.14, "end": 24.72, "kind": "dialog", "speaker": "Babidi", "text": "Dabura, little help here."}, {"i": 9, "start": 25.18, "end": 26.72, "kind": "dialog", "speaker": "Dabura", "text": "Let me talk with him, Master."}, {"i": 10, "start": 27.08, "end": 28.18, "kind": "dialog", "speaker": "Dabura", "text": "Majin Buu!"}, {"i": 11, "start": 28.64, "end": 29.04, "kind": "dialog", "speaker": "Majin Buu", "text": "Oh!"}, {"i": 12, "start": 29.12, "end": 32.66, "kind": "dialog", "speaker": "Majin Buu", "text": "Oh, are you new friend? You play games with Buu?"}, {"i": 13, "start": 32.9, "end": 36.9, "kind": "dialog", "speaker": "Dabura", "text": "I am not here for games. I am the Demon King Dabura."}, {"i": 14, "start": 37.28, "end": 41.76, "kind": "dialog", "speaker": "Dabura", "text": "Our master is Babidi, and you shall follow his every whim."}, {"i": 15, "start": 42.22, "end": 43.3, "kind": "dialog", "speaker": "Dabura", "text": "Understood?"}, {"i": 16, "start": 43.48, "end": 45.48, "kind": "dialog", "speaker": "Majin Buu", "text": "You play games with Buu."}, {"i": 17, "start": 45.88, "end": 49.2, "kind": "dialog", "speaker": "Dabura", "text": "What was that? Speak up, you pillowy pink preemie."}, {"i": 18, "start": 48.88, "end": 53.2, "kind": "dialog", "speaker": "Majin Buu", "text": "Take you in!"}, {"i": 19, "start": 52.82, "end": 55.82, "kind": "dialog", "speaker": "Dabura", "text": "Oh, God!"}, {"i": 20, "start": 59.12, "end": 60, "kind": "dialog", "speaker": "Dabura", "text": "I'm sorry."}], "segments": []}
