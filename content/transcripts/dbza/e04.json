 "title": "Episode 4",
 "duration": 514,
 "lines": [
  {
   "i": 0,
   "start": 7.86,
   "end": 11.24,
   "kind": "direction",
   "speaker": null,
   "text": "♪ DBZ prologue theme (#1) ♪"
  },
  {
   "i": 1,
   "start": 8.96,
   "end": 11.24,
   "kind": "dialog",
   "speaker": "Narrator",
   "text": "Last time on Dragon Ball Z Abridged:"
  },
  {
   "i": 2,
   "start": 11.24,
   "end": 14.2,
   "kind": "dialog",
   "speaker": "Narrator",
   "text": "Goku began his journey down Snake Way."
  },
  {
   "i": 3,
   "start": 14.2,
   "end": 17.24,
   "kind": "dialog",
   "speaker": "Narrator",
   "text": "Wait, is that some kind of innuendo?"
  },
  {
   "i": 4,
   "start": 17.5,
   "end": 18.56,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "(Panting)"
  },
  {
   "i": 5,
   "start": 18.56,
   "end": 21.52,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "'This is going to be the longest, toughest journey I’ve ever made!'"
  },
  {
   "i": 6,
   "start": 21.52,
   "end": 26.56,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "'I have to receive King Kai’s training, and battle the biggest threat to the planet we’ve ever faced!'"
  },
  {
   "i": 7,
   "start": 26.56,
   "end": 30.06,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "'I have to run as fast as I can! I have to keep running!'"
  },
  {
   "i": 8,
   "start": 30.36,
   "end": 33.46,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "'For the sake of the Earth, humanity, and my fam--!'"
  },
  {
   "i": 9,
   "start": 33.46,
   "end": 34.4,
   "kind": "direction",
   "speaker": null,
   "text": "Music cuts-off"
  },
  {
   "i": 10,
   "start": 33.46,
   "end": 36.98,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "(Snoring)"
  },
  {
   "i": 11,
   "start": 36.98,
   "end": 37.74,
   "kind": "direction",
   "speaker": null,
   "text": "Sweeper hits a bump"
  },
  {
   "i": 12,
   "start": 38.24,
   "end": 42.4,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Ow, oh GAHHHhhhh...!"
  },
  {
   "i": 13,
   "start": 41.2,
   "end": 42.4,
   "kind": "direction",
   "speaker": null,
   "text": "♪ Cha-La Head-Cha-La ♪"
  },
  {
   "i": 14,
   "start": 42.4,
   "end": 43.14,
   "kind": "direction",
   "speaker": null,
   "text": "Japanese Transliteration (English)"
  },
  {
   "i": 15,
   "start": 43.14,
   "end": 45.76,
   "kind": "dialog",
   "speaker": null,
   "text": "CHA-LA HEAD-CHA-LA CHARA HECCHARA (Cha-La Head-Cha-La)"
  },
  {
   "i": 16,
   "start": 46.52,
   "end": 50.24,
   "kind": "dialog",
   "speaker": null,
   "text": "笑顔ウルトラZで Egao urutora zetto de (With a smile that's Ultra-Z,)"
  },
  {
   "i": 17,
   "start": 50.24,
   "end": 53.5,
   "kind": "dialog",
   "speaker": null,
   "text": "今日もアイヤイヤイヤイヤイ Kyô mo ai-yai-yai-yai-yai (Even today goes Aye-yi-yi-yi-yi)"
  },
  {
   "i": 18,
   "start": 53.5,
   "end": 55.5,
   "kind": "dialog",
   "speaker": null,
   "text": "Sparking! (Sparking!)"
  },
  {
   "i": 19,
   "start": 59.4,
   "end": 62.34,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "...aaaaaaAAAAAA--!"
  },
  {
   "i": 20,
   "start": 62.34,
   "end": 63.84,
   "kind": "direction",
   "speaker": null,
   "text": "Crash"
  },
  {
   "i": 21,
   "start": 64.74,
   "end": 66.38,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Owwwww-hohh..."
  },
  {
   "i": 22,
   "start": 66.7,
   "end": 71.12,
   "kind": "dialog",
   "speaker": "Goz",
   "text": "Ah, who do we have here? A little girly man, ja?"
  },
  {
   "i": 23,
   "start": 71.52,
   "end": 73.32,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "I'm Goku. Who are you?"
  },
  {
   "i": 24,
   "start": 73.32,
   "end": 74.44,
   "kind": "dialog",
   "speaker": "Goz",
   "text": "I am Goz,"
  },
  {
   "i": 25,
   "start": 74.44,
   "end": 75.58,
   "kind": "dialog",
   "speaker": "Mez",
   "text": "Und I am Mez,"
  },
  {
   "i": 26,
   "start": 75.58,
   "end": 78.74,
   "kind": "dialog",
   "speaker": "Goz",
   "text": "Und we are here to pump... you up!"
  },
  {
   "i": 27,
   "start": 75.58,
   "end": 78.74,
   "kind": "dialog",
   "speaker": "Mez",
   "text": "Und we are here to pump... you up!"
  },
  {
   "i": 28,
   "start": 77.14,
   "end": 77.68,
   "kind": "sfx",
   "speaker": null,
   "text": "CLAP"
  },
  {
   "i": 29,
   "start": 79.36,
   "end": 81.6,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "...Okay… but I'm sorta--"
  },
  {
   "i": 30,
   "start": 81.6,
   "end": 84.3,
   "kind": "dialog",
   "speaker": "Goz",
   "text": "First, we are going to do a hundred squats!"
  },
  {
   "i": 31,
   "start": 84.3,
   "end": 86.14,
   "kind": "dialog",
   "speaker": "Mez",
   "text": "And then lots of push-ups on the hard ground!"
  },
  {
   "i": 32,
   "start": 86.14,
   "end": 88.28,
   "kind": "dialog",
   "speaker": "Goz",
   "text": "Und then a bunch of Jumping Jacks!"
  },
  {
   "i": 33,
   "start": 88.28,
   "end": 89.72,
   "kind": "dialog",
   "speaker": "Goz",
   "text": "Oooooooooh!"
  },
  {
   "i": 34,
   "start": 90.0,
   "end": 92.28,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "That... sounds like fun...?"
  },
  {
   "i": 35,
   "start": 92.28,
   "end": 94.1,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "But I’m sort of in a hurry...?"
  },
  {
   "i": 36,
   "start": 94.1,
   "end": 95.32,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "How do I get out of here?"
  },
  {
   "i": 37,
   "start": 95.42,
   "end": 97.36,
   "kind": "dialog",
   "speaker": "Mez",
   "text": "Ach, there’s no way out of here."
  },
  {
   "i": 38,
   "start": 97.36,
   "end": 100.42,
   "kind": "dialog",
   "speaker": "Mez",
   "text": "Unless you manage to beat us in a test of strength and speed!"
  },
  {
   "i": 39,
   "start": 100.42,
   "end": 103.9,
   "kind": "dialog",
   "speaker": "Goz",
   "text": "Ja! Lots of running und wrestling und sweat!"
  },
  {
   "i": 40,
   "start": 103.9,
   "end": 106.58,
   "kind": "dialog",
   "speaker": "Mez",
   "text": "Grappling each other on the cold ground, ja!"
  },
  {
   "i": 41,
   "start": 107.44,
   "end": 112.64,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Okay, now let’s say we went through all of that... then where would you say the exit is?"
  },
  {
   "i": 42,
   "start": 112.64,
   "end": 114.22,
   "kind": "dialog",
   "speaker": "Goz",
   "text": "Oh, it’s right over there."
  },
  {
   "i": 43,
   "start": 114.22,
   "end": 115.7,
   "kind": "dialog",
   "speaker": "Mez",
   "text": "Ja, but you have to beat us first un--"
  },
  {
   "i": 44,
   "start": 115.7,
   "end": 117.12,
   "kind": "dialog",
   "speaker": "Mez",
   "text": "Ach! He’s running avay!"
  },
  {
   "i": 45,
   "start": 117.62,
   "end": 122.54,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Oh, before I go... Have you seen my brother Raditz around here? Spiky hair? Tail?"
  },
  {
   "i": 46,
   "start": 122.72,
   "end": 125.76,
   "kind": "dialog",
   "speaker": "Mez",
   "text": "Ach, yes; he made a horrible mess of the blood fountain!"
  },
  {
   "i": 47,
   "start": 126.34,
   "end": 127.42,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Looks fine to me."
  },
  {
   "i": 48,
   "start": 127.52,
   "end": 128.94,
   "kind": "dialog",
   "speaker": "Goz",
   "text": "IT USED TO BE WATER!"
  },
  {
   "i": 49,
   "start": 129.44,
   "end": 130.38,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Wow...!"
  },
  {
   "i": 50,
   "start": 130.74,
   "end": 133.82,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Well, I’m going now! By the way, thanks for the fruit!"
  },
  {
   "i": 51,
   "start": 133.82,
   "end": 137.82,
   "kind": "dialog",
   "speaker": "Mez",
   "text": "Ach, he has a piece of the fruit, ach nein! Don’t eat the fruit, don’t eat the fruit!"
  },
  {
   "i": 52,
   "start": 137.82,
   "end": 138.32,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Bye!"
  },
  {
   "i": 53,
   "start": 138.7,
   "end": 143.08,
   "kind": "dialog",
   "speaker": "Goz",
   "text": "No, now we can’t make the fruit salad for King Yemma’s barbecue!"
  },
  {
   "i": 54,
   "start": 143.08,
   "end": 148.16,
   "kind": "dialog",
   "speaker": "Mez",
   "text": "Ja, und Dabura is going to bring something totally kickass und we will have nothing und we will LOOK LIKE FOOLS!"
  },
  {
   "i": 55,
   "start": 148.16,
   "end": 150.08,
   "kind": "dialog",
   "speaker": "Goz",
   "text": "Ach, I am so mad!"
  },
  {
   "i": 56,
   "start": 150.08,
   "end": 153.74,
   "kind": "dialog",
   "speaker": "Mez",
   "text": "Ja, let us go work off our stress by doing squat thrusts und stretches."
  },
  {
   "i": 57,
   "start": 153.94,
   "end": 156.94,
   "kind": "dialog",
   "speaker": "Goz",
   "text": "Ja, und then we’ll do grappling in our speedos."
  },
  {
   "i": 58,
   "start": 156.94,
   "end": 158.38,
   "kind": "dialog",
   "speaker": "Mez",
   "text": "I’ll grab the oil!"
  },
  {
   "i": 59,
   "start": 158.78,
   "end": 160.5,
   "kind": "dialog",
   "speaker": "Narrator",
   "text": "Meanwhile, back on Earth..."
  },
  {
   "i": 60,
   "start": 160.5,
   "end": 163.66,
   "kind": "dialog",
   "speaker": "Narrator",
   "text": "Now that’s *got* to be some kind of innuendo!"
  },
  {
   "i": 61,
   "start": 163.82,
   "end": 167.44,
   "kind": "direction",
   "speaker": null,
   "text": "Wolf howling"
  },
  {
   "i": 62,
   "start": 163.82,
   "end": 167.44,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "Huh? (Whimpering)"
  },
  {
   "i": 63,
   "start": 167.44,
   "end": 170.46,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "I can’t believe Piccolo left me out here all alone!"
  },
  {
   "i": 64,
   "start": 170.68,
   "end": 173.16,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "How am I supposed to get down from here?"
  },
  {
   "i": 65,
   "start": 173.46,
   "end": 176.32,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "CLIIIIMB DOWWWN!"
  },
  {
   "i": 66,
   "start": 176.62,
   "end": 179.04,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "I can’t even get any food or water."
  },
  {
   "i": 67,
   "start": 179.44,
   "end": 181.02,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "What should I do?"
  },
  {
   "i": 68,
   "start": 181.4,
   "end": 184.74,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "I SAID, CLIIIMB DOWWWN!"
  },
  {
   "i": 69,
   "start": 185.1,
   "end": 188.16,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "If only I had some sticks or reeds lying around."
  },
  {
   "i": 70,
   "start": 188.42,
   "end": 191.14,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "I could make a makeshift ladder, or a rope..."
  },
  {
   "i": 71,
   "start": 191.34,
   "end": 194.52,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "UUUUURRRRRAAARRRGH!!"
  },
  {
   "i": 72,
   "start": 199.12,
   "end": 201.54,
   "kind": "dialog",
   "speaker": "Kami",
   "text": "You have all come to train on my Lookout."
  },
  {
   "i": 73,
   "start": 201.54,
   "end": 206.56,
   "kind": "dialog",
   "speaker": "Kami",
   "text": "But since I am quite old, I shall leave you in the capable hands of Mr. Popo."
  },
  {
   "i": 74,
   "start": 206.88,
   "end": 209.84,
   "kind": "dialog",
   "speaker": "Kami",
   "text": "Mr. Popo, you know what to do."
  },
  {
   "i": 75,
   "start": 209.96,
   "end": 210.92,
   "kind": "dialog",
   "speaker": "Mr. Popo",
   "text": "Yes, Kami."
  },
  {
   "i": 76,
   "start": 211.5,
   "end": 213.16,
   "kind": "direction",
   "speaker": null,
   "text": "Door shuts"
  },
  {
   "i": 77,
   "start": 213.88,
   "end": 218.06,
   "kind": "dialog",
   "speaker": "Mr. Popo",
   "text": "Alright, *maggots*, listen up! Popo’s 'bout to teach you the pecking order!"
  },
  {
   "i": 78,
   "start": 218.26,
   "end": 227.22,
   "kind": "dialog",
   "speaker": "Mr. Popo",
   "text": "It goes you... the dirt... the worms inside of the dirt... Popo's *stool*... Kami... then Popo."
  },
  {
   "i": 79,
   "start": 227.68,
   "end": 228.94,
   "kind": "dialog",
   "speaker": "Mr. Popo",
   "text": "Any questions?"
  },
  {
   "i": 80,
   "start": 228.94,
   "end": 230.0,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Um, yeah, I--"
  },
  {
   "i": 81,
   "start": 230.0,
   "end": 230.5,
   "kind": "sfx",
   "speaker": null,
   "text": "SLAM"
  },
  {
   "i": 82,
   "start": 230.0,
   "end": 233.64,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "GOH-GAAAAAAAaaaaaahhh...!"
  },
  {
   "i": 83,
   "start": 233.92,
   "end": 234.54,
   "kind": "sfx",
   "speaker": null,
   "text": "DING"
  },
  {
   "i": 84,
   "start": 235.4,
   "end": 237.94,
   "kind": "dialog",
   "speaker": "Mr. Popo",
   "text": "Enjoy the climb back up, BITCH!"
  },
  {
   "i": 85,
   "start": 238.5,
   "end": 240.1,
   "kind": "dialog",
   "speaker": "Mr. Popo",
   "text": "Now any more questions?"
  },
  {
   "i": 86,
   "start": 241.18,
   "end": 243.34,
   "kind": "dialog",
   "speaker": "Mr. Popo",
   "text": "Good. Then we can begin."
  },
  {
   "i": 87,
   "start": 244.3,
   "end": 248.64,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Okay! No more diversions! This is really important! No more sidetra—!"
  },
  {
   "i": 88,
   "start": 248.64,
   "end": 249.7,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Oooh, a house!"
  },
  {
   "i": 89,
   "start": 249.98,
   "end": 251.04,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "'Is that a snake?'"
  },
  {
   "i": 90,
   "start": 251.04,
   "end": 251.72,
   "kind": "direction",
   "speaker": null,
   "text": "Sucks"
  },
  {
   "i": 91,
   "start": 251.04,
   "end": 251.72,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Ahhh--!"
  },
  {
   "i": 92,
   "start": 251.72,
   "end": 252.22,
   "kind": "dialog",
   "speaker": "Snake",
   "text": "Ackum!"
  },
  {
   "i": 93,
   "start": 252.44,
   "end": 255.24,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Wheeeeeee--!"
  },
  {
   "i": 94,
   "start": 255.24,
   "end": 255.74,
   "kind": "direction",
   "speaker": null,
   "text": "Thud"
  },
  {
   "i": 95,
   "start": 255.24,
   "end": 258.3,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "AUGHA OWWWWhowww!"
  },
  {
   "i": 96,
   "start": 259.96,
   "end": 261.06,
   "kind": "direction",
   "speaker": null,
   "text": "Metal Gear Solid Codec alert sound"
  },
  {
   "i": 97,
   "start": 262.6,
   "end": 263.58,
   "kind": "dialog",
   "speaker": "Servant",
   "text": "(Speaking)"
  },
  {
   "i": 98,
   "start": 264.92,
   "end": 266.34,
   "kind": "dialog",
   "speaker": "Princess Snake",
   "text": "(Speaking as Solid Snake)"
  },
  {
   "i": 99,
   "start": 270.94,
   "end": 274.86,
   "kind": "dialog",
   "speaker": "Princess Snake",
   "text": "Well, he’s quite the hunk of man-meat! But what’s with the hair??"
  },
  {
   "i": 100,
   "start": 276.64,
   "end": 278.88,
   "kind": "dialog",
   "speaker": "Princess Snake",
   "text": "'Ah, I just love this fur coat!'"
  },
  {
   "i": 101,
   "start": 278.88,
   "end": 282.0,
   "kind": "dialog",
   "speaker": "Princess Snake",
   "text": "'Especially since I killed all the animals for it myself!'"
  },
  {
   "i": 102,
   "start": 282.0,
   "end": 284.6,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Huh? You don’t look like you'd be King Kai."
  },
  {
   "i": 103,
   "start": 284.6,
   "end": 287.72,
   "kind": "dialog",
   "speaker": "Princess Snake",
   "text": "What, did my magnificent breasts tip you off?"
  },
  {
   "i": 104,
   "start": 287.72,
   "end": 288.78,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Wh-what?"
  },
  {
   "i": 105,
   "start": 288.78,
   "end": 290.6,
   "kind": "dialog",
   "speaker": "Princess Snake",
   "text": "Nothing. Are you hungry?"
  },
  {
   "i": 106,
   "start": 290.6,
   "end": 292.9,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Yeah! I could eat anything right now!"
  },
  {
   "i": 107,
   "start": 292.9,
   "end": 294.36,
   "kind": "dialog",
   "speaker": "Princess Snake",
   "text": "Ah, me too."
  },
  {
   "i": 108,
   "start": 294.46,
   "end": 294.94,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "What?"
  },
  {
   "i": 109,
   "start": 294.94,
   "end": 296.48,
   "kind": "dialog",
   "speaker": "Princess Snake",
   "text": "Nothing! Take a seat!"
  },
  {
