   "speaker": "Clem",
   "text": "Aw, dammit Mitch, put that away!"
  },
  {
   "i": 114,
   "start": 343.98,
   "end": 346.28,
   "kind": "dialog",
   "speaker": "Trunks",
   "text": "'I can't believe he's taking them on alone!'"
  },
  {
   "i": 115,
   "start": 346.52,
   "end": 349.88,
   "kind": "dialog",
   "speaker": "Trunks",
   "text": "'He has no idea the kind of destructive force they pack!'"
  },
  {
   "i": 116,
   "start": 350.22,
   "end": 352.7,
   "kind": "dialog",
   "speaker": "Trunks",
   "text": "'The Androids are humanity's greatest threat!'"
  },
  {
