{
 "item": "e43",
 "show": "dbza",
 "youtube": "dcHIikdrhjQ",
 "title": "Episode 39",
 "duration": 608,
 "lines": [
  {
   "i": 0,
   "start": 14.14,
   "end": 14.98,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "AAAGH...!"
  },
  {
   "i": 1,
   "start": 14.98,
   "end": 15.9,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "AARGH...!"
  },
  {
   "i": 2,
   "start": 15.9,
   "end": 16.82,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "ERRGH...!"
  },
  {
   "i": 3,
   "start": 19.2,
   "end": 19.7,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Hmph..."
  },
  {
   "i": 4,
   "start": 24.66,
   "end": 25.84,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "...So does this mean they're on our side--?"
  },
  {
   "i": 5,
   "start": 25.84,
   "end": 28.48,
   "kind": "dialog",
   "speaker": "Trunks",
   "text": "YAAAAAAAAH!!"
  },
  {
   "i": 6,
   "start": 27.24,
   "end": 28.48,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "AAAAGH!!"
  },
  {
   "i": 7,
   "start": 54.9,
   "end": 58.48,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Well, that settles that. You're *definitely* Vegeta's kid."
  },
  {
   "i": 8,
   "start": 59.14,
   "end": 61.48,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "So, you done throwing a hissy fit?"
  },
  {
   "i": 9,
   "start": 61.48,
   "end": 65.3,
   "kind": "dialog",
   "speaker": "Trunks",
   "text": "At least I did something instead of just standing there, staring at them!"
  },
  {
   "i": 10,
   "start": 65.3,
   "end": 67.0,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "We do do that a lot!"
  },
  {
   "i": 11,
   "start": 68.08,
   "end": 69.84,
   "kind": "dialog",
   "speaker": "Trunks",
   "text": "What? They're still alive?!"
  },
  {
   "i": 12,
   "start": 70.22,
   "end": 72.44,
   "kind": "dialog",
   "speaker": "Trunks",
   "text": "But that was my strongest blast..."
  },
  {
   "i": 13,
   "start": 72.44,
   "end": 74.86,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "So you just *assumed* they were destroyed, then?"
  },
  {
   "i": 14,
   "start": 74.86,
   "end": 76.16,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "We do that a lot, too!"
  },
  {
   "i": 15,
   "start": 76.16,
   "end": 79.72,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Besides, what exactly changed from you in the future and now?"
  },
  {
   "i": 16,
   "start": 80.24,
   "end": 82.68,
   "kind": "dialog",
   "speaker": "Trunks",
   "text": "More than I thought; less than you'd think."
  },
  {
   "i": 17,
   "start": 83.0,
   "end": 87.76,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Man, Mystery Kid up there sure is cranky. I think someone needs a nap."
  },
  {
   "i": 18,
   "start": 87.76,
   "end": 88.44,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "Whatever."
  },
  {
   "i": 19,
   "start": 89.52,
   "end": 91.6,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "Let's just pop this bad boy open."
  },
  {
   "i": 20,
   "start": 91.1,
   "end": 91.6,
   "kind": "sfx",
   "speaker": null,
   "text": "BEEP"
  },
  {
   "i": 21,
   "start": 92.44,
   "end": 96.7,
   "kind": "dialog",
   "speaker": "Pod",
   "text": "Initializing update 1 of 1432--"
  },
  {
   "i": 22,
   "start": 96.7,
   "end": 97.7,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "Yeah, screw that."
  },
  {
   "i": 23,
   "start": 111.02,
   "end": 113.56,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Man, you are a tall bastard."
  },
  {
   "i": 24,
   "start": 113.56,
   "end": 115.5,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "So, fire-crotch, what's your name?"
  },
  {
   "i": 25,
   "start": 115.5,
   "end": 118.84,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "I am designated as Android 16."
  },
  {
   "i": 26,
   "start": 118.84,
   "end": 120.04,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "What are the odds?"
  },
  {
   "i": 27,
   "start": 120.04,
   "end": 122.62,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "The old man did always have a one-track mind."
  },
  {
   "i": 28,
   "start": 122.62,
   "end": 123.74,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "What's your deal?"
  },
  {
   "i": 29,
   "start": 123.74,
   "end": 127.76,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "I am programmed with the sole purpose of murdering Son Goku."
  },
  {
   "i": 30,
   "start": 127.76,
   "end": 129.4,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "See? This is what I'm talking about."
  },
  {
   "i": 31,
   "start": 129.4,
   "end": 131.0,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "I'm glad I killed him."
  },
  {
   "i": 32,
   "start": 131.0,
   "end": 132.78,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "You killed Son Goku?"
  },
  {
   "i": 33,
   "start": 132.78,
   "end": 134.36,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "No; Doctor Gero."
  },
  {
   "i": 34,
   "start": 134.56,
   "end": 135.18,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "Oh."
  },
  {
   "i": 35,
   "start": 135.9,
   "end": 138.1,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "...May we go and murder Son Goku?"
  },
  {
   "i": 36,
   "start": 138.18,
   "end": 140.1,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Well, ain't got nothin' better to do."
  },
  {
   "i": 37,
   "start": 140.1,
   "end": 142.98,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "So, if the name of the game is, \"Kill Son Goku\"..."
  },
  {
   "i": 38,
   "start": 142.98,
   "end": 144.06,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Let's play."
  },
  {
   "i": 39,
   "start": 148.38,
   "end": 150.44,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Hey, we should grab us a car."
  },
  {
   "i": 40,
   "start": 150.62,
   "end": 152.08,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "The hell do we need a car?"
  },
  {
   "i": 41,
   "start": 152.08,
   "end": 153.6,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Because I want one."
  },
  {
   "i": 42,
   "start": 154.14,
   "end": 156.52,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Are... Are they flying away?!"
  },
  {
   "i": 43,
   "start": 156.86,
   "end": 161.12,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "*Get back here*! I AM SICK AND TIRED OF *BEING IGNORED*!"
  },
  {
   "i": 44,
   "start": 161.12,
   "end": 162.94,
   "kind": "dialog",
   "speaker": "Tien",
   "text": "I *wish* we could ignore you."
  },
  {
   "i": 45,
   "start": 162.94,
   "end": 163.84,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "RARRGH!"
  },
  {
   "i": 46,
   "start": 163.84,
   "end": 165.22,
   "kind": "dialog",
   "speaker": "Trunks",
   "text": "No, Dad, stop!"
  },
  {
   "i": 47,
   "start": 165.22,
   "end": 167.3,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Are we *really* doing this again?"
  },
  {
   "i": 48,
   "start": 167.3,
   "end": 171.72,
   "kind": "dialog",
   "speaker": "Trunks",
   "text": "I wish you'd understand. There's no way we can fight them without Goku!"
  },
  {
   "i": 49,
   "start": 171.72,
   "end": 174.48,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "And I wish YOU'D understand who you're talking to!"
  },
  {
   "i": 50,
   "start": 174.48,
   "end": 176.1,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "*I am Vegeta*!"
  },
  {
   "i": 51,
   "start": 176.44,
   "end": 179.06,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Why would I ever need that gibbering fool's help?!"
  },
  {
   "i": 52,
   "start": 179.06,
   "end": 181.46,
   "kind": "dialog",
   "speaker": "Trunks",
   "text": "Because you're not as *strong* as--!"
  },
  {
   "i": 53,
   "start": 181.6,
   "end": 183.6,
   "kind": "dialog",
   "speaker": "Trunks",
   "text": "(Wheeze)"
  },
  {
   "i": 54,
   "start": 188.14,
   "end": 189.68,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "You pushed the Goku button."
  },
  {
   "i": 55,
   "start": 190.3,
   "end": 191.62,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "You shouldn't'a did that."
  },
  {
   "i": 56,
   "start": 192.12,
   "end": 195.78,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "(Screaming endlessly)"
  },
  {
   "i": 57,
   "start": 195.78,
   "end": 198.34,
   "kind": "dialog",
   "speaker": "Yamcha",
   "text": "Uh, Chi-Chi? You might wanna come in here!"
  },
  {
   "i": 58,
   "start": 198.6,
   "end": 201.2,
   "kind": "dialog",
   "speaker": "Chi-Chi",
   "text": "Sorry, hun, cooking up a storm in here!"
  },
  {
   "i": 59,
   "start": 201.2,
   "end": 202.84,
   "kind": "dialog",
   "speaker": "Yamcha",
   "text": "This is looking kinda bad!"
  },
  {
   "i": 60,
   "start": 203.02,
   "end": 204.96,
   "kind": "dialog",
   "speaker": "Yamcha",
   "text": "He's screaming up a lot of blood."
  },
  {
   "i": 61,
   "start": 205.06,
   "end": 208.08,
   "kind": "dialog",
   "speaker": "Chi-Chi",
   "text": "I'll make sure there's plenty of iron and protein in the meal!"
  },
  {
   "i": 62,
   "start": 208.4,
   "end": 211.06,
   "kind": "dialog",
   "speaker": "Yamcha",
   "text": "And I can't really remember the last time he inhaled."
  },
  {
   "i": 63,
   "start": 211.36,
   "end": 214.32,
   "kind": "dialog",
   "speaker": "Yamcha",
   "text": "And while that's sort of impressive, I don't think it's healthy."
  },
  {
   "i": 64,
   "start": 214.6,
   "end": 217.56,
   "kind": "dialog",
   "speaker": "Yamcha",
   "text": "Goku doesn't have a ton of brain cells to work with as it is."
  },
  {
   "i": 65,
   "start": 217.56,
   "end": 221.1,
   "kind": "dialog",
   "speaker": "Chi-Chi",
   "text": "Look, to be honest, it's just nice to have him in the house for a change."
  },
  {
   "i": 66,
   "start": 221.92,
   "end": 222.56,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "(Stops screaming)"
  },
  {
   "i": 67,
   "start": 222.56,
   "end": 224.06,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "(Deep inhalation)"
  },
  {
   "i": 68,
   "start": 224.06,
   "end": 224.86,
   "kind": "dialog",
   "speaker": "Yamcha",
   "text": "Oh good, he took a br--"
  },
  {
   "i": 69,
   "start": 224.86,
   "end": 226.72,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "(Screaming endlessly)"
  },
  {
   "i": 70,
   "start": 232.18,
   "end": 237.3,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Alright, here's my idea: First car that comes our way? We... appropriate it."
  },
  {
   "i": 71,
   "start": 237.3,
   "end": 239.56,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "Ugh, and all the way out here in the boonies."
  },
  {
   "i": 72,
   "start": 239.56,
   "end": 241.08,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "It's probably gonna be a semi."
  },
  {
   "i": 73,
   "start": 241.08,
   "end": 243.14,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "(Gasp) Oh, I hope it's a truck!"
  },
  {
   "i": 74,
   "start": 243.44,
   "end": 244.64,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "What do you think, Sixteen?"
  },
  {
   "i": 75,
   "start": 244.64,
   "end": 247.12,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "Will it assist us in murdering Son Goku?"
  },
  {
   "i": 76,
   "start": 247.12,
   "end": 249.52,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "I dunno, I guess you could hit him pretty hard with it."
  },
  {
   "i": 77,
   "start": 249.64,
   "end": 251.74,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "Then I, too, hope it is a truck."
  },
  {
   "i": 78,
   "start": 252.12,
   "end": 253.78,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Well, well, well..."
  },
  {
   "i": 79,
   "start": 253.78,
   "end": 257.44,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "If it isn't Faggoty Andy and On-The-Raggedy Ann."
  },
  {
   "i": 80,
   "start": 258.38,
   "end": 259.66,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "...I'm going to break his arm."
  },
  {
   "i": 81,
   "start": 259.66,
   "end": 261.72,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Kinda proving his point, ain't ya, sis?"
  },
  {
   "i": 82,
   "start": 261.72,
   "end": 262.72,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "Shut up, Ann."
  },
  {
   "i": 83,
   "start": 262.72,
   "end": 267.22,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "So, which of you children wants to tangle with the Saiyan elite?"
  },
  {
   "i": 84,
   "start": 267.48,
   "end": 270.04,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Neh, I dunno. How 'bout you, Sixteen?"
  },
  {
   "i": 85,
   "start": 270.04,
   "end": 272.3,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "No. He is not Goku."
  },
  {
   "i": 86,
   "start": 272.3,
   "end": 274.46,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Man, we need to get you a hobby."
  },
  {
   "i": 87,
   "start": 274.46,
   "end": 275.62,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "Acquiring hobby."
  },
  {
   "i": 88,
   "start": 278.68,
   "end": 279.44,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "Hmm..."
  },
  {
   "i": 89,
   "start": 279.68,
   "end": 283.52,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Well then, Eighteen, guess he's all yours. I'm on car watching duty."
  },
  {
   "i": 90,
   "start": 283.52,
   "end": 286.1,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "Oh, thanks. Make me fight the troll doll."
  },
  {
   "i": 91,
   "start": 286.26,
   "end": 287.94,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "So ladies first, then?"
  },
  {
   "i": 92,
   "start": 288.18,
   "end": 292.16,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Well, just to warn you - I'm not afraid to hit a woman."
  },
  {
   "i": 93,
   "start": 292.3,
   "end": 294.52,
   "kind": "dialog",
   "speaker": "Android 18",
   "text": "That's fine. Neither am I."
  },
  {
   "i": 94,
   "start": 300.36,
   "end": 302.82,
   "kind": "direction",
   "speaker": null,
   "text": "Birds chirping"
  },
  {
   "i": 95,
   "start": 302.82,
   "end": 303.86,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "Aww..."
  },
  {
   "i": 96,
   "start": 304.1,
   "end": 307.58,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Hey, so, was Vegeta always blonde, or..."
  },
  {
   "i": 97,
   "start": 307.58,
   "end": 309.12,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "The birds flew away."
  },
  {
   "i": 98,
   "start": 309.12,
   "end": 309.8,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Oh yeah?"
  },
  {
   "i": 99,
   "start": 310.06,
   "end": 312.18,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "I *liked* the birds."
  },
  {
   "i": 100,
   "start": 312.46,
   "end": 313.66,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Good for you, man."
  },
  {
   "i": 101,
   "start": 313.78,
   "end": 314.28,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Raagh!"
  },
  {
   "i": 102,
   "start": 316.2,
   "end": 317.82,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Ha! First blood."
  },
  {
   "i": 103,
   "start": 317.82,
   "end": 319.56,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "You may as well give up now, an--"
  },
  {
   "i": 104,
   "start": 320.28,
   "end": 322.08,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "God damn it, I was kidding!"
  },
  {
   "i": 105,
   "start": 327.28,
   "end": 327.86,
   "kind": "direction",
   "speaker": null,
   "text": "Thump, thump!"
  },
  {
   "i": 106,
   "start": 327.86,
   "end": 328.36,
   "kind": "dialog",
   "speaker": "Clem",
   "text": "Huh?"
  },
  {
   "i": 107,
   "start": 328.84,
   "end": 329.88,
   "kind": "dialog",
   "speaker": "Mitch",
   "text": "What is it, Clem?"
  },
  {
   "i": 108,
   "start": 330.16,
   "end": 331.86,
   "kind": "dialog",
   "speaker": "Clem",
   "text": "Well, you ain't gonna believe this..."
  },
  {
   "i": 109,
   "start": 332.12,
   "end": 335.2,
   "kind": "dialog",
   "speaker": "Clem",
   "text": "A couple a' Europeans are fightin' on top of the truck!"
  },
  {
   "i": 110,
   "start": 335.52,
   "end": 337.24,
   "kind": "dialog",
   "speaker": "Mitch",
   "text": "Huh. That IS weird."
  },
  {
   "i": 111,
   "start": 337.9,
   "end": 339.12,
   "kind": "dialog",
   "speaker": "Mitch",
   "text": "...You know what also's weird?"
  },
  {
   "i": 112,
   "start": 339.12,
