   "i": 153,
   "start": 436.36,
   "end": 436.86,
   "kind": "dialog",
   "speaker": "Android 16",
   "text": "No."
  },
  {
   "i": 154,
   "start": 436.96,
   "end": 437.8,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Whatever, man."
  },
  {
   "i": 155,
   "start": 438.26,
   "end": 440.76,
   "kind": "dialog",
   "speaker": "Trunks",
   "text": "Father! Oh, thank God you're still alive."
  },
  {
   "i": 156,
   "start": 440.76,
   "end": 442.36,
   "kind": "dialog",
   "speaker": "Trunks",
   "text": "We have to get out of here now!"
  },
  {
   "i": 157,
   "start": 442.36,
   "end": 445.6,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Are you kidding me? I have her right where I want her!"
  },
  {
   "i": 158,
   "start": 445.84,
   "end": 448.06,
   "kind": "dialog",
   "speaker": "Trunks",
   "text": "Do you... live in your own little world??"
  },
  {
   "i": 159,
   "start": 448.2,
   "end": 451.7,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Yes. But unfortunately, I have to share it with all of you."
  },
  {
   "i": 160,
   "start": 451.7,
   "end": 454.26,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "Actually, Vegeta, you don't have to share at all."
  },
  {
   "i": 161,
   "start": 454.52,
   "end": 465.3,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "You two seem like you're having fun, so I'd hate to have to interrupt, but if any of you decide to jump in and help MC Widow's Peak over there, I will personally introduce you to the ground."
  },
  {
   "i": 162,
   "start": 465.56,
   "end": 468.9,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "And trust me, your relationship will be intimate."
