   "start": 483.72,
   "end": 484.78,
   "kind": "dialog",
   "speaker": "Android 17",
   "text": "He likes birds now."
  },
  {
   "i": 171,
   "start": 484.78,
   "end": 488.04,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Can we stop talking about Kakarot for just a MINUTE?!"
  },
  {
   "i": 172,
   "start": 488.04,
   "end": 490.68,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "I mean, for God's sakes, he's never even around!"
  },
  {
   "i": 173,
   "start": 490.78,
   "end": 493.06,
   "kind": "dialog",
   "speaker": "Piccolo",
   "text": "Sad thing is, he's not exactly wrong."
  },
  {
   "i": 174,
   "start": 493.26,
   "end": 497.74,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Now if you'd like to continue this fight, I can finally get around to disassembling you!"
