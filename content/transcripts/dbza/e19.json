   "end": 16.86,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Finally! I've gathered all seven Dragon Balls!"
  },
  {
   "i": 2,
   "start": 17.68,
   "end": 20.46,
   "kind": "dialog",
   "speaker": "Shenron",
   "text": "State your wish."
  },
  {
   "i": 3,
   "start": 21.06,
   "end": 24.2,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Dragon! Grant me immortality!"
  },
  {
   "i": 4,
   "start": 24.5,
   "end": 28.16,
   "kind": "dialog",
   "speaker": "Shenron",
   "text": "Your wish is granted."
  },
  {
   "i": 5,
   "start": 29.2,
   "end": 30.7,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Yes! I've done it!"
  },
  {
   "i": 6,
   "start": 30.7,
   "end": 33.78,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "I'm finally the strongest in all the Universe!"
  },
  {
   "i": 7,
   "start": 34.16,
   "end": 36.42,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "WAH HA-HA-HA-HA-HA-HA-HA-HA! >XD"
  },
  {
   "i": 8,
   "start": 37.02,
   "end": 39.64,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "I am unstoppable..."
  },
  {
   "i": 9,
   "start": 39.72,
   "end": 42.62,
   "kind": "dialog",
   "speaker": "Zarbon",
   "text": "Oh, how cute. He's having a little dream."
  },
  {
   "i": 10,
   "start": 42.8,
   "end": 45.3,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Mine! Mine! Mine! Mine! Mine!"
  },
  {
   "i": 11,
   "start": 45.48,
   "end": 47.36,
   "kind": "dialog",
   "speaker": "Zarbon",
   "text": "Now, let's get you back to Lord Freeza."
  },
  {
   "i": 12,
   "start": 47.6,
   "end": 50.58,
   "kind": "dialog",
   "speaker": "Zarbon",
   "text": "I need to... probe you for the information."
  },
  {
   "i": 13,
   "start": 50.94,
   "end": 53.44,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "My power is maximum..."
  },
