  },
  {
   "i": 224,
   "start": 520.12,
   "end": 520.72,
   "kind": "dialog",
   "speaker": "Bulma",
   "text": "Yeah."
  },
  {
   "i": 225,
   "start": 520.9,
   "end": 521.88,
   "kind": "dialog",
   "speaker": "Bulma",
   "text": "What's the big deal?"
  },
  {
   "i": 226,
   "start": 521.96,
   "end": 525.4,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Do you have ANY idea what Chi-Chi will do to me if he gets hurt?!"
  },
  {
   "i": 227,
   "start": 525.68,
   "end": 527.76,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "I like my penis where it is, thank you."
