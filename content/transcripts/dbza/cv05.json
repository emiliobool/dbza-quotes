{"item": "cv05", "show": "dbza", "youtube": "ca3qvbdFSZk", "title": "Cell Vs Kenshiro", "duration": 98, "lines": [{"i": 0, "start": 4.38, "end": 7.28, "kind": "dialog", "speaker": "Cell", "text": "Oh goody! It's... this guy!"}, {"i": 1, "start": 10.4, "end": 14.78, "kind": "dialog", "speaker": "Cell", "text": "So then, Road Warrior, how can Mr. Perfect Cell help you?"}, {"i": 2, "start": 16.74, "end": 19.4, "kind": "dialog", "speaker": "Cell", "text": "So, a man of few words. I can respect tha--"}, {"i": 3, "start": 19.4, "end": 19.9, "kind": "dialog", "speaker": "Kenshiro", "text": "Hey!"}, {"i": 4, "start": 19.9, "end": 20.84, "kind": "dialog", "speaker": "Cell", "text": "Okay, just cut me off."}, {"i": 5, "start": 20.84, "end": 21.94, "kind": "dialog", "speaker": "Kenshiro", "text": "Bugman."}, {"i": 6, "start": 22.5, "end": 23.58, "kind": "dialog", "speaker": "Cell", "text": "Homeless Man."}, {"i": 7, "start": 23.9, "end": 25.98, "kind": "dialog", "speaker": "Kenshiro", "text": "The meat part of you, your muscles..."}, {"i": 8, "start": 26.38, "end": 29.12, "kind": "dialog", "speaker": "Kenshiro", "text": "Is that bug meat? Or man meat?"}, {"i": 9, "start": 29.66, "end": 33.44, "kind": "dialog", "speaker": "Cell", "text": "Are we talking percentage? Because at LEAST thirty percent if we include--"}, {"i": 10, "start": 33.44, "end": 34.86, "kind": "dialog", "speaker": "Kenshiro", "text": "I don't care for man meat."}, {"i": 11, "start": 35.86, "end": 39.32, "kind": "dialog", "speaker": "Cell", "text": "Look, you clearly got off at the wrong bus stop, so why don't you--"}, {"i": 12, "start": 39.32, "end": 40.7, "kind": "dialog", "speaker": "Kenshiro", "text": "HurrrrRAGH!"}, {"i": 13, "start": 40.7, "end": 42.02, "kind": "dialog", "speaker": "Cell", "text": "Okay, but WHY, though?"}, {"i": 14, "start": 42.02, "end": 43.04, "kind": "dialog", "speaker": "Kenshiro", "text": "Sho!"}, {"i": 15, "start": 43.04, "end": 45.04, "kind": "dialog", "speaker": "Kenshiro", "text": "Rrata-ta-ta-ta-ta-ta-ta-ta-ta-ta"}, {"i": 16, "start": 45.04, "end": 45.94, "kind": "dialog", "speaker": "Kenshiro", "text": "-ta-ta-ta-ta-ta-ta-ta-ta-TAA!!"}, {"i": 17, "start": 45.94, "end": 48.68, "kind": "dialog", "speaker": "Kenshiro", "text": "Atoh! Atoh! Awa-wa-wa-wa-wa."}, {"i": 18, "start": 49.7, "end": 54.54, "kind": "dialog", "speaker": "Cell", "text": "My God, how did you know I was deathly allergic to TICKLING?"}, {"i": 19, "start": 54.54, "end": 55.04, "kind": "sfx", "speaker": null, "text": "Laughing"}, {"i": 20, "start": 55.04, "end": 56.54, "kind": "dialog", "speaker": "Kenshiro", "text": "You're already *dead*."}, {"i": 21, "start": 56.54, "end": 57.64, "kind": "dialog", "speaker": "Cell", "text": "[Still laughing]"}, {"i": 22, "start": 57.78, "end": 58.7, "kind": "sfx", "speaker": null, "text": "Screaming"}, {"i": 23, "start": 66.08, "end": 66.7, "kind": "dialog", "speaker": "Cell", "text": "*AUGH*!"}, {"i": 24, "start": 67.24, "end": 68.3, "kind": "dialog", "speaker": "Cell", "text": "*CHRIST*!"}, {"i": 25, "start": 68.96, "end": 71.56, "kind": "dialog", "speaker": "Cell", "text": "DID ANYONE EVER TELL YOU YOU'RE ALREADY AN ASSHOLE!?"}, {"i": 26, "start": 71.94, "end": 74.18, "kind": "dialog", "speaker": "Kenshiro", "text": "Are you going to... eat that?"}, {"i": 27, "start": 75.94, "end": 77.94, "kind": "dialog", "speaker": "Cell", "text": "No. No, I am not."}, {"i": 28, "start": 78.5, "end": 80.5, "kind": "dialog", "speaker": "Kenshiro", "text": "Well... may I?"}, {"i": 29, "start": 81.24, "end": 84.4, "kind": "dialog", "speaker": "Cell", "text": "Sure... make it your last meal."}, {"i": 30, "start": 84.4, "end": 87.48, "kind": "dialog", "speaker": "Cell", "text": "Because after that, you're *dead*!"}, {"i": 31, "start": 87.78, "end": 89.78, "kind": "dialog", "speaker": "Kenshiro", "text": "No, you are, already."}, {"i": 32, "start": 89.78, "end": 90.66, "kind": "dialog", "speaker": "Kenshiro", "text": "Again."}, {"i": 33, "start": 90.66, "end": 91.42, "kind": "dialog", "speaker": "Cell", "text": "[Screams]"}], "segments": []}