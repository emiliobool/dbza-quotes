 "lines": [
  {
   "i": 0,
   "start": 7.58,
   "end": 9.58,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Aaaaaaaahhhaaa....!"
  },
  {
   "i": 1,
   "start": 9.94,
   "end": 10.44,
   "kind": "direction",
   "speaker": null,
   "text": "Thud"
  },
  {
   "i": 2,
   "start": 11.02,
   "end": 18.32,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "What did I tell you, Kakarot? I'm ten times stronger in this form, while you are beaten and weary!"
  },
  {
   "i": 3,
   "start": 18.32,
   "end": 28.56,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "'Man. This is worse than that time I was in high school, and all the guys called me \"Geeko\", and I was Piccolo's slave, I couldn't get Chi-Chi to like me, and--'"
  },
  {
   "i": 4,
   "start": 28.56,
   "end": 31.2,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Oh, wow. I hit that rock harder than I thought."
  },
  {
   "i": 5,
   "start": 31.98,
   "end": 34.9,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Now, Kakarot... to FINISH THIS!"
  },
  {
   "i": 6,
   "start": 34.9,
   "end": 37.2,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "'Oh, man. What would Yamcha do?'"
  },
  {
   "i": 7,
   "start": 37.6,
   "end": 39.42,
   "kind": "sfx",
   "speaker": null,
   "text": "BOOM"
  },
  {
   "i": 8,
   "start": 40.42,
   "end": 42.6,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "'Um, um... what would Tien do?!'"
  },
  {
   "i": 9,
   "start": 43.14,
   "end": 44.32,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Wait, I know!"
  },
  {
   "i": 10,
   "start": 44.32,
   "end": 46.66,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Prepare to die, Kakarot!"
  },
  {
   "i": 11,
   "start": 46.66,
   "end": 47.78,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Solar Flare!"
  },
  {
   "i": 12,
   "start": 48.44,
   "end": 50.0,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "AAAAAugh!"
  },
  {
   "i": 13,
   "start": 50.36,
   "end": 51.46,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Aaaah!"
  },
  {
   "i": 14,
   "start": 52.92,
   "end": 54.5,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Damn, my eyes!"
  },
  {
   "i": 15,
   "start": 54.5,
   "end": 58.18,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Oh God, it's like walking in on Freeza in the shower!"
  },
  {
   "i": 16,
   "start": 58.58,
   "end": 60.84,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Wait a minute, Freeza's always naked..."
  },
  {
   "i": 17,
   "start": 61.18,
   "end": 62.42,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "GAAAAHHH!!"
  },
  {
   "i": 18,
   "start": 64.22,
   "end": 73.2,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Kakarot, when I find you you're going to die! And not any sort of good death! You’re going to die horribly, terribly, I’m going to eat your--"
  },
  {
   "i": 19,
   "start": 64.22,
   "end": 68.14,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "All right! That should buy me some time, now let's see."
  },
  {
   "i": 20,
   "start": 68.14,
   "end": 73.2,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Planet! Give me your energy -- everything you can spare!"
  },
  {
   "i": 21,
   "start": 73.44,
   "end": 80.04,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Oceans, Forests, People of the planet, and all the animals that live alongside them!"
  },
  {
   "i": 22,
   "start": 75.74,
   "end": 77.26,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "I’m going to hammer you..."
  },
  {
   "i": 23,
   "start": 77.26,
   "end": 81.0,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "(indistinguishable), you're gonna be so *dead*!"
  },
  {
   "i": 24,
   "start": 80.04,
   "end": 83.56,
   "kind": "direction",
   "speaker": null,
   "text": "Energy noises"
  },
  {
   "i": 25,
   "start": 83.56,
   "end": 88.18,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "There! I think I have enough energy... but, maybe a little more wouldn't hurt."
  },
  {
   "i": 26,
   "start": 88.6,
   "end": 90.24,
   "kind": "direction",
   "speaker": null,
   "text": "Deer groans"
  },
  {
   "i": 27,
   "start": 91.72,
   "end": 95.1,
   "kind": "dialog",
   "speaker": "Baby Deer",
   "text": "Daddy?"
  },
  {
   "i": 28,
   "start": 96.78,
   "end": 99.74,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "'All right! That should do it! All finished.'"
  },
  {
   "i": 29,
   "start": 100.38,
   "end": 106.16,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Hurgh, finally, I can see again. Kakarot, I am going to KILL you!"
  },
  {
   "i": 30,
   "start": 106.16,
   "end": 108.02,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Now, take this:"
  },
  {
   "i": 31,
   "start": 108.02,
   "end": 110.5,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Energy from the entire *world*!"
  },
  {
   "i": 32,
   "start": 110.5,
   "end": 111.94,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "HURAAAAAAAAAAAGH!"
  },
  {
   "i": 33,
   "start": 111.94,
   "end": 115.54,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "'Well, if that don't beat all...' AAAAAAAAH!"
  },
  {
   "i": 34,
   "start": 115.54,
   "end": 116.36,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Ugh!"
  },
  {
   "i": 35,
   "start": 118.4,
   "end": 122.54,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Hey, Kakarot, what's the opposite of Christopher Walken?"
  },
  {
   "i": 36,
   "start": 122.74,
   "end": 123.34,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Huh?"
  },
  {
   "i": 37,
   "start": 123.52,
   "end": 125.02,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Christopher Reeves!"
  },
  {
   "i": 38,
   "start": 125.02,
   "end": 125.68,
   "kind": "sfx",
   "speaker": null,
   "text": "POW"
  },
  {
   "i": 39,
   "start": 125.68,
   "end": 128.18,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "AAAAAAAOOWWW!"
  },
  {
   "i": 40,
   "start": 128.18,
   "end": 131.3,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "That was in terrible ta-a-aste...!"
  },
  {
   "i": 41,
   "start": 131.56,
   "end": 136.24,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Don't care; evil! Now, time to crush you like an Arlian."
  },
  {
   "i": 42,
   "start": 136.24,
   "end": 137.78,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "A... what?"
  },
  {
   "i": 43,
   "start": 137.78,
   "end": 140.4,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Exactly! Now die!"
  },
  {
   "i": 44,
   "start": 140.4,
   "end": 141.26,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Huhh!"
  },
  {
   "i": 45,
   "start": 141.26,
   "end": 141.98,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Argh!"
  },
  {
   "i": 46,
   "start": 141.98,
   "end": 143.16,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "AAAAAAAAH!!"
  },
  {
   "i": 47,
   "start": 143.16,
   "end": 145.66,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Again with the f**king eye!"
  },
  {
   "i": 48,
   "start": 145.66,
   "end": 148.16,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "God...dammit!"
  },
  {
   "i": 49,
   "start": 145.66,
   "end": 148.16,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Hah! Now to make my cunning escape."
  },
  {
   "i": 50,
   "start": 149.22,
   "end": 151.22,
   "kind": "direction",
   "speaker": null,
   "text": "Grunts"
  },
  {
   "i": 51,
   "start": 151.66,
   "end": 152.16,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Huh! Hah!"
  },
  {
   "i": 52,
   "start": 152.16,
   "end": 155.12,
   "kind": "direction",
   "speaker": null,
   "text": "More grunting"
  },
  {
   "i": 53,
   "start": 155.92,
   "end": 156.42,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Hah!"
  },
  {
   "i": 54,
   "start": 156.42,
   "end": 157.32,
   "kind": "direction",
   "speaker": null,
   "text": "Smash"
  },
