   "i": 55,
   "start": 157.64,
   "end": 159.76,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Ah, that would be awesome."
  },
  {
   "i": 56,
   "start": 159.76,
   "end": 164.96,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "I've had enough of this. I'm going to crush the life out of you, you insolent little--"
  },
  {
   "i": 57,
   "start": 164.96,
   "end": 168.0,
   "kind": "sfx",
   "speaker": null,
   "text": "CRUNCH"
  },
  {
   "i": 58,
   "start": 164.96,
   "end": 168.0,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "AAAAAAAAAH...!"
  },
  {
   "i": 59,
   "start": 170.5,
   "end": 174.26,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "Krillin, are you sure my Dad's going to be okay all on his own?"
  },
  {
   "i": 60,
   "start": 174.26,
   "end": 178.86,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Oh, come on, Gohan. You saw how much stronger your dad's become. I'm sure he can take care of--"
  },
  {
   "i": 61,
   "start": 178.86,
   "end": 182.78,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "AAAAAAAAAH...!"
  },
  {
   "i": 62,
   "start": 183.68,
   "end": 186.24,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Ah, Jesus Christ Vampire Hunter..."
  },
  {
   "i": 63,
   "start": 186.74,
   "end": 188.3,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "AAAAAAAAAUGH!"
  },
  {
   "i": 64,
   "start": 188.3,
   "end": 191.32,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "All right, Kakarot. Let's hear those bones shatter!"
