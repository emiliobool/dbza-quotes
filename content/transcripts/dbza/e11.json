   "start": 191.82,
   "end": 192.92,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "AAUAGH--{SQUEAK}"
  },
  {
   "i": 67,
   "start": 193.5,
   "end": 194.12,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "What the..."
  },
  {
   "i": 68,
   "start": 194.38,
   "end": 195.24,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "AUAGH--{SQUEAK}"
  },
  {
   "i": 69,
   "start": 195.6,
   "end": 197.6,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Oh my God, that's hilarious!"
  },
  {
   "i": 70,
   "start": 197.6,
   "end": 199.9,
   "kind": "sfx",
   "speaker": null,
   "text": "Repetitive squeaks"
