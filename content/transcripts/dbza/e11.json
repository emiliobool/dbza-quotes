   "speaker": "Yajirobe",
   "text": "Runningrunningrunningrunningrunning!"
  },
  {
   "i": 95,
   "start": 263.24,
   "end": 264.68,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Uh, ohh..."
  },
  {
   "i": 96,
   "start": 264.9,
   "end": 265.88,
   "kind": "direction",
   "speaker": null,
   "text": "Thud"
  },
  {
   "i": 97,
   "start": 264.9,
   "end": 265.88,
   "kind": "sfx",
   "speaker": null,
   "text": "SQUEAK"
  },
  {
   "i": 98,
   "start": 264.9,
   "end": 265.88,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Ow..."
  },
  {
   "i": 99,
   "start": 266.4,
   "end": 275.6,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "God... ....damn iiiiiiii (voice transitions from growly to normal) iiiit."
  },
  {
   "i": 100,
   "start": 276.34,
   "end": 280.24,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Haaa...."
  },
  {
   "i": 101,
   "start": 280.24,
   "end": 281.38,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "He's back to normal!"
  },
  {
   "i": 102,
   "start": 281.72,
   "end": 283.58,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Gohan, we can do this!"
  },
  {
   "i": 103,
   "start": 283.76,
   "end": 285.72,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "We can beat him! WE HAVE A CHAN--!"
  },
  {
   "i": 104,
   "start": 285.96,
   "end": 286.56,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Aha!"
  },
  {
   "i": 105,
   "start": 288.58,
   "end": 289.08,
   "kind": "sfx",
   "speaker": null,
   "text": "DING"
  },
  {
   "i": 106,
   "start": 289.08,
   "end": 291.88,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Oh, God... (sobbing)"
  },
  {
   "i": 107,
   "start": 292.26,
   "end": 302.24,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "You know, I thought I'd be angrier; what with the utter humiliation and loss of my tail... or maybe I'm just so *unbelievably* enraged that I have come full circle."
  },
  {
   "i": 108,
   "start": 302.76,
   "end": 305.44,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Oh well. Either way, it's time to put an end to this."
  },
  {
   "i": 109,
   "start": 306.9,
   "end": 310.12,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "G...Gohan... is that you?"
  },
  {
   "i": 110,
   "start": 310.62,
   "end": 315.5,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "Hey, Daddy. I'm.... really sorry."
  },
  {
   "i": 111,
   "start": 315.96,
   "end": 319.36,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "It's okay, Gohan. You tried your best."
  },
  {
   "i": 112,
   "start": 320.14,
   "end": 324.32,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "At least... you got home to your mother... and told her to--"
  },
  {
   "i": 113,
   "start": 324.32,
   "end": 330.12,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "Um! Actually, I never went home. I came back to save you."
  },
  {
   "i": 114,
   "start": 331.54,
   "end": 332.04,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Oh..."
  },
  {
   "i": 115,
   "start": 332.8,
   "end": 334.4,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "D...Daddy?"
  },
  {
   "i": 116,
   "start": 334.4,
   "end": 336.4,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Everyone makes mistakes, Gohan."
  },
  {
   "i": 117,
   "start": 337.64,
   "end": 340.48,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "But we have to be strong now, okay?"
  },
  {
   "i": 118,
   "start": 341.06,
   "end": 341.66,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "Daddy..."
  },
  {
   "i": 119,
   "start": 342.24,
   "end": 342.84,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Son!"
  },
  {
   "i": 120,
   "start": 342.84,
   "end": 344.64,
   "kind": "direction",
   "speaker": null,
   "text": "♪♪"
  },
  {
   "i": 121,
   "start": 344.64,
   "end": 345.3,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Ungh!"
  },
  {
   "i": 122,
   "start": 345.3,
   "end": 350.36,
   "kind": "direction",
   "speaker": null,
   "text": "♫ DBZ intermission (pre-commercial) ♫"
  },
  {
   "i": 123,
   "start": 351.62,
   "end": 355.1,
   "kind": "direction",
   "speaker": null,
   "text": "♫ DBZ intermission (post-commercial) ♫"
  },
  {
   "i": 124,
   "start": 356.3,
   "end": 356.8,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Ugh!"
  },
  {
   "i": 125,
   "start": 356.8,
   "end": 357.5,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "No-ho-oh!"
  },
  {
   "i": 126,
   "start": 357.72,
   "end": 359.08,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "What now, Kakarot?"
  },
  {
   "i": 127,
   "start": 359.08,
   "end": 366.4,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "You damaged me! You cut off my tail! You've insulted me beyond belief. But you still havn't taken my pride!"
  },
  {
   "i": 128,
   "start": 366.4,
   "end": 367.52,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "Hah!"
  },
  {
   "i": 129,
   "start": 366.4,
   "end": 367.52,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Oh my pride!"
  },
  {
   "i": 130,
   "start": 367.84,
   "end": 370.24,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "I'll teach you to hurt my Daddy!"
  },
  {
   "i": 131,
   "start": 370.24,
   "end": 373.42,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "What are you going to do, huh?! You barely have any energy left!"
  },
  {
   "i": 132,
   "start": 373.42,
   "end": 374.36,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "Hah!"
  },
  {
   "i": 133,
   "start": 373.42,
   "end": 374.36,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Uwagh!"
  },
  {
   "i": 134,
   "start": 374.36,
   "end": 378.52,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "'D'AAAH! MY EYE! Why is it always the goddamn eye?!'"
  },
  {
   "i": 135,
   "start": 378.92,
   "end": 381.4,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "K...Krillin... come here..."
  },
  {
   "i": 136,
   "start": 381.64,
   "end": 383.48,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "I have something to give you."
  },
  {
   "i": 137,
   "start": 383.64,
   "end": 385.16,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Your last will and testament?"
  },
  {
   "i": 138,
   "start": 385.5,
   "end": 390.12,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "No, it's energy from the entire world. It's our last hope!"
  },
  {
   "i": 139,
   "start": 390.66,
   "end": 392.84,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "...And you're giving it to ME...?"
  },
  {
   "i": 140,
   "start": 392.84,
   "end": 394.64,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "I'm... kind of out of options."
  },
  {
   "i": 141,
   "start": 396.8,
   "end": 399.84,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Holy crap! So THIS is what being important feels like!"
  },
  {
   "i": 142,
   "start": 400.28,
   "end": 401.36,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Hyah!"
  },
  {
   "i": 143,
   "start": 400.28,
   "end": 401.36,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "AAAAAHH!"
  },
  {
   "i": 144,
   "start": 404.0,
   "end": 407.6,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "All right, Kakarot. Say goodbye to your son!"
  },
  {
   "i": 145,
   "start": 408.28,
   "end": 410.28,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "'Wow, such power!'"
  },
  {
   "i": 146,
   "start": 410.68,
   "end": 412.88,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "'From every living being on the planet!'"
  },
  {
   "i": 147,
   "start": 413.36,
   "end": 415.66,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "'I can feel it all surging inside of me.'"
  },
  {
   "i": 148,
   "start": 415.76,
   "end": 417.76,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "'Every man, woman, and child!'"
  },
  {
   "i": 149,
   "start": 418.48,
   "end": 421.74,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "'This... is Planet Earth's very *essence*!'"
  },
  {
   "i": 150,
   "start": 422.74,
   "end": 424.22,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "BOOYAH, MOTHERF**KER!"
  },
  {
   "i": 151,
   "start": 426.56,
   "end": 427.8,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Wh-what the hell is--"
  },
  {
   "i": 152,
   "start": 428.42,
   "end": 430.42,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "ENJOY YOUR STAY IN HELL!"
  },
  {
   "i": 153,
   "start": 430.98,
   "end": 431.58,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "RAH!"
  },
  {
   "i": 154,
   "start": 433.16,
   "end": 435.06,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "*Gyaaaah*! *Goddamn it*!"
  },
  {
   "i": 155,
   "start": 437.24,
   "end": 441.62,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Gohan... listen. You have to bounce it back at Vegeta!"
  },
  {
   "i": 156,
   "start": 441.62,
   "end": 446.14,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "But, are you sure? I don't think energy works like that."
  },
  {
   "i": 157,
   "start": 446.14,
   "end": 450.02,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Don't worry, Gohan. You can do it. You're a *good guy*!"
  },
  {
   "i": 158,
   "start": 450.36,
   "end": 454.34,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "Oh... okay... if you believe in me, then I'll--"
  },
  {
   "i": 159,
   "start": 454.34,
   "end": 455.44,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Or, it'll kill you."
  },
  {
   "i": 160,
   "start": 455.44,
   "end": 455.96,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "WHAT?!"
  },
  {
   "i": 161,
   "start": 455.96,
   "end": 456.56,
   "kind": "sfx",
   "speaker": null,
   "text": "BOING"
  },
  {
   "i": 162,
   "start": 455.96,
   "end": 456.56,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "AAAH...!"
  },
  {
   "i": 163,
   "start": 457.82,
   "end": 461.08,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "There's nothing left now. Your last hope and you missed."
  },
  {
   "i": 164,
   "start": 461.08,
   "end": 464.16,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "You're all defeated and there isn't a damn thing you can--"
  },
  {
   "i": 165,
   "start": 464.16,
   "end": 465.38,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "'What smells like deer?'"
  },
  {
   "i": 166,
   "start": 466.22,
   "end": 467.74,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "WAAAAAAAGH!"
  },
  {
   "i": 167,
   "start": 467.74,
   "end": 469.18,
   "kind": "sfx",
   "speaker": null,
   "text": "KABOOM"
  },
  {
   "i": 168,
   "start": 469.48,
   "end": 471.62,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "CURSE MY HUBRIS!!!"
  },
  {
   "i": 169,
   "start": 476.58,
   "end": 477.8,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "YAHOO!!"
  },
  {
   "i": 170,
   "start": 477.8,
   "end": 482.08,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Goku, we did it! We won! We beat him with the Spirit Bomb!"
  },
  {
   "i": 171,
   "start": 482.08,
   "end": 483.42,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "Way to go, you guys."
  },
  {
   "i": 172,
   "start": 484.26,
   "end": 486.26,
   "kind": "direction",
   "speaker": "Gohan",
   "text": "Laughing"
  },
  {
   "i": 173,
   "start": 488.94,
   "end": 491.94,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "All right, Goku. Let's get you and Gohan home."
  },
  {
   "i": 174,
   "start": 492.46,
   "end": 497.54,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "It's been tough, but now, we'll never have to see that rotten Saiyan ever again."
  },
  {
   "i": 175,
   "start": 497.72,
   "end": 498.78,
   "kind": "sfx",
   "speaker": null,
   "text": "WHAM"
  },
  {
   "i": 176,
   "start": 499.58,
   "end": 503.06,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "*Alive* again. We'll never have to see him alive again, that's what I meant."
  },
  {
   "i": 177,
   "start": 504.16,
   "end": 507.02,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "(Sigh)... but at least it's finally over."
  },
  {
   "i": 178,
   "start": 507.46,
   "end": 508.98,
   "kind": "dialog",
   "speaker": "Yajirobe",
   "text": "You gunna eat that Saiyan?"
  },
  {
   "i": 179,
   "start": 510.04,
   "end": 510.54,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "...Wha--?"
  },
  {
   "i": 180,
   "start": 510.54,
   "end": 511.04,
   "kind": "dialog",
   "speaker": "Yajirobe",
   "text": "Dibs!"
  },
  {
   "i": 181,
   "start": 512.18,
   "end": 516.74,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Rrright... anyway, it seems the Spirit Bomb's done the trick."
  },
  {
   "i": 182,
   "start": 516.74,
   "end": 519.64,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "And with that, we can all go home and live in peace and--"
  },
  {
   "i": 183,
   "start": 519.64,
   "end": 525.66,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "HUAAAAAAAH!!"
  },
  {
   "i": 184,
   "start": 520.8,
   "end": 524.48,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "WAAAAAAHH!!"
  },
  {
   "i": 185,
   "start": 522.08,
   "end": 527.0,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "AAAAAAAAGH!!"
  },
  {
   "i": 186,
   "start": 523.26,
   "end": 528.5,
   "kind": "dialog",
   "speaker": "Yajirobe",
   "text": "AAAAAAAHH!!"
  },
  {
   "i": 187,
   "start": 524.48,
   "end": 529.92,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "UAAAAAHHH!!"
  },
  {
   "i": 188,
   "start": 525.66,
   "end": 529.92,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "WAAAAAHH!!"
  },
  {
   "i": 189,
   "start": 527.0,
   "end": 529.92,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "AAAAAAH!!"
  },
  {
   "i": 190,
   "start": 528.5,
   "end": 529.92,
   "kind": "dialog",
   "speaker": "Yajirobe",
   "text": "UAAAAHHH!!"
  },
  {
   "i": 191,
   "start": 529.92,
   "end": 531.42,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "What's goin' on, guys?"
  },
  {
   "i": 192,
   "start": 532.5,
   "end": 533.44,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "We won, right?"
  }
