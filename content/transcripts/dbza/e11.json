  {
   "i": 71,
   "start": 197.6,
   "end": 199.9,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Hahahaha, muhahahahaha!"
  },
  {
   "i": 72,
   "start": 199.9,
   "end": 203.58,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "Get your filthy hands off of him, you damn dirty ape!"
  },
  {
   "i": 73,
   "start": 203.58,
   "end": 207.56,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Oh, very creative. And what exactly will you do if I don't?"
  },
  {
   "i": 74,
   "start": 207.56,
   "end": 209.28,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "I'll make you regret it!"
  },
  {
   "i": 75,
   "start": 209.28,
   "end": 219.3,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "Law of mass dictates that the mass of an object dramatically increases the force of impact when said object collides with the ground; and, with your size, you'll make an extensively large impact upon your inevitable defeat!"
  },
  {
   "i": 76,
   "start": 220.78,
   "end": 221.48,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "...What?"
  },
  {
   "i": 77,
   "start": 220.78,
   "end": 221.48,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "...What?"
  },
  {
   "i": 78,
   "start": 221.84,
   "end": 225.1,
   "kind": "dialog",
   "speaker": "Gohan",
   "text": "The bigger they are, the harder they *fall*!"
  },
  {
   "i": 79,
   "start": 228.68,
   "end": 229.18,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "...What?"
  },
  {
   "i": 80,
   "start": 229.18,
   "end": 229.68,
   "kind": "sfx",
   "speaker": null,
   "text": "SQUEAK"
  },
  {
   "i": 81,
   "start": 229.68,
   "end": 232.5,
   "kind": "dialog",
   "speaker": "Goku",
   "text": "ARGH! Stop that!"
  },
  {
   "i": 82,
   "start": 232.5,
   "end": 238.5,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Listen, kid, you're real brave and all, but your dad's beaten and broken, and neither of you have the skill or energy--"
  },
  {
   "i": 83,
   "start": 238.5,
   "end": 239.48,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Kienzan!"
  },
  {
   "i": 84,
   "start": 239.9,
   "end": 240.54,
   "kind": "direction",
   "speaker": null,
   "text": "Thud"
  },
  {
   "i": 85,
   "start": 240.9,
   "end": 242.02,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "...to take me on."
  },
  {
   "i": 86,
   "start": 242.52,
   "end": 243.82,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "Da-a-amnit!"
  },
  {
   "i": 87,
   "start": 243.88,
   "end": 247.1,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "You're finished! All of your planet's greatest fighters!"
  },
  {
   "i": 88,
   "start": 247.1,
   "end": 251.14,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "ALL of them *worthless* in the presence of a Saiyan elite!"
  },
  {
   "i": 89,
   "start": 251.14,
   "end": 253.76,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "None of you can stop me! NONE OF YOU--!"
  },
  {
   "i": 90,
   "start": 253.76,
   "end": 255.08,
   "kind": "direction",
   "speaker": null,
   "text": "Slash"
  },
  {
   "i": 91,
   "start": 253.76,
   "end": 255.08,
   "kind": "dialog",
   "speaker": "Vegeta",
   "text": "Uhhh-uh..?"
  },
  {
   "i": 92,
   "start": 255.08,
   "end": 258.34,
   "kind": "direction",
   "speaker": null,
   "text": "Dramatic drum beat"
  },
  {
   "i": 93,
   "start": 258.86,
   "end": 260.28,
   "kind": "direction",
   "speaker": null,
   "text": "Thud"
  },
  {
   "i": 94,
   "start": 261.16,
   "end": 262.94,
