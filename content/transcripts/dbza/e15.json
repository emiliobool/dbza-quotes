   "i": 97,
   "start": 232.42,
   "end": 236.54,
   "kind": "dialog",
   "speaker": "Krillin",
   "text": "We may be outmatched, but we didn’t come this far just to give up!"
  },
  {
   "i": 98,
   "start": 236.82,
   "end": 238.82,
   "kind": "dialog",
   "speaker": "Bulma",
   "text": "What the heck happened in that cave?"
